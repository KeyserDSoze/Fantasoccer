# Synthetic local-only defaults. This file is intentionally versioned.
# Copy to .env for private settings; never put real secrets in .env.test.
FRONTEND_PORT=3000
API_PORT=5080
DASHBOARD_PORT=18888
POSTGRES_PORT=25432
BLOB_PORT=21000
QUEUE_PORT=21001
TABLE_PORT=21002
POSTGRES_PASSWORD=local-postgres-test-only
AZURITE_KEY=bG9jYWwtdGVzdC1vbmx5
DASHBOARD_TOKEN=local-dashboard-test-token-change-in-env
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ENCRYPTION_IV=AAAAAAAAAAAAAAAAAAAAAA==

# Public identifiers/URLs only; these values are embedded in the frontend bundle.
MICROSOFT_CLIENT_ID=95de3061-5eab-437d-a2cc-6d71cfaef4d1
GLOBAL_ADMIN_EMAIL=alessandro.rapiti44@gmail.com
PUBLIC_API_URL=http://localhost:5080
PUBLIC_BLOB_URL=http://localhost:21000/migrationrestore
FRONTEND_ORIGIN=http://localhost:3000

# Private settings belong in .env. Compose forwards each secret only to its consumer.
MICROSOFT_CLIENT_SECRET=
FANTASOCCER_EXPORT_STORAGE=

# Keep writers OFF when working with a copy of real data.
BACKGROUND_JOBS_ENABLED=false
EXTERNAL_HTTP_ENABLED=false
PUSH_ENABLED=false
# Generate the local certificate and use up-https before enabling MCP.
MCP_ENABLED=false
LEGACY_ENCRYPTION_KEY=
LEGACY_ENCRYPTION_IV=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
AI_ENABLED=false
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
HTTPS_PORT=5443
# Only local test defaults; local.ps1/local.sh init generates a private password.
LOCAL_HTTPS_CERT_PASSWORD=local-https-test-only

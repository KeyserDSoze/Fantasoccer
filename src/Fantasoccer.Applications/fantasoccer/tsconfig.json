{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",

    "paths": {
      "components/*": ["./components/*"],
      "config/*": ["./config/*"],
      "configurations/*": ["./configurations/*"],
      "features/*": ["./features/*"],
      "hooks": ["./hooks/index"],
      "hooks/*": ["./hooks/*"],
      "navigation": ["./navigation"],
      "navigation/*": ["./navigation/*"],
      "providers/*": ["./providers/*"],
      "screens/*": ["./screens/*"],
      "services/*": ["./services/*"],
      "store/*": ["./store/*"],
      "types/*": ["./types/*"],
      "utils": ["./utils/index"],
      "utils/*": ["./utils/*"],
      "~/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios"]
}

{
  "expo": {
    "name": "FantaZone",
    "slug": "fantazone",
    "owner": "Alessandro Rapiti",
    "version": "2.0.51",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/android-chrome-512x512.png",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "/favicon-32x32.png",
      "manifest": {
        "id": "/",
        "name": "FantaZone",
        "short_name": "FantaZone",
        "start_url": "/",
        "scope": "/",
        "display": "standalone",
        "background_color": "#4B61D1",
        "theme_color": "#4B61D1",
        "icons": [
          {
            "src": "/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/icon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
          },
          {
            "src": "/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/favicon-32x32.png",
            "sizes": "32x32",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/favicon-16x16.png",
            "sizes": "16x16",
            "type": "image/png",
            "purpose": "any"
          }
        ]
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0b153a"
        }
      ],
      "expo-status-bar"
    ],
    "orientation": "portrait",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b153a"
      },
      "package": "com.keyserdsoze.fantasoccer"
    },
    "extra": {
      "eas": {
        "projectId": "8f9e9822-b1b3-4aab-b236-5237394802c4"
      }
    }
  }
}

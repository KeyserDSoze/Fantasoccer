{
  "expo": {
    "name": "FantaZone",
    "slug": "fantazone",
    "owner": "Alessandro Rapiti",
    "version": "1.0.1",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/web-app-manifest-512x512.png",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/web-app-manifest-512x512.png",
      "styles": {
        "body": {
          "overflow": "auto"
        }
      },
      "manifest": {
        "name": "FantaZone",
        "shortName": "FantaZone",
        "backgroundColor": "#0b153a",
        "themeColor": "#0b153a",
        "icons": [
          {
            "src": "./assets/web-app-manifest-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "./assets/web-app-manifest-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "./assets/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "./assets/favicon-96x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
          }
        ]
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-dev-menu",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-font"
    ],
    "orientation": "portrait",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0b153a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.keyserdsoze.fantasoccer"
    },
    "extra": {
      "eas": {
        "projectId": "8f9e9822-b1b3-4aab-b236-5237394802c4"
      }
    }
  }
}

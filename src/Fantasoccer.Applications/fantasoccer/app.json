{
  "expo": {
    "name": "FantaZone",
    "slug": "fantazone",
    "owner": "Alessandro Rapiti",
    "version": "1.0.1",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/android-chrome-512x512.png",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/favicon-32x32.png",
      "manifest": {
        "id": "/",
        "name": "FantaZone",
        "short_name": "FantaZone",
        "start_url": "/",
        "scope": "/",
        "display": "standalone",
        "background_color": "#0b153a",
        "theme_color": "#0b153a",
        "icons": [
          {
            "src": "./assets/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "./assets/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "./assets/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "./assets/favicon-32x32.png",
            "sizes": "32x32",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "./assets/favicon-16x16.png",
            "sizes": "16x16",
            "type": "image/png",
            "purpose": "any"
          }
        ]
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-dev-menu",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-font"
    ],
    "orientation": "portrait",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0b153a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.keyserdsoze.fantasoccer"
    },
    "extra": {
      "eas": {
        "projectId": "8f9e9822-b1b3-4aab-b236-5237394802c4"
      }
    }
  }
}

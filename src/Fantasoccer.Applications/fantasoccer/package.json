{
  "name": "fantasoccer",
  "version": "2.0.30",
  "scripts": {
    "start": "expo start --dev-client --port 3000",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "prebuild": "expo prebuild",
    "test:group-admin": "node --experimental-transform-types --test tests/groupAdmin.test.mjs",
    "test:market": "node --experimental-transform-types --test tests/marketRules.test.mjs",
    "test": "npm run test:group-admin && npm run test:market",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@azure/msal-browser": "4.30.0",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@microsoft/signalr": "10.0.11",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@react-navigation/stack": "^7.10.24",
    "@tamagui/config": "2.7.7",
    "@tamagui/font-inter": "2.7.7",
    "@tamagui/lucide-icons-2": "2.7.7",
    "@tamagui/react-native-media-driver": "2.7.7",
    "@tamagui/toast": "2.7.7",
    "burnt": "^0.13.0",
    "expo": "~57.0.18",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "rystem.repository.client": "0.2.7",
    "tamagui": "2.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tamagui/babel-plugin": "2.7.7",
    "@tamagui/cli": "2.7.7",
    "@types/react": "~19.2.10",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "main": "node_modules/expo/AppEntry.js",
  "private": true
}

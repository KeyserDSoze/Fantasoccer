{
  "name": "fantasoccer",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client --port 3000",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "prebuild": "expo prebuild",
    "test:group-admin": "node --experimental-transform-types --test tests/groupAdmin.test.mjs",
    "test:market": "node --experimental-transform-types --test tests/marketRules.test.mjs",
    "test": "npm run test:group-admin && npm run test:market",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@azure/msal-browser": "4.24.0",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@microsoft/signalr": "^9.0.19",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@react-navigation/stack": "^7.10.24",
    "@tamagui/animations-react-native": "^1.144.4",
    "@tamagui/font-inter": "^1.144.4",
    "@tamagui/lucide-icons": "^1.144.4",
    "@tamagui/react-native-media-driver": "^1.144.4",
    "@tamagui/shorthands": "^1.144.4",
    "@tamagui/themes": "^1.144.4",
    "@tamagui/toast": "^1.144.4",
    "burnt": "^0.13.0",
    "expo": "~54.0.37",
    "expo-dev-client": "~6.0.21",
    "expo-dev-launcher": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "rystem.repository.client": "0.2.7",
    "tamagui": "^1.144.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tamagui/babel-plugin": "^1.144.4",
    "@types/react": "19.1.13",
    "eslint": "9.36.0",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.6",
    "typescript": "5.9.2"
  },
  "main": "node_modules/expo/AppEntry.js",
  "private": true
}

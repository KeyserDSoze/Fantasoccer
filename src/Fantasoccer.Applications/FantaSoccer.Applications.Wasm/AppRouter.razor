@using Blazored.LocalStorage;
@using Blazorise;
@using Fantasoccer.Applications.Wasm.Extensions;
@using Fantasoccer.Applications.Wasm.Shared;

<Blazorise.ThemeProvider Theme="@theme">
    <CascadingValue Value="@state">
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
</Blazorise.ThemeProvider>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    [Inject]
    private NavigationManager? NavigationManager { get; set; }
    private FantasoccerState? state;
    private Theme theme = new Theme
        {
            ColorOptions = new ThemeColorOptions
            {
                Primary = "#8b2c62",
                Secondary = "#db3258",
                Light = "#e8fcdc",
                Dark = "#2d2c39",
                Info = "#01854d",
                Success = "#019e6b",
                Warning = "#d3ce01",
                Danger = "#df3d00",
                Link = "#ffffff"
            }
        };

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;
            var id = Guid.NewGuid().ToString();
            if (user?.Identity is not null && user.Identity.IsAuthenticated)
            {
                var email = user.Claims.First(x => x.Type == "emails").Value;
                try
                {
                    var identity = await Api.AppIdentity.GetAsync(email);
                    if (identity == null)
                    {
                        identity = new AppIdentity
                            {
                                Email = email,
                                Groups = new(),
                                Username = email
                            };
                        await Api.AppIdentity.InsertAsync(email, identity);
                        NavigationManager?.NavigateTo("../../settings", false);
                    }
                    state = new FantasoccerState()
                        {
                            AppUiUpdate = () =>
                            {
                                StateHasChanged();
                            },
                            GetGroup = (groupId) =>
                            {
                                try
                                {
                                    return Api.Groups.GetAsync(groupId);
                                }
                                catch (Exception ex)
                                {
                                    return Task.FromResult(default(Group));
                                }
                            },
                            UpdateState = (identity) =>
                            {
                                try
                                {
                                    return Api.AppIdentity.UpdateAsync(identity!.Email, identity);
                                }
                                catch (Exception ex)
                                {
                                    return Task.CompletedTask;
                                }
                            }
                        };
                    await state.SetIdentityAsync(identity);
                }
                catch (Exception ex)
                {
                    NavigationManager?.NavigateTo("../../authentication/login");
                }
            }
            else
            {
                NavigationManager?.NavigateTo("../../authentication/login");
            }
        }
        await base.OnInitializedAsync();
    }
}

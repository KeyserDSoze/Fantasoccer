@using Blazorise.LoadingIndicator;
@if (State?.Identity?.Groups?.Any() == true)
{
    <Row>
        <Column>
            <Fields>
                <Validations @ref="@ValidationsRef" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <Select TValue="string" SelectedValue="@State.GroupId" SelectedValueChanged="@OnSelectedGroupChanged" Width="Width.Is50">
                            @foreach (var group in State.Identity.Groups)
                            {
                                <SelectItem Value="@group.Id">@group.Name</SelectItem>
                            }
                        </Select>
                    </Field>
                    @if (CanCreateNewGroup)
                    {
                        <Validation UsePattern>
                         <Field ColumnSize="ColumnSize.IsHalf">
                             <FieldLabel>Nome gruppo</FieldLabel>
                             <FieldBody>
                                 <TextEdit @bind-Text="@newGroupName" Pattern="[A-Za-z0-9. _-]{3,20}">
                                     <Feedback>
                                         <ValidationError />
                                     </Feedback>
                                 </TextEdit>
                                 <Button Color="Color.Primary" Clicked="@CreateNewGroup" Margin="Margin.Is1.FromTop">
                                     Crea un nuovo gruppo
                                 </Button>
                             </FieldBody>
                         </Field>
                     </Validation>
                    }
                </Validations>
            </Fields>
        </Column>
    </Row>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public bool CanCreateNewGroup { get; set; }
    private Validations? ValidationsRef { get; set; }
    private string? newGroupName { get; set; }
    async Task CreateNewGroup()
    {
        LoadingIndicator?.Show();
        if (ValidationsRef != null)
            if (await ValidationsRef.ValidateAll())
            {
                if (State?.IsAuthenticated == true && newGroupName != null)
                {
                    var groupId = Guid.NewGuid().ToString();
                    var group = new Group
                        {
                            Id = groupId,
                            Leagues = new(),
                            Name = newGroupName,
                            Baskets = new(),
                            Users = new List<UserOfAGroup> { new UserOfAGroup { Email = State.Identity!.Email, Username = State.Identity.Username, Role = IdentityRole.Admin } }
                        };
                    await Api.Groups.InsertAsync(groupId, group);
                    State.Identity.Groups.Add(group.ToGroupIdentity(State.Identity.Email));
                    await Api.AppIdentity.UpdateAsync(State.Identity.Email, State.Identity);
                    await State.ChangeGroupAsync(groupId);
                }
                await ValidationsRef.ClearAll();
            }
        LoadingIndicator?.Hide();
    }
    private async Task OnSelectedGroupChanged(string groupId)
    {
        LoadingIndicator?.Show();
        if (State != null)
        {
            await State.ChangeGroupAsync(groupId);
        }
        LoadingIndicator?.Hide();
    }
}

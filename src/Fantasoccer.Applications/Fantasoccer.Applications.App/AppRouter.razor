@using Blazored.LocalStorage;
@using Blazorise;
@using Microsoft.Identity.Abstractions;
@using Microsoft.Identity.Web;
<Blazorise.ThemeProvider Theme="@theme">
    <CascadingValue Value="@identity">
        <CascadingValue Value="@state">
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Not found</PageTitle>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <p role="alert">Sorry, there's nothing at this address.</p>
                    </LayoutView>
                </NotFound>
            </Router>
        </CascadingValue>
    </CascadingValue>
</Blazorise.ThemeProvider>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    [Inject]
    private ILocalStorageService? localStorage { get; set; }
    [Inject]
    private NavigationManager NavigationManager { get; set; }
    [Inject]
    private MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler { get; set; }
    [Inject]
    private IAuthorizationHeaderProvider AuthorizationHeaderProvider { get; set; }
    [Inject]
    private IConfiguration Configuration { get; set; }
    private AppIdentity? identity;
    private FantasoccerState? state;
    private Theme theme = new Theme
        {
            ColorOptions = new ThemeColorOptions
            {
                Primary = "#8b2c62",
                Secondary = "#db3258",
                Light = "#e8fcdc",
                Dark = "#2d2c39",
                Info = "#01854d",
                Success = "#019e6b",
                Warning = "#d3ce01",
                Danger = "#df3d00",
                Link = "#ffffff"
            }
        };
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var fantasoccerState = (localStorage != null && await localStorage.ContainKeyAsync(nameof(FantasoccerState))) ?
                await localStorage.GetItemAsync<FantasoccerState>(nameof(FantasoccerState))
                : new FantasoccerState();
            if (identity != null && identity.Email != fantasoccerState.Email)
            {
                fantasoccerState = new() { Email = identity.Email, Username = identity.Username, GroupId = identity.Groups.FirstOrDefault()?.Id, LeagueId = identity.Groups.FirstOrDefault()?.Leagues.FirstOrDefault()?.Id };
            }
            else if (identity == null)
            {
                fantasoccerState = new();
            }
            state = fantasoccerState;
            state.Update = async () =>
            {
                if (fantasoccerState.GroupId != null)
                {
                    state.Group = await Api.Groups.GetAsync(fantasoccerState.GroupId);
                    if (state.Group != null && fantasoccerState.LeagueId != null)
                    {
                        state.League = state.Group.Leagues.FirstOrDefault(x => x.Id == fantasoccerState.LeagueId);
                        if (state.League != null && fantasoccerState.Year > 0)
                        {
                            state.AnnualLeague = state.League.Years.FirstOrDefault(x => x.Year == fantasoccerState.Year);
                        }
                    }
                }
                StateHasChanged();
                if (localStorage != null)
                    await localStorage.SetItemAsync(nameof(FantasoccerState), state);
            };
            _ = state.Update();
        }
        await base.OnAfterRenderAsync(firstRender);
    }
    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user?.Identity is not null && user.Identity.IsAuthenticated)
            {
                var email = user.Claims.First(x => x.Type == "emails").Value;
                try
                {
                    identity = await Api.AppIdentity.GetAsync(email);
                }
                catch
                {
                    NavigationManager.NavigateTo("../../MicrosoftIdentity/Account/SignOut");
                }
                if (identity == null)
                {
                    identity = new AppIdentity
                        {
                            Email = email,
                            Groups = new(),
                            Username = email
                        };
                    await Api.AppIdentity.InsertAsync(email, identity);
                    NavigationManager.NavigateTo("../../settings", false);
                }
            }
        }
        await base.OnInitializedAsync();
    }
}

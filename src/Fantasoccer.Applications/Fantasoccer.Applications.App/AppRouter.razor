    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();
        state = new FantasoccerState()
            {
                AppUiUpdate = () =>
                {
                    StateHasChanged();
                },
                GetGroup = (groupId) =>
                {
                    try
                    {
                        return Api.Groups.GetAsync(groupId);
                    }
                    catch (Exception ex)
                    {
                        return Task.FromResult(default(Group));
                    }
                },
                UpdateState = (identity) =>
                {
                    try
                    {
                        return Api.AppIdentity.UpdateAsync(identity!.Email, identity);
                    }
                    catch (Exception ex)
                    {
                        return Task.CompletedTask;
                    }
                }
            };
        var user = (await authenticationState).User;
        if (!(user?.Identity?.IsAuthenticated == true))
        {
            NavigationManager?.NavigateTo($"../../MicrosoftIdentity/Account/SignIn?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", false);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var user = (await authenticationState).User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            var email = user.Claims.First(x => x.Type == "emails").Value.Trim(']').Trim('[').Trim('"');
            if (email != null)
            {
                try
                {
                    var identity = await Api.AppIdentity.GetAsync(email);
                    var isBrandNew = identity == null;
                    if (isBrandNew)
                    {
                        identity = new AppIdentity
                            {
                                Email = email,
                                Groups = new(),
                                Username = email
                            };
                        await Api.AppIdentity.InsertAsync(email, identity);
                    }
                    if (state != null)
                        await state.SetIdentityAsync(identity);
                    if (isBrandNew)
                        NavigationManager?.NavigateTo("../../settings", false);
                }
                catch (UnauthorizedAccessException)
                {
                    NavigationManager?.NavigateTo($"../../MicrosoftIdentity/Account/SignIn?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", false);
                }
            }
        }
    }

@using Blazored.LocalStorage;
@using Blazorise;
@using Fantasoccer.Applications.App.Extensions;
@using Microsoft.Identity.Abstractions;
@using Microsoft.Identity.Web;

<Blazorise.ThemeProvider Theme="@theme">
    <CascadingValue Value="@state">
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
</Blazorise.ThemeProvider>

@code {
    [Inject]
    public required IdentityService IdentityService { get; set; }
    private FantasoccerState? state;
    private Theme theme = new Theme
        {
            ColorOptions = new ThemeColorOptions
            {
                Primary = "#8b2c62",
                Secondary = "#db3258",
                Light = "#e8fcdc",
                Dark = "#2d2c39",
                Info = "#01854d",
                Success = "#019e6b",
                Warning = "#d3ce01",
                Danger = "#df3d00",
                Link = "#ffffff"
            }
        };
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            var identity = await IdentityService.GetIdentityAsync();
            if (identity != null)
            {
                state = new FantasoccerState()
                    {
                        AppUiUpdate = () =>
                        {
                            StateHasChanged();
                        },
                        GetGroup = (groupId) =>
                        {
                            try
                            {
                                return Api.Groups.GetAsync(groupId);
                            }
                            catch (Exception ex)
                            {
                                return Task.FromResult(default(Group));
                            }
                        },
                        UpdateState = (identity) =>
                        {
                            try
                            {
                                return Api.AppIdentity.UpdateAsync(identity!.Email, identity);
                            }
                            catch (Exception ex)
                            {
                                return Task.CompletedTask;
                            }
                        }
                    };
                await state.SetIdentityAsync(identity);
            }
        }
    }
}

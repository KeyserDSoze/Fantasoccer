@page "/cola"
@using Fantasoccer.Applications.App.Extensions;
<h3>Cola</h3>
@foreach (var log in SuperFastLog.Logs.OrderByDescending(x => x.Timestamp).GroupBy(x => x.CorrelationId))
{
    foreach (var logg in log)
    {
        <Div Style="position:relative;float:left;width:100%">@logg.Message (@logg.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"))</Div>
    }
    <Divider DividerType="DividerType.Dashed" />
}

@page "/groups"
@using Blazorise.LoadingIndicator;
@using Blazorise.Components;

<PageTitle>Groups</PageTitle>


@if (Identity != null && State != null)
{
    @if (Identity.Groups?.Any() == true)
    {
        <Select TValue="string" SelectedValue="@State.GroupId" SelectedValueChanged="@OnSelectedGroupChanged" Width="Width.Is50">
            @foreach (var group in Identity.Groups)
            {
                <SelectItem Value="@group.Id">@group.Name</SelectItem>
            }
        </Select>
    }
    @if (canCreateNewGroup)
    {
        <Row>
            <Column>
                <Fields>
                    <Validations @ref="@ValidationsRef" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                        <Validation UsePattern>
                         <Field ColumnSize="ColumnSize.IsHalf">
                             <FieldLabel>Nome gruppo</FieldLabel>
                             <FieldBody>
                                 <TextEdit @bind-Text="@newGroupName" Pattern="[A-Za-z0-9. _-]{3,20}">
                                     <Feedback>
                                         <ValidationError />
                                     </Feedback>
                                 </TextEdit>
                             </FieldBody>
                         </Field>
                     </Validation>
                 </Validations>
             </Fields>
             <Button Color="Color.Primary" Clicked="@CreateNewGroup">
                 Crea un nuovo gruppo
             </Button>
         </Column>
     </Row>
    }
    @if (group != null && group.AdminUsers.Any(x => x.Email == Identity.Email))
    {
        <Row>
            <Column>
                <Fields>
                    <Validations @ref="@ValidationsRefForIdentity" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                        <Validation UsePattern>
                         <Field ColumnSize="ColumnSize.IsHalf">
                             <FieldLabel>Email da aggiungere</FieldLabel>
                             <FieldBody>
                                 <TextEdit @bind-Text="@newEmail" Pattern="@EmailPattern">
                                     <Feedback>
                                         <ValidationError />
                                     </Feedback>
                                 </TextEdit>
                             </FieldBody>
                         </Field>
                     </Validation>
                 </Validations>
             </Fields>
             <Button Color="Color.Primary" Clicked="@AddNewUser">
                 Aggiungi user
             </Button>
         </Column>
     </Row>
        @if (group.Leagues?.Any() == true)
        {
            <Select TValue="string" SelectedValue="@State.LeagueId" SelectedValueChanged="@OnSelectedLeagueChanged" Width="Width.Is50">
                @foreach (var league in group.Leagues)
                {
                    <SelectItem Value="@league.Id">@league.Name</SelectItem>
                }
            </Select>
        }

        @if (canCreateNewGroup)
        {
            <Row>
                <Column>
                    <Fields>
                        <Validations @ref="@ValidationsRefForLeague" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                            <Validation UsePattern>
                             <Field ColumnSize="ColumnSize.IsHalf">
                                 <FieldLabel>Nome lega</FieldLabel>
                                 <FieldBody>
                                     <TextEdit @bind-Text="@newLeagueName" Pattern="[A-Za-z0-9. _-]{3,20}">
                                         <Feedback>
                                             <ValidationError />
                                         </Feedback>
                                     </TextEdit>
                                 </FieldBody>
                             </Field>
                         </Validation>
                     </Validations>
                 </Fields>
                 <Button Color="Color.Primary" Clicked="@CreateNewLeague">
                     Crea nuova lega
                 </Button>
             </Column>
         </Row>
        }

        <Table Striped>
         <TableHeader>
             <TableRow>
                 <TableHeaderCell>Email</TableHeaderCell>
                 <TableHeaderCell>Username</TableHeaderCell>
                 <TableHeaderCell>Admin</TableHeaderCell>
                 <TableHeaderCell>Participant</TableHeaderCell>
                 <TableHeaderCell>Reader</TableHeaderCell>
                 @foreach (var league in group.Leagues)
                    {
                        <TableHeaderCell>@league.Name</TableHeaderCell>
                    }
                    <TableHeaderCell>X</TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var user in group.Users)
                {
                    <TableRow>
                        <TableRowHeader>@user.Email</TableRowHeader>
                        <TableRowHeader>@user.Username</TableRowHeader>
                        <TableRowCell>
                            <Check TValue="bool" Checked="@(user.Role.HasFlag(IdentityRole.Admin))"
                                   CheckedChanged="@((x) => _ = ChangeRole(user, x, IdentityRole.Admin))"></Check>
                        </TableRowCell>
                        <TableRowCell>
                            <Check TValue="bool" Checked="@(user.Role.HasFlag(IdentityRole.Participant))"
                                   CheckedChanged="@((x) => _ = ChangeRole(user, x, IdentityRole.Participant))"></Check>
                        </TableRowCell>
                        <TableRowCell>
                            <Check TValue="bool" Checked="@(user.Role.HasFlag(IdentityRole.Reader))"
                                   CheckedChanged="@((x) => _ = ChangeRole(user, x, IdentityRole.Reader))"></Check>
                        </TableRowCell>
                        @foreach (var league in group.Leagues)
                        {
                            <TableRowCell>
                                <Check TValue="bool" Checked="@(league.Years.OrderByDescending(x => x.Year).First().Teams.Any(x => x.Owner == user.Email))"
                                       CheckedChanged="@((x) => _ = SetParticipantAsync(user, league, x))"></Check>
                            </TableRowCell>
                        }
                        <TableRowCell>
                            <Button Color="Color.Primary" Clicked="@((x) => _ = DeleteAsync(user))">
                                Cancella
                            </Button>
                        </TableRowCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
        @if (league != null)
        {
            <Check TValue="bool" Checked="@(league.IsMain)"
                   CheckedChanged="@((x) => league.IsMain = x)">Is Main</Check>
            <Row>
                <Column>
                    <Fields>
                        <Field ColumnSize="ColumnSize.IsHalf">
                            <FieldLabel>Nome lega</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="league.Name">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Fields>
                    <Fields>
                        <Field ColumnSize="ColumnSize.IsHalf">
                            <FieldLabel>Tipo di lega</FieldLabel>
                            <FieldBody>
                                <Select TValue="LeagueType" @bind-SelectedValue="league.Type">
                                    <SelectItem Value="LeagueType.League">Lega</SelectItem>
                                    <SelectItem Value="LeagueType.Cup">Coppa</SelectItem>
                                </Select>
                            </FieldBody>
                        </Field>
                    </Fields>
                    <Button Color="Color.Primary" Clicked="@SaveAsync">
                        Salva
                    </Button>
                    <Button Color="Color.Primary" Clicked="@CreateCalendarAsync">
                        Create new calendar
                    </Button>
                </Column>
            </Row>
        }
    }
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private AppIdentity? Identity { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private GroupForIdentity? actualGroup;
    private LeagueForIdentity? actualLeague;
    private Validations? ValidationsRef { get; set; }
    private string? newGroupName { get; set; }
    private Validations? ValidationsRefForLeague { get; set; }
    private string? newLeagueName { get; set; }
    private Validations? ValidationsRefForIdentity { get; set; }
    private string? newEmail { get; set; }
    private bool canCreateNewGroup;
    private Group? group;
    private League? league;
    private const string EmailPattern = @"^[\w-\.]+@([\w-]+\.)+[\w-]{2,6}$";
    protected override async Task OnParametersSetAsync()
    {
        if (State != null && Identity != null)
        {
            LoadingIndicator?.Show();
            canCreateNewGroup = Identity.Email == "alessandro.rapiti44@gmail.com";
            actualGroup = State.GroupId != null ?
                Identity.Groups.FirstOrDefault(x => x.Id == State.GroupId)
                : Identity.Groups.FirstOrDefault();
            if (actualGroup != null)
            {
                var updateIsNotNeeded = State.GroupId == actualGroup.Id;
                State.GroupId = actualGroup.Id;
                group = await Api.Groups.GetAsync(State.GroupId);
                if (group != null)
                {
                    league = State.LeagueId != null ?
                        group.Leagues.FirstOrDefault(x => x.Id == State.LeagueId)
                        : group.Leagues.FirstOrDefault();
                    updateIsNotNeeded &= State.LeagueId == league?.Id;
                    State.LeagueId = league?.Id;
                    if (State?.Update != null && !updateIsNotNeeded)
                        await State.Update();
                }
            }
            LoadingIndicator?.Hide();
        }
        await base.OnParametersSetAsync();
    }
    private async Task SaveAsync()
    {
        LoadingIndicator?.Show();
        if (group != null)
        {
            await Api.Groups.UpdateAsync(group.Id, group);
            foreach (var user in group.Users)
            {
                var toUpdateUser = await Api.AppIdentity.GetAsync(user.Email);
                if (toUpdateUser != null)
                {
                    var groupToRemove = toUpdateUser.Groups.FirstOrDefault(x => x.Id == group.Id);
                    if (groupToRemove != null)
                        toUpdateUser.Groups.Remove(groupToRemove);
                    toUpdateUser.Groups.Add(group.ToGroupIdentity(toUpdateUser.Email));
                    await Api.AppIdentity.UpdateAsync(toUpdateUser.Email, toUpdateUser);
                }
            }
            if (State?.Update != null)
                await State.Update();
        }
        LoadingIndicator?.Hide();
    }
    async Task OnSelectedGroupChanged(string groupId)
    {
        LoadingIndicator?.Show();
        if (Identity != null)
        {
            actualGroup = Identity.Groups.FirstOrDefault(x => x.Id == groupId);
            if (actualGroup != null && State != null)
            {
                State.GroupId = actualGroup.Id;
                group = await Api.Groups.GetAsync(State.GroupId);
                if (State?.Update != null)
                    await State.Update();
            }
        }
        LoadingIndicator?.Hide();
    }
    Task OnSelectedLeagueChanged(string leagueId)
    {
        LoadingIndicator?.Show();
        if (Identity != null && group != null && State != null)
        {
            State.LeagueId = leagueId;
            league = group.Leagues.FirstOrDefault(x => x.Id == leagueId);
        }
        LoadingIndicator?.Hide();
        return Task.CompletedTask;
    }
    private async ValueTask ChangeRole(UserOfAGroup user, bool check, IdentityRole role)
    {
        LoadingIndicator?.Show();
        if (check)
            user.Role |= role;
        else
            user.Role &= ~role;
        await Api.Groups.UpdateAsync(group.Id, group);
        var toUpdateUser = await Api.AppIdentity.GetAsync(user.Email);
        if (toUpdateUser != null)
        {
            var groupToRemove = toUpdateUser.Groups.FirstOrDefault(x => x.Id == group.Id);
            if (groupToRemove != null)
                toUpdateUser.Groups.Remove(groupToRemove);
            toUpdateUser.Groups.Add(group.ToGroupIdentity(toUpdateUser.Email));
            await Api.AppIdentity.UpdateAsync(toUpdateUser.Email, toUpdateUser);
        }
        LoadingIndicator?.Hide();
    }
    private async ValueTask DeleteAsync(UserOfAGroup user)
    {
        LoadingIndicator?.Show();
        if (group != null)
            group.Users.Remove(user);
        await SaveAsync();
        LoadingIndicator?.Hide();
    }
    private async ValueTask SetParticipantAsync(UserOfAGroup user, League league, bool x)
    {
        LoadingIndicator?.Show();
        var teams = league.Years.OrderByDescending(x => x.Year).First().Teams;
        var team = teams.FirstOrDefault(x => x.Owner == user.Email);
        if (x)
        {
            if (team == null)
            {
                teams.Add(new AnnualTeam { Owner = user.Email, Name = $"{user.Username} Team" });
            }
        }
        else
        {
            if (team != null)
            {
                teams.Remove(team);
            }
        }
        await SaveAsync();
        LoadingIndicator?.Hide();
    }
    async Task CreateNewGroup()
    {
        LoadingIndicator?.Show();
        if (ValidationsRef != null)
            if (await ValidationsRef.ValidateAll())
            {
                if (Identity != null && newGroupName != null && State != null)
                {
                    State.GroupId = Guid.NewGuid().ToString();
                    group = new Group
                        {
                            Id = State.GroupId,
                            Leagues = new(),
                            Name = newGroupName,
                            Users = new List<UserOfAGroup> { new UserOfAGroup { Email = State.Email, Username = State.Username, Role = IdentityRole.Admin } }
                        };
                    await Api.Groups.InsertAsync(State.GroupId, group);
                    Identity.Groups.Add(new GroupForIdentity
                        {
                            Id = State.GroupId,
                            Name = group.Name,
                            Leagues = new(),
                            Role = IdentityRole.Admin,
                            TeamName = string.Empty
                        });
                    await Api.AppIdentity.UpdateAsync(Identity.Email, Identity);
                    if (State.Update != null)
                        await State.Update();
                }
                await ValidationsRef.ClearAll();
            }
        LoadingIndicator?.Hide();
    }
    async Task CreateNewLeague()
    {
        LoadingIndicator?.Show();
        if (ValidationsRefForLeague != null)
            if (await ValidationsRefForLeague.ValidateAll())
            {
                if (Identity != null && newLeagueName != null && State != null && group != null)
                {
                    State.LeagueId = Guid.NewGuid().ToString();
                    league = new League
                        {
                            Id = State.LeagueId,
                            IsMain = true,
                            Type = LeagueType.League,
                            Years = new List<AnnualLeague> { new AnnualLeague { Id = Guid.NewGuid().ToString(), Settings = LeagueSetting.Default, Teams = new(), Year = FantacalcioTime.ActualYear } },
                            Name = newLeagueName,
                        };
                    group.Leagues.Add(league);
                    await Api.Groups.UpdateAsync(group.Id, group);
                    if (State.Update != null)
                        await State.Update();
                }
                await ValidationsRefForLeague.ClearAll();
            }
        LoadingIndicator?.Hide();
    }

    async Task AddNewUser()
    {
        LoadingIndicator?.Show();
        if (ValidationsRefForIdentity != null)
            if (await ValidationsRefForIdentity.ValidateAll())
            {
                if (Identity != null && newEmail != null && State != null && group != null)
                {
                    var user = await Api.AppIdentity.GetAsync(newEmail);
                    if (user == null)
                    {
                        user = new AppIdentity
                            {
                                Email = newEmail,
                                Groups = new()
                                {
                                    group.ToGroupIdentity(newEmail)
                                },
                                Username = newEmail
                            };
                        await Api.AppIdentity.InsertAsync(newEmail, user);
                    }
                    group.Users.Add(new UserOfAGroup
                        {
                            Email = user.Email,
                            Role = IdentityRole.Reader,
                            Username = user.Username
                        });
                    await Api.Groups.UpdateAsync(group.Id, group);
                    if (State.Update != null)
                        await State.Update();
                }
                await ValidationsRefForIdentity.ClearAll();
            }
        LoadingIndicator?.Hide();
    }
}
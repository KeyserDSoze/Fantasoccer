@implements IDialogContentComponent<CancelPlayerModalModel>

<FluentMessageBarProvider Section="Buy Player" MaxMessageCount="1" />
<h1>@Content.Player.Name</h1>
<h1>@Content.Player.RealTeam.Name</h1>
<FluentSelect TOption="PlayerInTeamStatus" Items="Statuses" OptionText="@(t => t.ToString())" OptionValue="@(t => t.ToString())" @bind-SelectedOption=Content.Status />
    
@code {
    [Parameter]
    public required CancelPlayerModalModel Content { get; set; }
    [CascadingParameter]
    public FluentDialog? Dialog { get; set; }
    private Team? owner;
    private void ToggleDialogPrimaryActionButton(bool enable)
    {
        Dialog!.TogglePrimaryActionButton(enable);
    }
    private static readonly List<PlayerInTeamStatus> Statuses = new List<PlayerInTeamStatus>()
    {
        PlayerInTeamStatus.Removed,
        PlayerInTeamStatus.SoldWithNoReturnedPrice,
        PlayerInTeamStatus.Sold,
        PlayerInTeamStatus.SoldForOneHalf,
    };
}
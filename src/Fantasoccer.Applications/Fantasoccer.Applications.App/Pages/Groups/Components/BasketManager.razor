@if (CanCreateNewGroup)
{
    <FluentStack Orientation="Orientation.Vertical">
        <FluentSelect TOption="Basket" Items="@State.SelectedGroup!.Baskets" Value="@State.SelectedBasketId" SelectedOptionChanged="@OnSelectedBasketChanged" />
        <FluentTextField @bind-Value=newBasketName Label="Nome basket"></FluentTextField>
        <FluentButton Appearance="Appearance.Accent" OnClick="@CreateNewBasket">
            Crea nuovo basket
        </FluentButton>
    </FluentStack>
    <TeamsManager Teams="teams"></TeamsManager>
    <FluentButton Appearance="Appearance.Accent" OnClick="@CopyLastYearTeams">
        Copia dall'anno passato
    </FluentButton>
}


@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public bool CanCreateNewGroup { get; set; }
    private string? basketId;
    private List<AnnualTeam>? teams;
    private string? newBasketName;

    protected override Task OnParametersSetAsync()
    {
        basketId = State?.SelectedGroup?.Baskets?.FirstOrDefault()?.Id;
        teams = State?.GetTeamsFromBasket(State?.GroupId, basketId, State?.Year ?? FantacalcioTime.ActualYear);
        return base.OnParametersSetAsync();
    }
    private async Task CreateNewBasket()
    {
        if (State?.IsAuthenticated == true && newBasketName != null && State.HasAGroup)
        {
            LoadingIndicator?.Show();
            basketId = Guid.NewGuid().ToString();
            teams = new List<AnnualTeam>();
            var basket = new Basket
                {
                    Id = basketId,
                    Name = newBasketName,
                    Years = new() { new() { Year = FantacalcioTime.ActualYear, Teams = teams } }
                };
            State.SelectedGroup!.Baskets.Add(basket);
            await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup);
            LoadingIndicator?.Hide();
        }
    }
    private void OnSelectedBasketChanged(Basket basket)
    {
        if (State?.IsAuthenticated == true && State.SelectedGroup != null && basket != null)
        {
            LoadingIndicator?.Show();
            basketId = basket.Id;
            teams = State?.GetTeamsFromBasket(State?.GroupId, basketId, State?.Year ?? FantacalcioTime.ActualYear);
            LoadingIndicator?.Hide();
        }
    }
    private async Task CopyLastYearTeams()
    {
        if (State?.IsAuthenticated == true && State.HasAGroup && teams != null)
        {
            LoadingIndicator?.Show();
            var lastYearTeams = State?.GetTeamsFromBasket(State?.GroupId, basketId, (State?.Year ?? FantacalcioTime.ActualYear) - 1);
            if (lastYearTeams != null)
            {
                foreach (var lastYearTeam in lastYearTeams)
                {
                    var owner = lastYearTeam.Owner;
                    var teamName = lastYearTeam.Name;
                    var team = new AnnualTeam
                        {
                            Name = teamName,
                            Owner = owner
                        };
                    if (!teams.Any(x => x.Owner == lastYearTeam.Owner))
                        teams.Add(team);
                    var teamX = new Team()
                        {
                            Owner = owner,
                            Name = teamName,
                            Players = new()
                        };
                    if (!await Api.Team.ExistAsync(State.OtherTeamKey(owner)))
                    {
                        await Api.Team.InsertAsync(State.OtherTeamKey(owner), teamX);
                    }
                }
                await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup);
                State.AppUiUpdate();
            }
            LoadingIndicator?.Hide();
        }
    }
}


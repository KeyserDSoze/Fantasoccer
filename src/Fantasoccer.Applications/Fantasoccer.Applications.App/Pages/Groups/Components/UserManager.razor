@if (State?.HasAGroup == true && State.IsAdmin())
{
    <FluentStack Orientation="Orientation.Vertical">
        <FluentTextField @bind-Value=newEmail Pattern="@EmailPattern" Label="Email da aggiungere"></FluentTextField>
        <FluentButton Appearance="Appearance.Accent" OnClick="@AddNewUser">
            Aggiungi user
        </FluentButton>
    </FluentStack>
    <FluentDataGrid TGridItem="UserOfAGroup" Items="State.SelectedGroup.Users.AsQueryable()">
        <PropertyColumn Property="p => p.Email" />
        <PropertyColumn Property="p => p.Username" />
        <TemplateColumn Title="Admin">
            <FluentCheckbox Value="@context.Role.HasFlag(IdentityRole.Admin)" ValueChanged="@((x) => _ = ChangeRole(context, x, IdentityRole.Admin))" />
        </TemplateColumn>
        <TemplateColumn Title="Partecipante">
            <FluentCheckbox Value="@context.Role.HasFlag(IdentityRole.Participant)" ValueChanged="@((x) => _ = ChangeRole(context, x, IdentityRole.Participant))" />
        </TemplateColumn>
        <TemplateColumn Title="Visitatore">
            <FluentCheckbox Value="@context.Role.HasFlag(IdentityRole.Reader)" ValueChanged="@((x) => _ = ChangeRole(context, x, IdentityRole.Reader))" />
        </TemplateColumn>
        <TemplateColumn Title="Cancella">
            <FluentButton Appearance="Appearance.Accent" OnClick="@((x) => _ = DeleteAsync(context))">
                Cancella
            </FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public required Func<Task> SaveAsync { get; set; }
    private string? newEmail { get; set; }
    private const string EmailPattern = @"^[\w-\.]+@([\w-]+\.)+[\w-]{2,6}$";
    async Task AddNewUser()
    {
        LoadingIndicator?.Show();

        if (State?.IsAuthenticated == true && newEmail != null && State.HasAGroup)
        {
            var user = await Api.AppIdentity.GetAsync(newEmail);
            if (user == null)
            {
                user = new AppIdentity
                    {
                        Email = newEmail,
                        Groups = new()
                                {
                                    State.SelectedGroup!.ToGroupIdentity(newEmail)
                                },
                        Username = newEmail
                    };
                await Api.AppIdentity.InsertAsync(newEmail, user);
            }
            State.SelectedGroup.Users.Add(new UserOfAGroup
                {
                    Email = user.Email,
                    Role = IdentityRole.Reader,
                    Username = user.Username
                });
            await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup);
            State.UpdateUi();
        }
        LoadingIndicator?.Hide();
    }
    private async ValueTask DeleteAsync(UserOfAGroup user)
    {
        LoadingIndicator?.Show();
        if (State?.HasAGroup == true)
            State.SelectedGroup!.Users.Remove(user);
        await SaveAsync();
        LoadingIndicator?.Hide();
    }
    private async ValueTask ChangeRole(UserOfAGroup user, bool check, IdentityRole role)
    {
        if (State?.HasAGroup == true)
        {
            LoadingIndicator?.Show();
            if (check)
                user.Role |= role;
            else
                user.Role &= ~role;
            await Api.Groups.UpdateAsync(State.SelectedGroup!.Id, State.SelectedGroup);
            var toUpdateUser = await Api.AppIdentity.GetAsync(user.Email);
            if (toUpdateUser != null)
            {
                var groupToRemove = toUpdateUser.Groups.FirstOrDefault(x => x.Id == State.SelectedGroup.Id);
                if (groupToRemove != null)
                    toUpdateUser.Groups.Remove(groupToRemove);
                toUpdateUser.Groups.Add(State.SelectedGroup.ToGroupIdentity(toUpdateUser.Email));
                await Api.AppIdentity.UpdateAsync(toUpdateUser.Email, toUpdateUser);
            }
            LoadingIndicator?.Hide();
        }
    }
}

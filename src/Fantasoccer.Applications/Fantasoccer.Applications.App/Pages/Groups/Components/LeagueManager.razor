@using Blazorise.Components
@using Blazorise.LoadingIndicator;
@using Fantasoccer.Business;
@using System.Security.Cryptography

@if (CanCreateNewGroup)
{
    <Row>
        <Column>
            <Fields>
                <Validations @ref="@ValidationsRefForLeague" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                    <Field ColumnSize="ColumnSize.IsHalf">
                        @if (State?.SelectedGroup?.Leagues?.Any() == true)
                        {
                            <Select TValue="string" SelectedValue="@State.LeagueId" SelectedValueChanged="@OnSelectedLeagueChanged" Width="Width.Is50">
                                @foreach (var league in State.SelectedGroup.Leagues)
                                {
                                    <SelectItem Value="@league.Id">@league.Name</SelectItem>
                                }
                            </Select>
                        }
                    </Field>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <Validation UsePattern>
                            <FieldLabel>Nome lega</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="@newLeagueName" Pattern="[A-Za-z0-9. _-]{3,20}">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Validation>
                    </Field>
                </Validations>
            </Fields>
            <Button Color="Color.Primary" Clicked="@CreateNewLeague">
                Crea nuova lega
            </Button>
        </Column>
    </Row>

    @if (State.HasALeague)
    {
        <Check TValue="bool" @bind-Checked="State.SelectedLeague!.IsMain">Is Main</Check>
        <Row>
            <Column>
                <Fields>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <FieldLabel>Nome lega</FieldLabel>
                        <FieldBody>
                            <TextEdit @bind-Text="State.SelectedLeague.Name">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </FieldBody>
                    </Field>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <FieldLabel>Tipo di lega</FieldLabel>
                        <FieldBody>
                            <Select TValue="LeagueType" @bind-SelectedValue="State.SelectedLeague.Type">
                                <SelectItem Value="LeagueType.League">Lega</SelectItem>
                                <SelectItem Value="LeagueType.Cup">Coppa</SelectItem>
                                <SelectItem Value="LeagueType.NewCup">Champions</SelectItem>
                                <SelectItem Value="LeagueType.SuperLeague">Superlega</SelectItem>
                            </Select>
                        </FieldBody>
                    </Field>
                </Fields>
                <Fields>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <DropdownList TItem="Basket" TValue="string"
                                      Data="State.SelectedGroup!.Baskets"
                                      TextField="@((item)=>item.Name)"
                                      ValueField="@((item)=>item.Id)"
                                      SelectedValues="State.SelectedLeague!.BasketsId"
                                      SelectionMode="DropdownListSelectionMode.Checkbox"
                                      SelectedValuesChanged="(x) => ChangeBasketsAsync(x)"
                                      Color="Color.Primary">
                            Select baskets
                        </DropdownList>
                    </Field>
                    <Field ColumnSize="ColumnSize.IsHalf">
                    </Field>
                </Fields>
                @{
                    var settings = State?.SelectedYearlyLeague?.Settings;
                    if (settings != null)
                    {
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Starting money</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.StartingMoney" Min="500" Max="10000" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Delayed day</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.DelayedDay" Min="0" Max="38" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Cancelled Day</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.CancelledDay" Min="0" Max="38" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points For First Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForFirstGoal" Min="56" Max="72" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Point For Next Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForNextGoal" Min="1" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points For Own Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForOwnGoal" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Difference Points For Own Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.DifferencePointForOwnGoal" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points in Home</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointInHome" Min="0" Max="10" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Victory</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForVictory" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Defeat</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForDefeat" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Draw</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForDraw" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Strong Defense When they are 3</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForStrongDefense" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Strong Defense When they are 4</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForStrongDefense4" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Strong Defense When they are 5</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForStrongDefense5" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Goalkeeper cleansheet</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForCleanSheet" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Money for goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.MoneyForGoal" Min="-12" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Money for suffered goals</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.MoneyForSufferedGoal" Min="-12" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Random Auction</FieldLabel>
                                <FieldBody>
                                    <InputCheckbox @bind-Value="settings.RandomAuction" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Rank With Value Points</FieldLabel>
                                <FieldBody>
                                    <InputCheckbox @bind-Value="settings.RankWithValuePoints" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        foreach (var votesForRole in settings.Votes)
                        {
                            var votesSettings = votesForRole.Value;
                            var key = votesForRole.Key == Role.Undefined ? "All" : votesForRole.Key.ToString();
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Goal" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Penalty goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Penalty" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Suffered Goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.SufferedGoal" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Stopped Penalty for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.StoppedPenalty" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Wrong Penalty for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.WrongedPenalty" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Own Goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.OwnGoal" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Assist for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Assist" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Yellow and Red Card for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.YellowCard" Min="-12" Max="12" />
                                        <NumericPicker @bind-Value="votesSettings.RedCard" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Man of the match for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.ManOfTheMatch" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Injury for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Injury" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                        }
                    }
                }
                <Button Color="Color.Primary" Clicked="@SaveAsync">
                    Salva
                </Button>
                <Button Color="Color.Primary" Clicked="@(() => RecalculateAsync())">
                    Ricalcola anno
                </Button>
                <Button Color="Color.Primary" Clicked="@(() => RecalculateAsync(true))">
                    Ricalcola ultima giornata
                </Button>
                <NumericPicker @bind-Value="dayToRecalculate" Min="1" Max="38" />
                <Button Color="Color.Primary" Clicked="@(() => RecalculateAsync(true, true))">
                    Ricalcola giornata precisa
                </Button>
                <Button Color="Color.Primary" Clicked="@((x) => _ = CreateCalendarAndRankAsync())">
                    Create new calendar
                </Button>
                <Button Color="Color.Primary" Clicked="@((x) => _ = RandomizePlayerForAuctionsAsync())">
                    Randomize players for Auction
                </Button>
            </Column>
        </Row>
    }
}
@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public bool CanCreateNewGroup { get; set; }
    [Parameter]
    public required Func<Task> SaveAsync { get; set; }
    private Validations? ValidationsRefForLeague { get; set; }
    private string? newLeagueName { get; set; }
    private int dayToRecalculate = 38;
    protected override Task OnParametersSetAsync()
    {
        if (State?.HasALeague == true && State.SelectedYearlyLeague == null)
        {
            if (State.SelectedLeague!.Years == null)
                State.SelectedLeague.BasketsId = new();
        }
        return base.OnParametersSetAsync();
    }
    private async Task CreateNewLeague()
    {
        LoadingIndicator?.Show();
        if (ValidationsRefForLeague != null)
            if (await ValidationsRefForLeague.ValidateAll())
            {
                if (State?.IsAuthenticated == true && newLeagueName != null && State.HasAGroup)
                {
                    var leagueId = Guid.NewGuid().ToString();
                    var league = new League
                        {
                            Id = leagueId,
                            IsMain = true,
                            Type = LeagueType.League,
                            BasketsId = new(),
                            Name = newLeagueName,
                        };
                    State.SelectedGroup!.Leagues.Add(league);
                    await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup);
                    await State.ChangeLeagueAsync(leagueId);
                }
                await ValidationsRefForLeague.ClearAll();
            }
        LoadingIndicator?.Hide();
    }
    private void OnSelectedLeagueChanged(string leagueId)
    {
        LoadingIndicator?.Show();
        if (State?.IsAuthenticated == true && State.SelectedGroup != null)
        {
            State.ChangeLeagueAsync(leagueId);
            if (State?.SelectedYearlyLeague == null)
            {
                if (State.SelectedLeague?.BasketsId == null)
                    State.SelectedLeague.BasketsId = new();
            }
        }
        LoadingIndicator?.Hide();
    }
    [Inject]
    public required IFactory<ILeagueCalculator> LeagueCalculatorFactory { get; set; }
    [Inject]
    public required IRankCalculator RankCalculator { get; set; }
    [Inject]
    public required ITeamCalculator TeamCalculator { get; set; }
    private async ValueTask CreateCalendarAndRankAsync()
    {
        LoadingIndicator?.Show();
        if (State?.SelectedYearlyLeague != null && State?.SelectedLeague != null && State.Teams != null)
        {
            var leagueCalculator = LeagueCalculatorFactory.Create(State.SelectedLeague.Type.ToString())!;
            var calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            //todo check if not exists and doesn't start it
            if (calendar == null || calendar != null)
            {
                var teams = State.Teams.ToList();
                if (State.SelectedLeague.Type == LeagueType.Cup)
                {
                    var worthTeams = new List<AnnualTeam>();
                    if (State.SelectedGroup != null)
                    {
                        foreach (var mainLeague in State.SelectedGroup.Leagues.Where(x => x.IsMain))
                        {
                            var lastYear = mainLeague.Years.OrderByDescending(x => x.Year).Skip(1).FirstOrDefault();
                            if (lastYear != null)
                            {
                                var lastRank = await Api.Ranks.GetAsync(new LeagueKey()
                                    {
                                        Group = State.GroupId!,
                                        League = mainLeague.Id,
                                        Year = lastYear.Year
                                    });
                                if (lastRank != null)
                                {
                                    var firstEight = lastRank.RankedTeams.SelectMany(x => x.Value).OrderByDescending(x => x.Point).Take(8).ToList();
                                    foreach (var team in teams)
                                    {
                                        if (firstEight.Any(x => x.Owner == team.Owner))
                                        {
                                            worthTeams.Add(team);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    foreach (var worthedTeam in worthTeams)
                    {
                        teams.Remove(worthedTeam);
                    }
                    if (worthTeams.Count < 16)
                    {
                        worthTeams.AddRange(Randomize(teams).Take(16 - worthTeams.Count));
                    }
                    teams = worthTeams;

                    List<AnnualTeam> Randomize(List<AnnualTeam> teams)
                    {
                        var teamsToAdd = new List<AnnualTeam>();
                        foreach (var team in teams)
                            teamsToAdd.Add(team);
                        List<AnnualTeam> randomizedTeams = new();
                        while (teamsToAdd.Count > 0)
                        {
                            var team = teamsToAdd[GetRandom(teamsToAdd.Count)];
                            randomizedTeams.Add(team);
                            teamsToAdd.Remove(team);
                        }
                        return randomizedTeams;
                    }
                    int GetRandom(int max)
                    {
                        var value = RandomNumberGenerator.GetInt32(0, max);
                        if (max == value)
                            return max - 1;
                        return value;
                    }
                }
                calendar = leagueCalculator.GetRandomCalendar(FantacalcioTime.ActualYear, State.SelectedYearlyLeague, teams);
                await Api.Calendar.UpdateAsync(State.LeagueKey, calendar);
            }
            if (calendar != null)
            {
                var rank = leagueCalculator.GetRank(State?.SelectedLeagueSettings ?? LeagueSetting.Default, calendar);
                if (await Api.Ranks.ExistAsync(State.LeagueKey))
                {
                    await Api.Ranks.UpdateAsync(State.LeagueKey, rank);
                }
                else
                {
                    await Api.Ranks.InsertAsync(State.LeagueKey, rank);
                }
            }
        }
        LoadingIndicator?.Hide();
    }
    private async Task ChangeBasketsAsync(IReadOnlyList<string> basketsId)
    {
        LoadingIndicator?.Show();
        if (State?.HasALeague == true)
        {
            State.SelectedLeague.BasketsId = basketsId.ToList();
            await Api.Groups.UpdateAsync(State.SelectedGroup!.Id, State.SelectedGroup);
        }
        LoadingIndicator?.Hide();
    }
    private async Task RandomizePlayerForAuctionsAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var allPlayersWrapper = await Api.RealPlayers.GetAsync(State.Year);
            if (allPlayersWrapper?.Players != null)
            {
                var randomizedPlayers = allPlayersWrapper.Players
                    .OrderBy(x => x.Role)
                    .ThenBy(x => RandomNumberGenerator.GetInt32(0, int.MaxValue))
                    .ToList();
                foreach(var player in randomizedPlayers)
                {
                    player.Visible = false;
                }
                await Api.RandomizedRealPlayers.UpdateAsync(
                    State.LeagueKey,
                    new RealPlayersWrapper
                        {
                            Players = randomizedPlayers
                        });
            }
            LoadingIndicator?.Hide();
        }
    }
    private async Task RecalculateAsync(bool onlyLastDay = false, bool preciseDay = false)
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            var realCalendar = await Api.RealCalendar.GetAsync(State.Year);
            var lastDay = realCalendar.LastDay;
            var yearlyLeague = State?.SelectedYearlyLeague;
            var leagueType = State!.SelectedLeague!.Type;
            var settings = yearlyLeague?.Settings;
            if (settings != null)
            {
                foreach (var round in calendar.Rounds)
                {
                    foreach (var day in round.Value)
                    {
                        if (day.Number <= settings.CancelledDay)
                        {
                            foreach (var game in day.Games)
                            {
                                if (game.Result != null)
                                    game.Result.IsCancelled = true;
                                else
                                    game.Result = new GameResult { IsCancelled = true };
                            }
                        }
                        else if (!onlyLastDay || (!preciseDay && day.SerieADay == lastDay.SerieADay) || (preciseDay && day.SerieADay == dayToRecalculate))
                        {
                            await TeamCalculator.BuildRequestAsync(yearlyLeague.Year, day.SerieADay, State!.SelectedLeague!.Type, yearlyLeague.Settings, false, true, false);
                            if (TeamCalculator.Official == null || TeamCalculator.IsLive)
                                break;
                            foreach (var game in day.Games)
                            {
                                var homeTeamKey = State.TeamDayKey(day.SerieADay, game.HomeOwner);
                                var homeTeam = await GetTeamAsync(game.HomeOwner, await Api.DailyTeam.GetAsync(homeTeamKey), homeTeamKey);
                                var awayTeamKey = State.TeamDayKey(day.SerieADay, game.AwayOwner);
                                var awayTeam = await GetTeamAsync(game.AwayOwner, await Api.DailyTeam.GetAsync(awayTeamKey), awayTeamKey);
                                var homePoint = TeamCalculator.CalculatePoint(homeTeam.ActivePlayers);
                                var awayPoint = TeamCalculator.CalculatePoint(awayTeam.ActivePlayers);
                                var result = new GameResult
                                    {
                                        Home = homePoint,
                                        Away = awayPoint,
                                    };
                                result.CalculateGoals(yearlyLeague.Settings);
                                game.Result = result;

                                async Task<Team?> GetTeamAsync(string owner, Team? team, TeamDayKey teamDayKey)
                                {
                                    if (team != null)
                                        return team;
                                    team = await Api.Team.GetAsync(State.OtherTeamKey(owner));
                                    foreach (var player in team.ActivePlayers)
                                    {
                                        player.Position = FantaSoccerRole.Tribune;
                                    }
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.GoalKeeper).First().Position = FantaSoccerRole.GoalKeeper;
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.GoalKeeper).Skip(1).First().Position = FantaSoccerRole.BackupGoalKeeper;
                                    // foreach (var player in team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Defensor).Take(3))
                                    // {
                                    //     player.Position = FantaSoccerRole.Defensor;
                                    // }
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Defensor).Skip(3).First().Position = FantaSoccerRole.FirstBackupDefensor;
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Defensor).Skip(4).First().Position = FantaSoccerRole.SecondBackupDefensor;
                                    // foreach (var player in team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Midfielder).Take(4))
                                    // {
                                    //     player.Position = FantaSoccerRole.Midfielder;
                                    // }
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Midfielder).Skip(4).First().Position = FantaSoccerRole.FirstBackupMidfielder;
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Midfielder).Skip(5).First().Position = FantaSoccerRole.SecondBackupMidfielder;
                                    // foreach (var player in team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Forward).Take(3))
                                    // {
                                    //     player.Position = FantaSoccerRole.Forward;
                                    // }
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Forward).Skip(3).First().Position = FantaSoccerRole.FirstBackupForward;
                                    // team.ActivePlayers.OrderByDescending(x => x.Price).Where(x => x.Role == Role.Forward).Skip(4).First().Position = FantaSoccerRole.SecondBackupForward;
                                    await Api.DailyTeam.UpdateAsync(teamDayKey, team);
                                    return team;
                                }
                            }
                        }
                    }
                }
                var leagueCalculator = LeagueCalculatorFactory.Create(leagueType.ToString())!;
                await Api.Calendar.UpdateAsync(State.LeagueKey, calendar);
                var rank = leagueCalculator.GetRank(yearlyLeague.Settings, calendar);
                await Api.Ranks.UpdateAsync(State.LeagueKey, rank);
                LoadingIndicator?.Hide();
            }
        }
    }
}

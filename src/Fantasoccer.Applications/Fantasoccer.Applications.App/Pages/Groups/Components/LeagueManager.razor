@using Blazorise.Components
@using Blazorise.LoadingIndicator;

@if (CanCreateNewGroup)
{
    <Row>
        <Column>
            <Fields>
                <Validations @ref="@ValidationsRefForLeague" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                    <Field ColumnSize="ColumnSize.IsHalf">
                        @if (State?.SelectedGroup?.Leagues?.Any() == true)
                        {
                            <Select TValue="string" SelectedValue="@State.LeagueId" SelectedValueChanged="@OnSelectedLeagueChanged" Width="Width.Is50">
                                @foreach (var league in State.SelectedGroup.Leagues)
                                {
                                    <SelectItem Value="@league.Id">@league.Name</SelectItem>
                                }
                            </Select>
                        }
                    </Field>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <Validation UsePattern>
                         <FieldLabel>Nome lega</FieldLabel>
                         <FieldBody>
                             <TextEdit @bind-Text="@newLeagueName" Pattern="[A-Za-z0-9. _-]{3,20}">
                                 <Feedback>
                                     <ValidationError />
                                 </Feedback>
                             </TextEdit>
                         </FieldBody>
                     </Validation>
                 </Field>
             </Validations>
         </Fields>
         <Button Color="Color.Primary" Clicked="@CreateNewLeague">
             Crea nuova lega
         </Button>
     </Column>
 </Row>

    @if (State.HasALeague)
    {
        <Check TValue="bool" @bind-Checked="State.SelectedLeague!.IsMain">Is Main</Check>
        <Row>
            <Column>
                <Fields>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <FieldLabel>Nome lega</FieldLabel>
                        <FieldBody>
                            <TextEdit @bind-Text="State.SelectedLeague.Name">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </FieldBody>
                    </Field>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <FieldLabel>Tipo di lega</FieldLabel>
                        <FieldBody>
                            <Select TValue="LeagueType" @bind-SelectedValue="State.SelectedLeague.Type">
                                <SelectItem Value="LeagueType.League">Lega</SelectItem>
                                <SelectItem Value="LeagueType.Cup">Coppa</SelectItem>
                            </Select>
                        </FieldBody>
                    </Field>
                </Fields>
                <Fields>
                    <Field ColumnSize="ColumnSize.IsHalf">
                        <DropdownList TItem="Basket" TValue="string"
                                      Data="State.SelectedGroup!.Baskets"
                                      TextField="@((item)=>item.Name)"
                                      ValueField="@((item)=>item.Id)"
                                      SelectedValues="State.SelectedLeague!.BasketsId"
                                      SelectionMode="DropdownListSelectionMode.Checkbox"
                                      SelectedValuesChanged="(x) => ChangeBasketsAsync(x)"
                                      Color="Color.Primary">
                            Select baskets
                        </DropdownList>
                    </Field>
                    <Field ColumnSize="ColumnSize.IsHalf">
                    </Field>
                </Fields>
                @{
                    var settings = State?.SelectedYearlyLeague?.Settings;
                    if (settings != null)
                    {
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Starting money</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.StartingMoney" Min="500" Max="10000" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Delayed day</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.DelayedDay" Min="0" Max="38" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Cancelled Day</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.CancelledDay" Min="0" Max="38" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points For First Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForFirstGoal" Min="56" Max="72" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Point For Next Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForNextGoal" Min="1" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points For Own Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForOwnGoal" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Difference Points For Own Goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.DifferencePointForOwnGoal" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points in Home</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointInHome" Min="0" Max="10" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Victory</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForVictory" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Defeat</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForDefeat" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Draw</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForDraw" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Strong Defense When they are 3</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForStrongDefense" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Strong Defense When they are 4</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForStrongDefense4" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Strong Defense When they are 5</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForStrongDefense5" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Points for Goalkeeper cleansheet</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.PointForCleanSheet" Min="0" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Money for goal</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.MoneyForGoal" Min="-12" Max="12" />
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Money for suffered goals</FieldLabel>
                                <FieldBody>
                                    <NumericPicker @bind-Value="settings.MoneyForSufferedGoal" Min="-12" Max="12" />
                                </FieldBody>
                            </Field>
                        </Fields>
                        foreach (var votesForRole in settings.Votes)
                        {
                            var votesSettings = votesForRole.Value;
                            var key = votesForRole.Key == Role.Undefined ? "All" : votesForRole.Key.ToString();
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Goal" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Penalty goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Penalty" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Suffered Goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.SufferedGoal" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Stopped Penalty for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.StoppedPenalty" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Wrong Penalty for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.WrongedPenalty" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Own Goal for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.OwnGoal" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                            <Fields>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Assist for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.Assist" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                                <Field ColumnSize="ColumnSize.IsHalf">
                                    <FieldLabel>Points for Yellow and Red Card for @key</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker @bind-Value="votesSettings.YellowCard" Min="-12" Max="12" />
                                        <NumericPicker @bind-Value="votesSettings.RedCard" Min="-12" Max="12" />
                                    </FieldBody>
                                </Field>
                            </Fields>
                        }
                    }
                }
                <Button Color="Color.Primary" Clicked="@SaveAsync">
                    Salva
                </Button>
                <Button Color="Color.Primary" Clicked="@((x) => _ = CreateCalendarAndRankAsync())">
                    Create new calendar
                </Button>
            </Column>
        </Row>
    }
}
@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public bool CanCreateNewGroup { get; set; }
    [Parameter]
    public required Func<Task> SaveAsync { get; set; }
    private Validations? ValidationsRefForLeague { get; set; }
    private string? newLeagueName { get; set; }
    protected override Task OnParametersSetAsync()
    {
        if (State?.HasALeague == true && State.SelectedYearlyLeague == null)
        {
            if (State.SelectedLeague!.Years == null)
                State.SelectedLeague.BasketsId = new();
        }
        return base.OnParametersSetAsync();
    }
    private async Task CreateNewLeague()
    {
        LoadingIndicator?.Show();
        if (ValidationsRefForLeague != null)
            if (await ValidationsRefForLeague.ValidateAll())
            {
                if (State?.IsAuthenticated == true && newLeagueName != null && State.HasAGroup)
                {
                    var leagueId = Guid.NewGuid().ToString();
                    var league = new League
                        {
                            Id = leagueId,
                            IsMain = true,
                            Type = LeagueType.League,
                            BasketsId = new(),
                            Name = newLeagueName,
                        };
                    State.SelectedGroup!.Leagues.Add(league);
                    await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup);
                    await State.ChangeLeagueAsync(leagueId);
                }
                await ValidationsRefForLeague.ClearAll();
            }
        LoadingIndicator?.Hide();
    }
    private void OnSelectedLeagueChanged(string leagueId)
    {
        LoadingIndicator?.Show();
        if (State?.IsAuthenticated == true && State.SelectedGroup != null)
        {
            State.ChangeLeagueAsync(leagueId);
            if (State?.SelectedYearlyLeague == null)
            {
                if (State.SelectedLeague?.BasketsId == null)
                    State.SelectedLeague.BasketsId = new();
            }
        }
        LoadingIndicator?.Hide();
    }
    [Inject]
    public required IRandomCalendar RandomCalendar { get; set; }
    [Inject]
    public required IRankCalculator RankCalculator { get; set; }
    private async ValueTask CreateCalendarAndRankAsync()
    {
        LoadingIndicator?.Show();
        if (State?.SelectedYearlyLeague != null && State?.SelectedLeague != null && State.Teams != null)
        {
            var calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            if (calendar == null || calendar != null)
            {
                calendar = RandomCalendar.GetRandomCalendar(FantacalcioTime.ActualYear, State.SelectedLeague.Type, State.SelectedYearlyLeague, State.Teams);
                await Api.Calendar.InsertAsync(State.LeagueKey, calendar);
            }
            if (await Api.Calendar.ExistAsync(State.LeagueKey))
            {
                var rank = RankCalculator.GetRank(State?.SelectedLeagueSettings ?? LeagueSetting.Default, calendar, State.SelectedLeague.Type);
                if (await Api.Ranks.ExistAsync(State.LeagueKey))
                {
                    await Api.Ranks.UpdateAsync(State.LeagueKey, rank);
                }
                else
                {
                    await Api.Ranks.InsertAsync(State.LeagueKey, rank);
                }
            }
        }
        LoadingIndicator?.Hide();
    }
    private async Task ChangeBasketsAsync(IReadOnlyList<string> basketsId)
    {
        LoadingIndicator?.Show();
        if (State?.HasALeague == true)
        {
            State.SelectedLeague.BasketsId = basketsId.ToList();
            await Api.Groups.UpdateAsync(State.SelectedGroup!.Id, State.SelectedGroup);
        }
        LoadingIndicator?.Hide();
    }
}

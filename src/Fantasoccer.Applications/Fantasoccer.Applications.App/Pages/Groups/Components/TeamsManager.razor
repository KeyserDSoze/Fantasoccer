@if (State != null && State?.IsAdmin() == true && State.SelectedGroup != null)
{
    <FluentStack Orientation="Orientation.Vertical">
        if (Teams != null)
        {
        <FluentDataGrid Items="@Teams.AsQueryable()">
            <PropertyColumn Property="@(p => p.Name)" Title="Nome" Sortable="true" />
            <TemplateColumn Title="Owner">
                <FluentSelect TOption="UserOfAGroup" Items="@State.SelectedGroup.Users" Value="@context.Owner" SelectedOptionChanged="(newOwner) => ChangeOwnerAsync(context.Owner, newOwner.Email)" />
            </TemplateColumn>
            @*  <TemplateColumn Title="Co-Owner">
        <FluentSelect Multiple="true"
        TOption="UserOfAGroup"
        Items="@State.SelectedGroup.Users"
        OptionText="@(p => $"{p.Username} [{p.Email}]")"
        OptionValue="@(p => p.Email)"
        @bind-SelectedOptions="@State.SelectedGroup.Users.Where(x => context.AdditionalOwners.Contains(x.Email))" />
        </TemplateColumn> *@
            <TemplateColumn Title="Cancella">
                <FluentButton Appearance="Appearance.Accent" OnClick="@((x) => _ = DeleteAsync(context))">
                    Cancella
                </FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
        }
        <FluentTextField @bind-Value=newTeamName Label="Nuovo team"></FluentTextField>
        <FluentSelect TOption="UserOfAGroup"
                      Items="@State.SelectedGroup.Users"
                      OptionText="@(p => $"{p.Username} [{p.Email}]")"
                      OptionValue="@(p => p.Email)"
                      @bind-Value="owner" />
        <FluentButton Appearance="Appearance.Accent" OnClick="@AddNewTeam">
            Aggiungi un team al basket
        </FluentButton>
    </FluentStack>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public required List<AnnualTeam> Teams { get; set; }
    private string? newBasketName;
    private string? newTeamName;
    private string? owner;
    protected override Task OnParametersSetAsync()
    {
        owner = State?.SelectedGroup?.Users?.FirstOrDefault()?.Email;
        return base.OnParametersSetAsync();
    }
    private async Task AddNewTeam()
    {
        LoadingIndicator?.Show();
        if (State?.IsAuthenticated == true && State.HasAGroup && owner != null)
        {
            if (!Teams.Any(x => x.Owner == owner))
            {
                newTeamName = string.IsNullOrWhiteSpace(newTeamName) ? $"{owner} team" : newTeamName;
                var team = new AnnualTeam
                    {
                        Name = newTeamName,
                        Owner = owner
                    };
                Teams!.Add(team);
                if (await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup))
                {
                    var teamX = new Team()
                        {
                            Owner = owner,
                            Name = newTeamName,
                            Players = new()
                        };
                    if (!await Api.Team.ExistAsync(State.OtherTeamKey(owner)))
                    {
                        await Api.Team.InsertAsync(State.OtherTeamKey(owner), teamX);
                    }
                    else
                    {
                        await Api.Team.UpdateAsync(State.OtherTeamKey(owner), teamX);
                    }
                }
                newTeamName = string.Empty;
                State.AppUiUpdate();
            }
        }
        LoadingIndicator?.Hide();
    }
    private async ValueTask DeleteAsync(AnnualTeam team)
    {
        LoadingIndicator?.Show();
        if (State != null)
        {
            if (State.HasAGroup && Teams != null)
                Teams.Remove(team);
            if (await Api.Team.ExistAsync(State.OtherTeamKey(team.Owner)))
                await Api.Team.DeleteAsync(State.OtherTeamKey(team.Owner));
        }
        LoadingIndicator?.Hide();
    }

    private async Task ChangeOwnerAsync(string email, string newOwnerEmail)
    {
        LoadingIndicator?.Show();
        if (Teams != null && State != null && !Teams.Any(x => x.Owner == newOwnerEmail))
        {
            foreach (var team in Teams.Where(x => x.Owner == email))
            {
                team.Owner = newOwnerEmail;
                if (await Api.Team.ExistAsync(State.OtherTeamKey(email)))
                {
                    var newTeam = await Api.Team.GetAsync(State.OtherTeamKey(email));
                    if (!await Api.Team.ExistAsync(State.OtherTeamKey(newOwnerEmail)))
                    {
                        newTeam.Owner = newOwnerEmail;
                        if (await Api.Team.InsertAsync(State.OtherTeamKey(newOwnerEmail), newTeam))
                        {
                            await Api.Team.DeleteAsync(State.OtherTeamKey(email));
                        }
                    }
                }
            }
            await Api.Groups.UpdateAsync(State.GroupId, State.SelectedGroup);
        }
        LoadingIndicator?.Hide();
    }
    private async Task ChangeCoOwnersAsync(string email, IEnumerable<UserOfAGroup> users)
    {
        LoadingIndicator?.Show();
        if (Teams != null)
        {
            foreach (var team in Teams.Where(x => x.Owner == email))
            {
                var emails = users.Select(x => x.Email).ToList();
                team.AdditionalOwners = emails;
                if (await Api.Team.ExistAsync(State.OtherTeamKey(email)))
                {
                    var teamToUpdate = await Api.Team.GetAsync(State.OtherTeamKey(email));
                    teamToUpdate.AdditionalOwners = emails;
                    await Api.Team.InsertAsync(State.OtherTeamKey(email), teamToUpdate);
                }
            }
            await Api.Groups.UpdateAsync(State.GroupId, State.SelectedGroup);
        }
        LoadingIndicator?.Hide();
    }
}

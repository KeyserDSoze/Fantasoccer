@page "/manageteams"
@using Blazorise.LoadingIndicator;
@using Fantasoccer.Domain;

<PageTitle>Manage teams</PageTitle>

@if (State?.IsAdmin() == true && players != null && teams != null && visibilities != null)
{
    <Row>
        <Column Width="Width.Is50">
            <Tabs>
                <Items>
                    @foreach (var role in Roles)
                    {
                        <Tab Name="@role.ToString()">@role</Tab>
                    }
                </Items>
                <Content>
                    @foreach (var role in Roles)
                    {
                        <TabPanel Name="@role.ToString()">
                            <Table>
                                <TableHeader>
                                    <TableRow>
                                        <TableHeaderCell>Name</TableHeaderCell>
                                        <TableHeaderCell>Team</TableHeaderCell>
                                        <TableHeaderCell>Avg</TableHeaderCell>
                                        <TableHeaderCell>F Avg</TableHeaderCell>
                                        <TableHeaderCell>Playerd</TableHeaderCell>
                                        <TableHeaderCell>Next</TableHeaderCell>
                                        <TableHeaderCell>Status</TableHeaderCell>
                                    </TableRow>
                                </TableHeader>
                                <TableBody>
                                    @foreach (var player in players.Where(x => x.Role == role).OrderBy(x => x.Name))
                                    {
                                        var statPlayer = GetStatPlayer(player);
                                        var chancePlayer = GetChancePlayer(player);
                                        <TableRow Clicked="(x) => Buy(player)">
                                            <TableRowHeader>@player.Name</TableRowHeader>
                                            <TableRowCell>@player.RealTeam.Name</TableRowCell>
                                            <TableRowCell>@statPlayer?.Average.ToString("N2")</TableRowCell>
                                            <TableRowCell>@statPlayer?.FantaAverage.ToString("N2")</TableRowCell>
                                            <TableRowCell>@statPlayer?.WithVote</TableRowCell>
                                            <TableRowCell>@chancePlayer?.Chance.Fantagazzetta</TableRowCell>
                                            <TableRowCell>@chancePlayer?.Chance.Status</TableRowCell>
                                        </TableRow>
                                    }
                                </TableBody>
                            </Table>
                        </TabPanel>
                    }
                </Content>
            </Tabs>
        </Column>
        <Column Width="Width.Is50">
            <Accordion>
                @foreach (var team in teams)
                {
                    <Collapse Visible="@visibilities[team.Owner]">
                        <CollapseHeader>
                            <Heading Size="HeadingSize.Is5">
                                <AccordionToggle>@team.Name (@team.Owner) @(State.SelectedLeagueSettings!.StartingMoney - team.Cost) [@team.ActivePlayers.Count(x => x.Role == Role.GoalKeeper)-@team.ActivePlayers.Count(x => x.Role == Role.Defensor)-@team.ActivePlayers.Count(x => x.Role == Role.Midfielder)-@team.ActivePlayers.Count(x => x.Role == Role.Forward)] [@team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.GoalKeeper)-@team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.Defensor)-@team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.Midfielder)-@team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.Forward) = @team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count()]</AccordionToggle>
                            </Heading>
                        </CollapseHeader>
                        <CollapseBody>
                            <Table>
                                <TableHeader>
                                    <TableRow>
                                        <TableHeaderCell>Name</TableHeaderCell>
                                        <TableHeaderCell>Team</TableHeaderCell>
                                        <TableHeaderCell>Price</TableHeaderCell>
                                        <TableHeaderCell>Role</TableHeaderCell>
                                    </TableRow>
                                </TableHeader>
                                <TableBody>
                                    @foreach (var player in team.ActivePlayers.OrderBy(x => x.Role).ThenBy(x => x.Name))
                                    {
                                        <TableRow Clicked="(x) => Remove(player, team.Owner)">
                                            <TableRowHeader>@player.Name</TableRowHeader>
                                            <TableRowCell>@player.RealTeam.Name</TableRowCell>
                                            <TableRowCell>@player.Price</TableRowCell>
                                            <TableRowCell>@player.Role</TableRowCell>
                                        </TableRow>
                                    }
                                </TableBody>
                            </Table>
                        </CollapseBody>
                    </Collapse>
                }
            </Accordion>
        </Column>
    </Row>
}
<Modal @ref="modalForBuy">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Buy</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel>@realPlayer?.Name</FieldLabel>
                <FieldLabel>@realPlayer?.RealTeam.Name</FieldLabel>
            </Field>
            <Field>
                <NumericEdit @bind-Value="@price" />
            </Field>
            <Field>
                @if (teams != null)
                {
                    <Select TValue="string" @bind-SelectedValue="@teamOwner">
                        @foreach (var team in teams)
                        {
                            <SelectItem Value="@team.Owner">@team.Name</SelectItem>
                        }
                    </Select>
                }
            </Field>
            @if (error != null)
            {
                <Field>
                    <FieldLabel>@error</FieldLabel>
                </Field>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@HideModal">Close</Button>
            <Button Color="Color.Primary" Clicked="@Save">Add player</Button>
        </ModalFooter>
    </ModalContent>
</Modal>
<Modal @ref="modalForRemove">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Remove</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel>@realPlayer?.Name</FieldLabel>
                <FieldLabel>@realPlayer?.RealTeam.Name</FieldLabel>
            </Field>
            <Field>
                <Select TValue="PlayerInTeamStatus" @bind-SelectedValue="@status">
                    @foreach (var status in Statuses)
                    {
                        <SelectItem Value="@status">@status</SelectItem>
                    }
                </Select>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@HideModal">Close</Button>
            <Button Color="Color.Primary" Clicked="@ConfirmRemove">Remove player</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private List<RealPlayer>? allPlayers;
    private List<RealPlayer>? players;
    private List<Team>? teams;
    private Dictionary<string, bool>? visibilities;
    private string selectedTab = Roles.First().ToString();
    private static readonly List<Role> Roles = new()
    {
        Role.GoalKeeper,
        Role.Defensor,
        Role.Midfielder,
        Role.Forward
    };
    private RealPlayer? realPlayer;
    private int price;
    private string? teamOwner;
    private string? error;
    private List<StatPlayer>? statsPlayers;
    private List<ChancedRealPlayer>? chances;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State?.Teams != null && State?.IsAdmin() == true)
        {
            LoadingIndicator?.Show();
            teams = new();
            visibilities = new();
            var allPlayersWrapper = await Api.RealPlayers.GetAsync(State.Year);
            allPlayers = allPlayersWrapper.Players.OrderBy(x => x.Role).ToList();
            foreach (var team in State.Teams)
            {
                var teamKey = State.OtherTeamKey(team.Owner);
                var actualTeam = await Api.Team.GetAsync(teamKey);
                if (actualTeam == null)
                {
                    actualTeam = new() { Name = team.Name, Owner = team.Owner, Players = new() };
                    await Api.Team.InsertAsync(teamKey, actualTeam);
                }
                teams.Add(actualTeam);
                visibilities.Add(team.Owner, false);
                foreach (var player in actualTeam.ActivePlayers)
                {
                    var playerKey = player.Key;
                    var toRemovePlayer = allPlayersWrapper.Players.FirstOrDefault(x => x.Key == playerKey);
                    if (toRemovePlayer != null)
                    {
                        allPlayersWrapper.Players.Remove(toRemovePlayer);
                    }
                }
            }
            players = allPlayersWrapper.Players;
            var playersWrapper = await Api.StatsPlayers.GetAsync(State.Year);
            statsPlayers = playersWrapper?.Players;
            var calendar = await Api.RealCalendar.GetAsync(FantacalcioTime.ActualYear);
            chances = (await Api.Chances.GetAsync(State.YearDayKey(calendar?.NextDay?.SerieADay ?? calendar?.LiveDay?.SerieADay ?? 3)))?.Players;
        }
        await base.OnParametersSetAsync();
    }
    private StatPlayer? GetStatPlayer(RealPlayer player)
    {
        if (statsPlayers != null)
        {
            var playerKey = player.Key;
            var statPlayer = statsPlayers.FirstOrDefault(x => x.Key == playerKey);
            return statPlayer;
        }
        return null;
    }
    private ChancedRealPlayer? GetChancePlayer(RealPlayer player)
    {
        if (chances != null)
        {
            var playerKey = player.Key;
            var chancePlayer = chances.FirstOrDefault(x => x.Key == playerKey);
            return chancePlayer;
        }
        return null;
    }
    private Modal modalForBuy;

    private async Task Buy(RealPlayer player)
    {
        realPlayer = player;
        teamOwner = teams.First().Owner;
        price = 1;
        var x = selectedTab;
        await modalForBuy.Show();
    }

    private Task HideModal()
    {
        return modalForBuy.Hide();
    }
    private async Task Save()
    {
        var team = teams.FirstOrDefault(x => x.Owner == teamOwner);
        error = Check(team);
        if (error == null)
        {
            team.Players.Add(new Player
                {
                    IsActive = true,
                    Name = realPlayer.Name,
                    RealTeam = realPlayer.RealTeam,
                    Price = price,
                    Role = realPlayer.Role,
                    Status = PlayerInTeamStatus.Active,
                    Position = FantaSoccerRole.Tribune
                });
            await Api.Team.UpdateAsync(State.OtherTeamKey(teamOwner), team);
            players.Remove(realPlayer);
            visibilities[teamOwner] = true;
            error = null;
            StateHasChanged();
            await modalForBuy.Hide();
        }
    }
    private string? Check(Team team)
    {
        switch (realPlayer.Role)
        {
            case Role.GoalKeeper:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 3)
                    return "Troppi portieri";
                break;
            case Role.Defensor:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 8)
                    return "Troppi difensori";
                break;
            case Role.Midfielder:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 8)
                    return "Troppi centrocampisti";
                break;
            case Role.Forward:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 6)
                    return "Troppi attaccanti";
                break;
        }
        if (State.SelectedLeagueSettings.StartingMoney - (team.Cost + price + (25 - 1 - team.ActivePlayers.Count())) < 0)
            return "Stai spendendo troppi soldi";
        return null;
    }
    private Modal modalForRemove;

    private Task Remove(Player player, string owner)
    {
        var playerKey = player.Key;
        realPlayer = allPlayers.FirstOrDefault(x => x.Key == playerKey);
        teamOwner = owner;
        return modalForRemove.Show();
    }

    private Task HideRemoveModal()
    {
        return modalForRemove.Hide();
    }
    private async Task ConfirmRemove()
    {
        var team = teams.FirstOrDefault(x => x.Owner == teamOwner);
        var playerKey = realPlayer.Key;
        var player = team.Players.First(x => x.Key == playerKey);
        player.Status = status;
        if (player.Status == PlayerInTeamStatus.Removed)
            team.Players.Remove(player);
        await Api.Team.UpdateAsync(State.OtherTeamKey(teamOwner), team);
        visibilities[teamOwner] = true;
        if (player.IsActive)
            players.Add(player);
        StateHasChanged();
        await modalForRemove.Hide();
    }
    private PlayerInTeamStatus status = PlayerInTeamStatus.Removed;
    private static readonly List<PlayerInTeamStatus> Statuses = new List<PlayerInTeamStatus>()
    {
        PlayerInTeamStatus.Removed,
        PlayerInTeamStatus.SoldWithNoReturnedPrice,
        PlayerInTeamStatus.Sold,
        PlayerInTeamStatus.SoldForOneHalf,
    };
}
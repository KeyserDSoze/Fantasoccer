@page "/edit"

@if (players != null)
{
    <DropContainer TItem="Player" Items="@players" ItemsFilter="@((item, dropZone) => item.Position.ToString() == dropZone)" ItemDropped="@ItemDropped" Flex="Flex.Wrap.Grow.Is1">
        <ChildContent>
            <DropZone TItem="Player" Name="Goalkeeper" DropAllowed="@((item) =>  item.Role == Role.GoalKeeper)" Border="Border.Rounded" Background="Background.Light" Padding="Padding.Is3" Margin="Margin.Is3" Flex="Flex.Grow.Is1">
                <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Goalkeeper</Heading>
            </DropZone>
            <DropZone TItem="Player" Name="Defensor" DropAllowed="@((item) =>  item.Role == Role.Defensor)" Border="Border.Rounded" Background="Background.Light" Padding="Padding.Is3" Margin="Margin.Is3" Flex="Flex.Grow.Is1">
                <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Defensor</Heading>
            </DropZone>
            <DropZone TItem="Player" Name="Midfielder" DropAllowed="@((item) =>  item.Role == Role.Midfielder)" Border="Border.Rounded" Background="Background.Light" Padding="Padding.Is3" Margin="Margin.Is3" Flex="Flex.Grow.Is1">
                <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Midfielder</Heading>
            </DropZone>
            <DropZone TItem="Player" Name="Forward" DropAllowed="@((item) => item.Role == Role.Forward)" Border="Border.Rounded" Background="Background.Light" Padding="Padding.Is3" Margin="Margin.Is3" Flex="Flex.Grow.Is1">
                <Heading Size="HeadingSize.Is4" Margin="Margin.Is3.FromBottom">Forward</Heading>
            </DropZone>
        </ChildContent>
        <ItemTemplate>
            <Card Shadow="Shadow.Default" Margin="Margin.Is3.OnY">
                <CardBody>
                    @* <Image Source="@context.Image" Text="DragDrop image example" Style="width:48px;height:48px;" /> *@
                    @context.Name
                </CardBody>
            </Card>
        </ItemTemplate>
    </DropContainer>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    private IEnumerable<Player>? players;
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            var realCalendar = await Api.RealCalendar.GetAsync(FantacalcioTime.ActualYear);
            var day = realCalendar?.LiveDay?.SerieADay ?? realCalendar?.LastDay?.SerieADay ?? 1;
            var actualTeam = await Api.DailyTeam.GetAsync(State.TeamDayKey(day));
            while (actualTeam == null)
            {
                day--;
                if (day == -1)
                    break;
                actualTeam = day > 0 ? await Api.DailyTeam.GetAsync(State.TeamDayKey(day)) : await Api.Team.GetAsync(State.TeamKey);
            }
            if (actualTeam != null)
                players = actualTeam.ActivePlayers;
        }
        await base.OnParametersSetAsync();
    }
    private Task ItemDropped(DraggableDroppedEventArgs<Player> dropItem)
    {
        // dropItem.Item.Position = dropItem.DropZoneName;
        return Task.CompletedTask;
    }
}

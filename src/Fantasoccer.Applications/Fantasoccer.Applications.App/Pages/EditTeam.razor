@page "/edit"
<div class="field">
    <Image class="backgroundField" Source="./static/field.jpg"></Image>
    @if (players != null)
    {
        <DropContainer TItem="Player" Items="@players" ItemsFilter="@Filter" ItemDropped="@ItemDropped" Class="playerContainer">
            <ChildContent>
                @{
                    var counter = 0;
                }
                @foreach (var position in FantaSoccerPosition.Default)
                {
                    <div class="@position.Css">
                        <DropZone Class="columnContainer" TItem="Player" Name="@position.Position.ToString()" DropAllowed="@position.Filter"></DropZone>
                    </div>
                    counter++;
                }
            </ChildContent>
            <ItemTemplate>
                <PlayerCard Player="context" Chancer="GetChance(context)" Voter="GetVote(context)" Game="GetRealGame(context)"></PlayerCard>
            </ItemTemplate>
        </DropContainer>
    }
</div>
@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    private IEnumerable<Player>? players;
    private RealDay? RealDay { get; set; }
    private ChancedRealPlayerWrapper? Chance { get; set; }
    private VotedRealPlayerWrapper? Live { get; set; }
    private VotedRealPlayerWrapper? Official { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            var realCalendar = await Api.RealCalendar.GetAsync(FantacalcioTime.ActualYear);
            var serieADay = realCalendar?.LiveDay?.SerieADay ?? realCalendar?.LastDay?.SerieADay ?? 1;
            RealDay = realCalendar?.Days.FirstOrDefault(x => x.SerieADay == serieADay);
            var yearDayKey = State.YearDayKey(serieADay);
            Chance = await Api.Chances.GetAsync(yearDayKey);
            Live = await Api.LiveVote.GetAsync(yearDayKey);
            Official = await Api.OfficialVote.GetAsync(yearDayKey);
            var actualTeam = await Api.DailyTeam.GetAsync(State.TeamDayKey(serieADay));
            while (actualTeam == null)
            {
                serieADay--;
                if (serieADay == -1)
                    break;
                actualTeam = serieADay > 0 ? await Api.DailyTeam.GetAsync(State.TeamDayKey(serieADay)) : await Api.Team.GetAsync(State.TeamKey);
            }
            if (actualTeam != null)
                players = actualTeam.ActivePlayers.OrderBy(x => x.Position);
        }
        await base.OnParametersSetAsync();
    }
    private ChancedRealPlayer? GetChance(Player player)
    {
        var chancedPlayer = Chance?.Players.FirstOrDefault(x => x.Key == player.Key);
        return chancedPlayer;
    }
    private VotedRealPlayer? GetVote(Player player)
    {
        var votePlayer = Official?.Players.FirstOrDefault(x => x.Key == player.Key);
        if (votePlayer == null)
            votePlayer = Live?.Players.FirstOrDefault(x => x.Key == player.Key);
        return votePlayer;
    }
    private RealGame? GetRealGame(Player player)
    {
        var game = RealDay?.Games.FirstOrDefault(x => x.Home == player.RealTeam || x.Away == player.RealTeam);
        return game;
    }
    private bool Filter(Player player, string zoneName)
    {
        var result = player.Position.ToString() == zoneName;
        return result;
    }
    private Task ItemDropped(DraggableDroppedEventArgs<Player> dropItem)
    {
        dropItem.Item.Position = (FantaSoccerRole)Enum.Parse(typeof(FantaSoccerRole), dropItem.DropZoneName);
        return Task.CompletedTask;
    }
}

@page "/live"
@using Blazorise.DataGrid
@using Blazorise.LoadingIndicator;

<PageTitle>Live</PageTitle>

@if (liveGroup != null && selectedTab != null && innerSelectedTab != null)
{
    <Tabs SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
        <Items>
            @foreach (var league in liveGroup.Leagues)
            {
                <Tab Name="@league.Id">@league.Name</Tab>
            }
        </Items>
        <Content>
            @foreach (var league in liveGroup.Leagues)
            {
                <TabPanel Name="@league.Id">
                    <Tabs SelectedTab="@innerSelectedTab[selectedTab]" SelectedTabChanged="@OnSelectedInnerTabChanged">
                        <Items>
                            @foreach (var calendarByRound in league.Rounds)
                            {
                                <Tab Name="@calendarByRound.Key">Round @calendarByRound.Key</Tab>
                            }
                        </Items>
                        <Content>
                            @foreach (var dayByRound in league.Rounds)
                            {
                                <TabPanel Name="@dayByRound.Key">
                                    <Row>
                                        <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile.Is12.OnTablet">
                                            <Card Margin="Margin.Is1">
                                                <CardBody>
                                                    <CardTitle Size="3">
                                                        Day @dayByRound.Value.Number (@dayByRound.Value.SerieADay)
                                                    </CardTitle>
                                                    <CardText>
                                                        <Table Striped>
                                                         <TableHeader>
                                                             <TableRow>
                                                                 <TableHeaderCell>Home Team</TableHeaderCell>
                                                                 <TableHeaderCell>Points</TableHeaderCell>
                                                                 <TableHeaderCell>Away Team</TableHeaderCell>
                                                             </TableRow>
                                                         </TableHeader>
                                                         <TableBody>
                                                             @foreach (var game in dayByRound.Value.Games)
                                                                {
                                                                    <TableRow Clicked="() => NavigateTo(game.Id)">
                                                                        <TableRowCell>@game.Home</TableRowCell>
                                                                        @if (game.Result != null && !game.Result.IsCancelled)
                                                                        {
                                                                            <TableRowCell>
                                                                                @game.Result.HomeGoal (@game.Result.Home.Value) - (@game.Result.Away.Value) @game.Result.AwayGoal
                                                                            </TableRowCell>
                                                                        }
                                                                        else if (game.Result != null && game.Result.IsCancelled)
                                                                        {
                                                                            <TableRowCell>
                                                                                cancelled
                                                                            </TableRowCell>
                                                                        }
                                                                        else
                                                                        {
                                                                            <TableRowCell>
                                                                                to play
                                                                            </TableRowCell>
                                                                        }
                                                                        <TableRowCell>@game.Away</TableRowCell>
                                                                    </TableRow>
                                                                }
                                                            </TableBody>
                                                        </Table>
                                                    </CardText>
                                                </CardBody>
                                            </Card>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile.Is12.OnTablet">
                                            <DataGrid TItem="RankedTeam" Margin="Margin.Is1"
                                                      Style="margin:0 !important; height:auto !important;max-height:1000px !important;"
                                                      Data="@league.Rank.RankedTeams[dayByRound.Key].OrderByDescending(x => x.Point)"
                                                            FixedHeader
                                                            Striped
                                                            Responsive>
                                             <DataGridCommandColumn />
                                             <DataGridColumn Field="@nameof(RankedTeam.Name)" Caption="#" Sortable=false />
                                             <DataGridColumn Field="@nameof(RankedTeam.Point)" Caption="P" Sortable />
                                                 <DataGridColumn Field="@nameof(RankedTeam.ValuePoint)" Caption="VP" Sortable />
                                                 <DataGridColumn Field="@nameof(RankedTeam.Victories)" Caption="V" Sortable />
                                                 <DataGridColumn Field="@nameof(RankedTeam.Draws)" Caption="D" Sortable />
                                                 <DataGridColumn Field="@nameof(RankedTeam.Defeats)" Caption="D" Sortable />
                                                 <DataGridColumn Field="@nameof(RankedTeam.Goal)" Caption="G" Sortable />
                                                 <DataGridColumn Field="@nameof(RankedTeam.SufferedGoal)" Caption="SG" Sortable />
                                             </DataGrid>
                                         </Column>
                                     </Row>
                                 </TabPanel>
                            }
                        </Content>
                    </Tabs>
                </TabPanel>
            }
        </Content>
    </Tabs>
}
@if (nullCalendar != null)
{
    <Alert Color="Color.Info" Visible=true>
        <Heading Size="HeadingSize.Is4" TextColor="TextColor.Success">
            Not found
            <CloseButton />
        </Heading>
        <Paragraph>
            @nullCalendar
        </Paragraph>
    </Alert>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    private LiveGroup? liveGroup;
    private string? selectedTab;
    private Dictionary<string, string>? innerSelectedTab;
    private string? nullCalendar;

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
    private Task OnSelectedInnerTabChanged(string name)
    {
        innerSelectedTab[selectedTab] = name;
        return Task.CompletedTask;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State?.HasAGroup == true)
        {
            LoadingIndicator?.Show();
            if (State.Year != FantacalcioTime.ActualYear)
                await State.ChangeYearAsync(FantacalcioTime.ActualYear);
            liveGroup = await Api.Live.GetAsync(State.GroupId!);
            if (liveGroup?.Leagues?.Count == 0)
                nullCalendar = $"Live non presente per l'anno {FantacalcioTime.LabelYear(State.Year)}.";
            else
            {
                if (State.LeagueId != null)
                    selectedTab = State.LeagueId;
                else
                    selectedTab = liveGroup.Leagues.First().Id;
                innerSelectedTab = new Dictionary<string, string>();
                foreach (var league in liveGroup.Leagues)
                {
                    innerSelectedTab.Add(league.Id, league.Rounds.First().Key);
                }
            }
        }
        await base.OnParametersSetAsync();
    }
    private void NavigateTo(string gameId)
    {
        NavigationManager.NavigateTo($"game/{gameId}", false);
    }
}
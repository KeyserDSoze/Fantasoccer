@page "/calendar"
@using Blazorise.DataGrid
@using Blazorise.LoadingIndicator;

<PageTitle>Calendar</PageTitle>

@if (calendar != null)
{
    <Tabs SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
        <Items>
            @foreach (var calendarByRound in calendar.Rounds)
            {
                <Tab Name="@calendarByRound.Key">Round @calendarByRound.Key</Tab>
            }
        </Items>
        <Content>
            @foreach (var calendarByRound in calendar.Rounds)
            {
                <TabPanel Name="@calendarByRound.Key">
                    <Row>
                        @foreach (var day in calendarByRound.Value)
                        {
                            <Column ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile.Is12.OnTablet">
                                <Card Margin="Margin.Is1">
                                    <CardBody>
                                        <CardTitle Size="3">
                                            Day @day.Number (@day.SerieADay)
                                        </CardTitle>
                                        <CardText>
                                            <Table Striped>
                                             <TableHeader>
                                                 <TableRow>
                                                     <TableHeaderCell>Home Team</TableHeaderCell>
                                                     <TableHeaderCell>Points</TableHeaderCell>
                                                     <TableHeaderCell>Away Team</TableHeaderCell>
                                                 </TableRow>
                                             </TableHeader>
                                             <TableBody>
                                                 @foreach (var game in day.Games)
                                                    {
                                                        <TableRow Clicked="() => NavigateTo(game.Id)">
                                                            <TableRowCell>@game.Home</TableRowCell>
                                                            @if (game.Result != null && !game.Result.IsCancelled)
                                                            {
                                                                <TableRowCell>
                                                                    @game.Result.HomeGoal (@game.Result.Home.Value) - (@game.Result.Away.Value) @game.Result.AwayGoal
                                                                </TableRowCell>
                                                            }
                                                            else if (game.Result != null && game.Result.IsCancelled)
                                                            {
                                                                <TableRowCell>
                                                                    cancelled
                                                                </TableRowCell>
                                                            }
                                                            else
                                                            {
                                                                <TableRowCell>
                                                                    to play
                                                                </TableRowCell>
                                                            }
                                                            <TableRowCell>@game.Away</TableRowCell>
                                                        </TableRow>
                                                    }
                                                </TableBody>
                                            </Table>
                                        </CardText>
                                    </CardBody>
                                </Card>
                            </Column>
                        }
                    </Row>
                </TabPanel>
            }
        </Content>
    </Tabs>
}
else if (nullCalendar != null)
{
    <Alert Color="Color.Info" Visible=true>
        <Heading Size="HeadingSize.Is4" TextColor="TextColor.Success">
            Not found
            <CloseButton />
        </Heading>
        <Paragraph>
            @nullCalendar
        </Paragraph>
    </Alert>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    private Calendar? calendar;
    private RankedTeam? selectedTeam;
    private string? selectedTab;
    private string? nullCalendar;

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            if (calendar != null && calendar.Rounds.Count > 0)
                selectedTab = calendar.Rounds.First().Key;
            else
                nullCalendar = $"Calendario non presente per l'anno {FantacalcioTime.LabelYear(State.Year)}.";
            LoadingIndicator?.Hide();
        }
        await base.OnParametersSetAsync();
    }
    private void NavigateTo(string gameId)
    {
        NavigationManager.NavigateTo($"game/{gameId}", false);
    }
}
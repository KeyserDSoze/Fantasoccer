@page "/users"
@using Blazorise.LoadingIndicator;
@using System.Text.Json;

<PageTitle>Users</PageTitle>

@if (canSee && users != null)
{
    <Table Striped>
     <TableHeader>
         <TableRow>
             <TableHeaderCell>Email</TableHeaderCell>
             <TableHeaderCell>Username</TableHeaderCell>
             <TableHeaderCell>Group0</TableHeaderCell>
             <TableHeaderCell>Group1</TableHeaderCell>
             <TableHeaderCell>RemainedGroups</TableHeaderCell>
         </TableRow>
     </TableHeader>
     <TableBody>
         @foreach (var user in users)
            {
                <TableRow>
                    <TableRowHeader>@user.Email</TableRowHeader>
                    <TableRowCell>@user.Username</TableRowCell>
                    <TableRowCell>@user.Groups.FirstOrDefault()?.ToJson()</TableRowCell>
                    <TableRowCell>@user.Groups.Skip(1).FirstOrDefault()?.ToJson()</TableRowCell>
                    <TableRowCell>@user.Groups.Skip(2).ToJson()</TableRowCell>
                </TableRow>
            }
        </TableBody>
    </Table>
}

@code {
    [CascadingParameter]
    private AppIdentity? Identity { get; set; }
    private IEnumerable<AppIdentity>? users;
    private bool canSee;
    protected override async Task OnParametersSetAsync()
    {
        if (Identity != null)
        {
            canSee = Identity.Email == "alessandro.rapiti44@gmail.com";
            users = await Api.AppIdentity.ToListAsEntityAsync();
            await base.OnParametersSetAsync();
        }
    }
}
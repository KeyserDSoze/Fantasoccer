@page "/game/{gameId?}"
@using System.Text.RegularExpressions;
@using Blazorise.LoadingIndicator;
@using Fantasoccer.Business;

@if (!isMobile)
{
    <div class="field">
        @if (Game != null)
        {
            <ResultCard Css="gameResult animOpacity" Game="Game"></ResultCard>
        }
        @if (Teams != null)
        {

            <Image class="backgroundField" Source="./static/field.jpg"></Image>
            foreach (var team in Teams)
            {
                if (team.CanModify)
                {
                    <DesktopEditableTeam Inverted="team.Inverted" Players="team.Players" SaveTeam="SaveAsync"></DesktopEditableTeam>
                }
                else
                {
                    <DesktopGame Inverted="team.Inverted" Players="team.Players"></DesktopGame>
                }
            }
        }
    </div>
}
else
{
    <div class="fieldMobile">
        @if (Game != null)
        {
            <ResultCard Css="gameResultMobile animOpacity" Game="Game"></ResultCard>
        }
        @if (Teams != null)
        {
            <div class="gameContainerMobile">
                @foreach (var team in Teams)
                {
                    if (team.CanModify)
                    {
                        <MobileEditableTeam SaveTeam="SaveAsync" Players="team.Players" Css="playerContainerMobile" From="FantaSoccerRole.GoalKeeper" To="FantaSoccerRole.Forward" Inverted="team.Inverted"></MobileEditableTeam>
                    }
                    else
                    {
                        <MobileGame Css="playerContainerMobile" Players="team.Players" From="FantaSoccerRole.GoalKeeper" To="FantaSoccerRole.Forward" Inverted="team.Inverted"></MobileGame>
                    }
                }
            </div>
            var counter = 0;
            @foreach (var team in Teams)
            {
                if (team.CanModify)
                {
                    <MobileEditableTeam SaveTeam="SaveAsync" Players="team.Players" Css="@($"playerContainerMobile50-{counter}")" From="FantaSoccerRole.BackupGoalKeeper" To="FantaSoccerRole.SecondBackupForward" Inverted="team.Inverted"></MobileEditableTeam>
                }
                else
                {
                    <MobileGame Css="@($"playerContainerMobile50-{counter}")" Players="team.Players" From="FantaSoccerRole.BackupGoalKeeper" To="FantaSoccerRole.SecondBackupForward" Inverted="team.Inverted"></MobileGame>
                }
                counter++;
            }
            @foreach (var team in Teams)
            {
                if (team.CanModify)
                {
                    <MobileEditableTeam SaveTeam="SaveAsync" Players="team.Players" Css="playerContainerMobileTribune" From="FantaSoccerRole.Tribune" To="FantaSoccerRole.Tribune" Inverted="team.Inverted" State="State" Team="team.Team" SerieADay="serieADay"></MobileEditableTeam>
                }
            }
        }
    </div>
}
<Snackbar @ref="snackbar" Location="SnackbarLocation.BottomEnd">
    <SnackbarBody>
        @message
    </SnackbarBody>
</Snackbar>

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private CalendarGame? Game { get; set; }
    private List<TeamsWrapper>? Teams { get; set; }
    [Parameter]
    public string? GameId { get; set; }
    [Inject]
    public required IJSRuntime JsRuntime { get; set; }
    [Inject]
    public required ITeamCalculator TeamCalculator { get; set; }
    private int serieADay;
    private bool isInEdit => GameId == null;
    private Team? myTeam;

    private sealed class TeamsWrapper
    {
        public required IEnumerable<EnrichedPlayer> Players { get; set; }
        public bool CanModify { get; set; }
        public required bool Inverted { get; set; }
    }
    private static readonly Regex TestMobile = new Regex("android|webos|iphone|ipad|ipod|blackberry|iemobile|opera mini|mobile");
    private bool isMobile;
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var userAgent = await JsRuntime.InvokeAsync<string>("getUseragent");
            isMobile = TestMobile.IsMatch(userAgent?.ToLower() ?? string.Empty);
            var calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            serieADay = 0;
            if (GameId != null && calendar != null)
            {
                Check();

                void Check()
                {
                    foreach (var round in calendar.Rounds)
                    {
                        foreach (var day in round.Value)
                        {
                            foreach (var game in day.Games)
                            {
                                if (game.Id == GameId)
                                {
                                    Game = game;
                                    serieADay = day.SerieADay;
                                    return;
                                }
                            }
                        }
                    }
                }
            }
            await TeamCalculator.BuildRequestAsync(State.Year, serieADay, State.LeagueSettings, true, !isInEdit, true);

            if (Game == null && calendar != null)
            {
                myTeam = await GetTeamAsync(Api, State, serieADay, null);
                if (myTeam != null)
                    Game = calendar.Rounds.SelectMany(x => x.Value).Where(x => x.SerieADay == serieADay).SelectMany(x => x.Games).FirstOrDefault(x => x.Home == myTeam.Name || x.Away == myTeam.Name);
            }
            if (Game != null)
            {
                var teams = new List<TeamsWrapper>();
                var counter = 0;
                foreach (var owner in GetOwners())
                {
                    var isMyTeam = myTeam != null && myTeam.Owner == owner;
                    var team = isMyTeam ? myTeam
                         : await Api.DailyTeam.GetAsync(State.TeamDayKey(serieADay, owner));
                    teams.Add(new TeamsWrapper
                        {
                            CanModify = isMyTeam && isInEdit,
                            Inverted = counter == 1,
                            Players = team != null ? TeamCalculator.Enrich(team.ActivePlayers) : Array.Empty<EnrichedPlayer>()
                        });
                    counter++;
                }
                if (!isInEdit && Game.Result == null)
                {
                    Game.Result = new()
                        {
                            Home = TeamCalculator.CalculatePoint(teams[0].Players),
                            Away = TeamCalculator.CalculatePoint(teams[1].Players)
                        };
                    if (TeamCalculator.LeagueSetting != null)
                        Game.Result.CalculateGoals(TeamCalculator.LeagueSetting);
                }
                Teams = teams;
                IEnumerable<string> GetOwners()
                {
                    yield return Game.HomeOwner;
                    yield return Game.AwayOwner;
                }
            }
            LoadingIndicator?.Hide();
        }
        await base.OnParametersSetAsync();
    }
    private static async Task<Team?> GetTeamAsync(ApiService api, FantasoccerState state, int serieADay, string? email)
    {
        var actualTeam = await api.DailyTeam.GetAsync(state.TeamDayKey(serieADay, email));
        var dayForSearch = serieADay;
        while (actualTeam == null)
        {
            dayForSearch--;
            if (dayForSearch == -1)
                break;
            actualTeam = dayForSearch > 0 ?
                await api.DailyTeam.GetAsync(state.TeamDayKey(dayForSearch, email)) :
                await api.Team.GetAsync(email == null ? state.TeamKey : state.OtherTeamKey(email));
        }
        return actualTeam;
    }
    private Snackbar? snackbar;
    private string? message;
    public async ValueTask SaveAsync()
    {
        if (State != null && TeamCalculator?.IsEditable == true && myTeam != null)
        {
            var key = State.TeamDayKey(TeamCalculator.SerieADay);
            var state = await Api.DailyTeam.ExistAsync(key) ?
                await Api.DailyTeam.UpdateAsync(key, myTeam) :
                await Api.DailyTeam.InsertAsync(key, myTeam);
            if (snackbar != null)
            {
                snackbar.Color = state.IsOk ? SnackbarColor.Success : SnackbarColor.Danger;
                message = state.Message ?? (state.IsOk ? "Formazione salvata correttamente." : "Errore durante il savaltaggio della formazione.");
                snackbar.Show();
            }
            if (state.IsOk)
            {
                StateHasChanged();
            }
        }
        else
        {
            snackbar.Color = SnackbarColor.Danger;
            message = "Errore nell'insieme dei numeri immaginari.";
            snackbar.Show();
        }
    }
}

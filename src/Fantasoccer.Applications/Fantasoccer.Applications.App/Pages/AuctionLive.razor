@page "/auctionlive"
@using Blazorise.DataGrid
@using Blazorise.LoadingIndicator;
@using Fantasoccer.Applications.App.ClientServices

<PageTitle>Auction Live</PageTitle>

<CardDeck>
    @foreach (var team in teams.OrderByDescending(x => State.SelectedLeagueSettings!.StartingMoney - x.Cost))
    {
        <Card>
            <CardBody>
                <CardTitle Size="5">@team.Name</CardTitle>
                <CardText>
                    @team.Owner
                </CardText>
                <CardText>
                    <Label>Rimangono: </Label>
                    @(State.SelectedLeagueSettings!.StartingMoney - team.Cost)
                </CardText>
                <CardText>
                    Portieri: @team.ActivePlayers.Count(x => x.Role == Role.GoalKeeper)
                </CardText>
                <CardText>
                    Difensori: @team.ActivePlayers.Count(x => x.Role == Role.Defensor)
                </CardText>
                <CardText>
                    Centrocapisti: @team.ActivePlayers.Count(x => x.Role == Role.Midfielder)
                </CardText>
                <CardText>
                    Attaccanti: @team.ActivePlayers.Count(x => x.Role == Role.Forward)
                </CardText>
            </CardBody>
        </Card>
        @* if (anchorTeam != null)
        {
            <Card>
                <CardBody>
                    <CardTitle Size="5">@team.Name</CardTitle>
                    <CardText>
                        @anchorTeam.Owner vs @team.Owner
                    </CardText>
                    <CardText>
                        @((State.SelectedLeagueSettings!.StartingMoney - anchorTeam.Cost) - (State.SelectedLeagueSettings!.StartingMoney - team.Cost))
                    </CardText>
                </CardBody>
            </Card>
        } *@
    }
</CardDeck>
@* <Button Clicked="SendAsync">Send something</Button> *@
@*to refresh <script src="~/Scripts/scripts.js"></script> *@

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    // [Inject]
    // public AuctionHubClient AuctionHubClient { get; set; }
    private List<Team>? teams;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State?.HasAGroup == true && State.Teams != null)
        {
            LoadingIndicator?.Show();
            // await AuctionHubClient.StartAsync(OnReceive);
            teams = new();
            foreach (var team in State.Teams)
            {
                var teamKey = State.OtherTeamKey(team.Owner);
                var actualTeam = await Api.Team.GetAsync(teamKey);
                if (actualTeam == null)
                {
                    actualTeam = new() { Name = team.Name, Owner = team.Owner, Players = new() };
                    await Api.Team.InsertAsync(teamKey, actualTeam);
                }
                teams.Add(actualTeam);
                var rank = await Api.Ranks.GetAsync(State.LeagueKey);
                actualTeam.MoneyFromRank = rank.RankedTeams.SelectMany(x => x.Value).First(x => x.Owner == team.Owner).PlusMoney;
            }
        }
        await base.OnParametersSetAsync();
    }
    // void OnReceive(string user, string message)
    // {
    //     var x = user;
    //     var y = message;
    // }

    // async Task SendAsync()
    // {
    //     await AuctionHubClient.SendAsync(State.Identity.Email, "Hello from Blazor!");
    // }
}
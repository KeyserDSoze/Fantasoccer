@page "/settings"
@using Blazorise.LoadingIndicator;

<PageTitle>Settings</PageTitle>

@if (State?.IsAuthenticated == true)
{
    <Row>
        <Column>
            <Fields>
                <Validations @ref="@ValidationsRef" Mode="ValidationMode.Auto" Model="State.Identity" ValidateOnLoad="false">
                    <Validation UsePattern>
                     <Field ColumnSize="ColumnSize.IsHalf">
                         <FieldLabel>Username</FieldLabel>
                         <FieldBody>
                             <TextEdit @bind-Text="@State.Identity!.Username" Pattern="[A-Za-z0-9. _-]{3,20}">
                                 <Feedback>
                                     <ValidationError />
                                 </Feedback>
                             </TextEdit>
                         </FieldBody>
                     </Field>
                 </Validation>
             </Validations>
             @if (State?.SelectedGroup != null)
                {
                    @foreach (var team in State.YourTeams)
                    {
                        <Field ColumnSize="ColumnSize.IsHalf">
                            <FieldLabel>Team Name</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="@team.Name">
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    }
                }
            </Fields>
            <Button Color="Color.Primary" Clicked="@OnSaveClicked">
                Salva impostazioni
            </Button>
        </Column>
    </Row>
}

@code {
    [Inject]
    private IMessageService? MessageService { get; set; }
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private Validations? ValidationsRef { get; set; }

    async Task OnSaveClicked()
    {
        if (ValidationsRef != null)
        {
            if (await ValidationsRef.ValidateAll())
            {
                if (State?.IsAuthenticated == true)
                {
                    if (await Api.Groups.UpdateAsync(State.GroupId, State.SelectedGroup))
                    {
                        foreach (var team in State!.MyTeams)
                        {
                            var key = State.OtherTeamKey(team.Owner);
                            var actualTeam = await Api.Team.GetAsync(key);
                            if (actualTeam == null)
                            {
                                actualTeam = new Team
                                    {
                                        Name = team.Name,
                                        Owner = team.Owner,
                                        Players = new()
                                    };
                                await Api.Team.InsertAsync(State.TeamKey, actualTeam);
                            }
                            else
                            {
                                actualTeam.Name = team.Name;
                                await Api.Team.UpdateAsync(State.TeamKey, actualTeam);
                            }
                        }
                        State.UpdateUi();
                    }
                }
            }
            await ValidationsRef.ClearAll();
        }
    }
}
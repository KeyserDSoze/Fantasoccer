@page "/settings"
@using Blazorise.LoadingIndicator;

<PageTitle>Settings</PageTitle>

@if (State?.IsAuthenticated == true)
{
    <Row>
        <Column>
            <Fields>
                <Validations @ref="@ValidationsRef" Mode="ValidationMode.Auto" Model="State.Identity" ValidateOnLoad="false">
                    <Validation UsePattern>
                     <Field ColumnSize="ColumnSize.IsHalf">
                         <FieldLabel>Username</FieldLabel>
                         <FieldBody>
                             <TextEdit @bind-Text="@State.Identity.Username" Pattern="[A-Za-z0-9. _-]{3,20}">
                                 <Feedback>
                                     <ValidationError />
                                 </Feedback>
                             </TextEdit>
                         </FieldBody>
                     </Field>
                 </Validation>
             </Validations>
             @if (actualGroup != null)
                {
                    <Validations @ref="@ValidationsRef" Mode="ValidationMode.Auto" Model="actualGroup" ValidateOnLoad="false">
                        <Validation>
                            <Field ColumnSize="ColumnSize.IsHalf">
                                <FieldLabel>Team Name</FieldLabel>
                                <FieldBody>
                                    <TextEdit @bind-Text="@actualGroup.TeamName">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                    </Validations>
                }
            </Fields>
            <Button Color="Color.Primary" Clicked="@OnSaveClicked">
                Salva impostazioni
            </Button>
        </Column>
    </Row>
}

@code {
    [Inject]
    private IMessageService? MessageService { get; set; }
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private GroupForIdentity? actualGroup;
    private Validations? ValidationsRef { get; set; }

    protected override Task OnParametersSetAsync()
    {
        if (State?.IsAuthenticated == true)
        {
            LoadingIndicator?.Show();
            actualGroup = State.Identity!.Groups.FirstOrDefault(x => x.Id == State.GroupId);
            LoadingIndicator?.Hide();
        }
        return base.OnParametersSetAsync();
    }
    async Task OnSaveClicked()
    {
        if (ValidationsRef != null)
            if (await ValidationsRef.ValidateAll())
            {
                if (MessageService != null)
                    await MessageService.Info("Salvato tutto correttamente.");
                if (State?.IsAuthenticated == true)
                {
                    if (await Api.AppIdentity.UpdateAsync(State.Identity!.Email, State.Identity))
                    {
                        if (actualGroup != null && !string.IsNullOrWhiteSpace(actualGroup.TeamName))
                        {
                            var theGroup = await Api.Groups.GetAsync(actualGroup.Id);
                            if (theGroup != null)
                            {
                                foreach (var team in theGroup.Leagues
                                        .SelectMany(x => x.Years)
                                        .Where(x => x.Year == FantacalcioTime.ActualYear)
                                        .SelectMany(x => x.Teams)
                                        .Where(x => x.Owner == State.Identity.Email))
                                {
                                    team.Name = actualGroup.TeamName;
                                }
                            }
                            var teamForGroup = await Api.Team.GetAsync(State.TeamKey);
                            if (teamForGroup == null)
                            {
                                teamForGroup = new Team { Name = actualGroup.TeamName, Owner = State.Identity.Email, Players = new() };
                                await Api.Team.InsertAsync(State.TeamKey, teamForGroup);
                            }
                            else
                            {
                                teamForGroup.Name = actualGroup.TeamName;
                                await Api.Team.UpdateAsync(State.TeamKey, teamForGroup);
                            }
                        }
                        State.UpdateUi();
                    }
                }
                await ValidationsRef.ClearAll();
            }
    }
}
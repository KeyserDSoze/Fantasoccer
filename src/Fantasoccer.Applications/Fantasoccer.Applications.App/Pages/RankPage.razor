@page "/rank"

<PageTitle>Rank</PageTitle>

@if (rank != null)
{
    <FluentTab @bind-ActiveTabId="@selectedTab">
        @* <Items>
    @foreach (var rankByRound in rank.RankedTeams)
    {
    <Tab Name="@rankByRound.Key" Display="rank.RankedTeams.Count > 1 ? Display.Block: Display.None">Round @rankByRound.Key</Tab>
    }
    </Items> *@
        @foreach (var rankByRound in rank.RankedTeams)
        {
            <FluentTab Label="@rankByRound.Key" Id="@rankByRound.Key">
                <Ranking Teams="rankByRound.Value"></Ranking>
            </FluentTab>
        }
    </FluentTab>
}
@if (isVisible)
{
    <h4>Not Found</h4>
    <p>@nullRank</p>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private Rank? rank;
    private RankedTeam? selectedTeam;
    private string? selectedTab;
    private string? nullRank;
    private bool isVisible => nullRank != null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        nullRank = null;
        if (State?.HasAGroup == true)
        {
            LoadingIndicator?.Show();
            rank = await Api.Ranks.GetAsync(State.LeagueKey);
            if (rank != null && rank.RankedTeams.Count > 0)
                selectedTab = rank.RankedTeams.First().Key;
            else
                nullRank = $"Classifica non presente per l'anno {FantacalcioTime.LabelYear(State.Year)}.";
        }
        await base.OnParametersSetAsync();
    }
}
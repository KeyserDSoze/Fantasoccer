@page "/allteams"
@using Blazorise.DataGrid
@using Blazorise.LoadingIndicator;
@using Fantasoccer.Domain;
@using System.Text.Json;

<PageTitle>All teams</PageTitle>

@if (players != null && teams != null && State != null)
{
    foreach (var team in teams)
    {
        <h4>@team.Name (@team.Owner) @(State.LeagueSettings!.StartingMoney - team.Cost) [@team.ActivePlayers.Count(x => x.Role == Role.GoalKeeper)-@team.ActivePlayers.Count(x => x.Role == Role.Defensor)-@team.ActivePlayers.Count(x => x.Role == Role.Midfielder)-@team.ActivePlayers.Count(x => x.Role == Role.Forward)]</h4>
        <DataGrid TItem="StatPlayerWithPrice"
                  Data="@team.Players.Select(x => ToStatPlayer(x))"
                Filterable
                   FilterMode="DataGridFilterMode.Menu"
                Striped
                Resizable
                   ResizeMode="TableResizeMode.Header"
                ShowPager
                ShowPageSizes
                   PagerPosition="DataGridPagerPosition.TopAndBottom"
                   PageSize="10"
                   PagerOptions="new(){ ButtonSize=Size.Small }"
                Responsive>
         <DataGridColumn Field="@nameof(StatPlayer.Name)" Caption="Name" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayerWithPrice.Price)" Caption="Price" Sortable Filterable />
             <DataGridColumn Field="RealTeam.Name" Caption="Team" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.Average)" DisplayFormat="{0:N2}" Caption="Average" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.FantaAverage)" DisplayFormat="{0:N2}" Caption="FantaAverage" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.IsEnough)" Caption="Enough Count" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.WithVote)" Caption="With Vote" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.WithoutVote)" Caption="Without Vote" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.WithSpecial)" Caption="Special" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.YellowCard)" Caption="YC Count" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.RedCard)" Caption="RC Count" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.Goal)" Caption="Goal" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.Assist)" Caption="Assist" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.Penalty)" Caption="Penalty" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.StoppedPenalty)" Caption="StoppedPenalty" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.SufferedGoal)" Caption="SufferedGoal" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.WrongedPenalty)" Caption="WrongedPenalty" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.OwnGoal)" Caption="OwnGoal" Sortable Filterable />
             <DataGridColumn Field="@nameof(StatPlayer.IsActive)" Caption="Is Active" Sortable Filterable />
         </DataGrid>
    }
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private List<Team>? teams;
    private List<StatPlayer>? players;
    protected override async Task OnParametersSetAsync()
    {
        if (State?.AnnualLeague != null)
        {
            LoadingIndicator?.Show();
            var playersWrapper = await Api.StatsPlayers.GetAsync(State.Year);
            teams = new();
            var teamsInThisLeagueAndYear = State.Teams;
            if (playersWrapper != null && teamsInThisLeagueAndYear != null)
            {
                players = playersWrapper.Players;
                foreach (var team in teamsInThisLeagueAndYear)
                {
                    var actualTeam = await Api.Team.GetAsync(State.OtherTeamKey(team.Owner));
                    if (actualTeam != null)
                        teams.Add(actualTeam);
                }
            }
            LoadingIndicator?.Hide();
        }
        await base.OnParametersSetAsync();
    }
    private StatPlayerWithPrice? ToStatPlayer(Player player)
    {
        if (players != null)
        {
            var playerKey = player.Key;
            var statPlayer = players.FirstOrDefault(x => x.Key == playerKey);
            if (statPlayer != null)
            {
                var playerWithPrice = statPlayer.ToJson().FromJson<StatPlayerWithPrice>();
                playerWithPrice.Price = player.Price;
                return playerWithPrice;
            }
        }
        return null;
    }
    private sealed class StatPlayerWithPrice : StatPlayer
    {
        public int Price { get; set; }
    }
}
@page "/allteams"
@using Fantasoccer.Domain;
@using System.Text.Json;

<PageTitle>All teams</PageTitle>

@if (players != null && teams != null && State != null)
{
    foreach (var team in teams)
    {
        <h4>@team.Name (@team.Owner) @(State.SelectedLeagueSettings!.StartingMoney - team.Cost) [@team.ActivePlayers.Count(x => x.Role == Role.GoalKeeper)-@team.ActivePlayers.Count(x => x.Role == Role.Defensor)-@team.ActivePlayers.Count(x => x.Role == Role.Midfielder)-@team.ActivePlayers.Count(x => x.Role == Role.Forward)]</h4>
        <FluentDataGrid Items="@team.Players.Select(x => ToStatPlayer(x)).AsQueryable()">
            <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Price)" Sortable="true" />
            <PropertyColumn Property="@(p => p.RealTeam.Name)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Average)" Sortable="true" />
            <PropertyColumn Property="@(p => p.FantaAverage)" Sortable="true" />
            <PropertyColumn Property="@(p => p.IsEnough)" Sortable="true" />
            <PropertyColumn Property="@(p => p.WithVote)" Sortable="true" />
            <PropertyColumn Property="@(p => p.WithoutVote)" Sortable="true" />
            <PropertyColumn Property="@(p => p.WithSpecial)" Sortable="true" />
            <PropertyColumn Property="@(p => p.YellowCard)" Sortable="true" />
            <PropertyColumn Property="@(p => p.RedCard)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Goal)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Assist)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Penalty)" Sortable="true" />
            <PropertyColumn Property="@(p => p.StoppedPenalty)" Sortable="true" />
            <PropertyColumn Property="@(p => p.SufferedGoal)" Sortable="true" />
            <PropertyColumn Property="@(p => p.WrongedPenalty)" Sortable="true" />
            <PropertyColumn Property="@(p => p.OwnGoal)" Sortable="true" />
            <PropertyColumn Property="@(p => p.IsActive)" Sortable="true" />
        </FluentDataGrid>
    }
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private List<Team>? teams;
    private List<StatPlayer>? players;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State?.SelectedYearlyLeague != null)
        {
            LoadingIndicator?.Show();
            var playersWrapper = await Api.StatsPlayers.GetAsync(State.Year);
            teams = new();
            var teamsInThisLeagueAndYear = State.Teams;
            if (playersWrapper != null && teamsInThisLeagueAndYear != null)
            {
                players = playersWrapper.Players;
                foreach (var team in teamsInThisLeagueAndYear)
                {
                    var actualTeam = await Api.Team.GetAsync(State.OtherTeamKey(team.Owner));
                    if (actualTeam != null)
                        teams.Add(actualTeam);
                }
            }
        }
        await base.OnParametersSetAsync();
    }
    private StatPlayerWithPrice? ToStatPlayer(Player player)
    {
        if (players != null)
        {
            var playerKey = player.Key;
            var statPlayer = players.FirstOrDefault(x => x.Key == playerKey);
            if (statPlayer != null)
            {
                var playerWithPrice = statPlayer.ToJson().FromJson<StatPlayerWithPrice>();
                playerWithPrice.Price = player.Price;
                return playerWithPrice;
            }
        }
        return null;
    }
    private sealed class StatPlayerWithPrice : StatPlayer
    {
        public int Price { get; set; }
    }
}
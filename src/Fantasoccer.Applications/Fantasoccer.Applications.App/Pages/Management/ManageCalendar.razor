@page "/managecalendar"
@using Fantasoccer.Business
@using Fantasoccer.Domain;

<PageTitle>Real Calendar</PageTitle>

@if (realCalendar != null)
{
    <FluentGrid AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
        @foreach (var day in realCalendar.Days)
        {
            <FluentGridItem xs="6" sm="12">
                <FluentCard>
                    <h3>Giornata @day.SerieADay</h3>
                    <FluentButton Appearance="Appearance.Accent" OnClick="() => RecalculateVote(day.SerieADay)">Ricalcola voti</FluentButton>
                    <FluentDataGrid TGridItem="RealGame" Items="day.Games.AsQueryable()">
                        <PropertyColumn Property="@(p => p.Home.Name)" Sortable="true" Title="Casa" />
                        <PropertyColumn Property="@(p => CalculateResult(p))" Sortable="true" Title="Risultato" />
                        <PropertyColumn Property="@(p => p.Away.Name)" Sortable="true" Title="Trasferta" />
                        <TemplateColumn>
                            <FluentButton Appearance="Appearance.Accent" OnClick="() => ChangeInDelayed(day.SerieADay, context)">Segna come rinviata</FluentButton>
                        </TemplateColumn>
                    </FluentDataGrid>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
    <FluentButton Appearance="Appearance.Accent" OnClick="@SaveAsync">Salva</FluentButton>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
    [Inject]
    public required ITeamCalculator TeamCalculator { get; set; }
    private List<int> recalculateForDelayed = new();
    private RealCalendar? realCalendar;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            realCalendar = await Api.RealCalendar.GetAsync(State.Year);
        }
        await base.OnParametersSetAsync();
    }
    private void ChangeInDelayed(int serieADay, RealGame realGame)
    {
        realGame.Delayed = true;
        realGame.HomeGoal = null;
        realGame.AwayGoal = null;
        recalculateForDelayed.Add(serieADay);
    }
    private async Task SaveAsync()
    {
        LoadingIndicator?.Show();
        if (realCalendar != null)
        {
            await Api.RealCalendar.UpdateAsync(State.Year, realCalendar);
        }
        LoadingIndicator?.Hide();
    }
    private async Task RecalculateVote(int serieADay)
    {
        LoadingIndicator?.Show();
        await TeamCalculator.RecalculateDayAsync(serieADay);
        LoadingIndicator?.Hide();
    }
    private string CalculateResult(RealGame game)
    {
        if (game.IsPlayed)
        {
            return $"{game.HomeGoal} - {game.AwayGoal}";
        }
        else if (game.Delayed)
        {
            return "Rinviata";
        }
        else
        {
            return game.Date?.ToString("yyyy-MM-dd HH:mm") ?? "da giocare";
        }
    }
}
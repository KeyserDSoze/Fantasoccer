@if (Team != null)
{
    <div class="playerContainer">
        @foreach (var position in !Inverted ? FantaSoccerPosition.Default : FantaSoccerPosition.Inverted)
        {
            if (position.Position != FantaSoccerRole.Tribune)
            {
                <div class="@position.Css">
                    <div Class="@position.ColumnContainer columnContainerInvisibleBackground">
                        @foreach (var player in Team.ActivePlayers.Where(x => x.Position == position.Position))
                        {
                            <PlayerCard Player="player" Chancer="GetChance(player)" Voter="GetVote(player)" Game="GetRealGame(player)"></PlayerCard>
                        }
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public Team? Team { get; set; }
    [Parameter]
    public required FantasoccerState State { get; set; }
    [Parameter]
    public required RealCalendar RealCalendar { get; set; }
    [Parameter]
    public required int SerieADay { get; set; }
    [Parameter]
    public required RealDay? RealDay { get; set; }
    [Parameter]
    public required ChancedRealPlayerWrapper? Chance { get; set; }
    [Parameter]
    public required VotedRealPlayerWrapper? Live { get; set; }
    [Parameter]
    public required VotedRealPlayerWrapper? Official { get; set; }
    [Parameter]
    public required Func<Player, ChancedRealPlayer?> GetChance { get; set; }
    [Parameter]
    public required Func<Player, VotedRealPlayer?> GetVote { get; set; }
    [Parameter]
    public required Func<Player, RealGame?> GetRealGame { get; set; }
    [Parameter]
    public required bool Inverted { get; set; }
    private Snackbar? snackbar;
    private string? message;
}

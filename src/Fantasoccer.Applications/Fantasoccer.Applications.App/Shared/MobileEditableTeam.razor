@if (Team != null)
{
    <div class="@Css">
        @foreach (var position in !Inverted ? FantaSoccerPosition.Default : FantaSoccerPosition.Inverted)
        {
            if (position.Position >= From && position.Position <= To)
            {
                <div class="playerMobile">
                    @foreach (var player in Team.ActivePlayers.Where(x => x.Position == position.Position).OrderBy(x => x.Role))
                    {
                        <PlayerCard Click="() => _ = Save(player)" Player="player" Chancer="GetChance(player)" Voter="GetVote(player)" Game="GetRealGame(player)"></PlayerCard>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public required Team Team { get; set; }
    [Parameter]
    public required FantasoccerState State { get; set; }
    [Parameter]
    public required RealCalendar RealCalendar { get; set; }
    [Parameter]
    public required int SerieADay { get; set; }
    [Parameter]
    public required RealDay? RealDay { get; set; }
    [Parameter]
    public required ChancedRealPlayerWrapper? Chance { get; set; }
    [Parameter]
    public required VotedRealPlayerWrapper? Live { get; set; }
    [Parameter]
    public required VotedRealPlayerWrapper? Official { get; set; }
    [Parameter]
    public required Func<Player, ChancedRealPlayer?> GetChance { get; set; }
    [Parameter]
    public required Func<Player, VotedRealPlayer?> GetVote { get; set; }
    [Parameter]
    public required Func<Player, RealGame?> GetRealGame { get; set; }
    [Parameter]
    public required bool Inverted { get; set; }
    [Parameter]
    public FantaSoccerRole From { get; set; }
    [Parameter]
    public FantaSoccerRole To { get; set; }
    [Parameter]
    public required string Css { get; set; }
    [Parameter]
    public Action? OnSave { get; set; }

    private async Task Save(Player movedPlayer)
    {
        switch (movedPlayer.Position)
        {
            case FantaSoccerRole.GoalKeeper:
                movedPlayer.Position = FantaSoccerRole.BackupGoalKeeper;
                break;
            case FantaSoccerRole.BackupGoalKeeper:
                movedPlayer.Position = FantaSoccerRole.Tribune;
                break;
            case FantaSoccerRole.Defensor:
                movedPlayer.Position = FantaSoccerRole.FirstBackupDefensor;
                break;
            case FantaSoccerRole.FirstBackupDefensor:
                movedPlayer.Position = FantaSoccerRole.SecondBackupDefensor;
                break;
            case FantaSoccerRole.SecondBackupDefensor:
                movedPlayer.Position = FantaSoccerRole.Tribune;
                break;
            case FantaSoccerRole.Midfielder:
                movedPlayer.Position = FantaSoccerRole.FirstBackupMidfielder;
                break;
            case FantaSoccerRole.FirstBackupMidfielder:
                movedPlayer.Position = FantaSoccerRole.SecondBackupMidfielder;
                break;
            case FantaSoccerRole.SecondBackupMidfielder:
                movedPlayer.Position = FantaSoccerRole.Tribune;
                break;
            case FantaSoccerRole.Forward:
                movedPlayer.Position = FantaSoccerRole.FirstBackupForward;
                break;
            case FantaSoccerRole.FirstBackupForward:
                movedPlayer.Position = FantaSoccerRole.SecondBackupForward;
                break;
            case FantaSoccerRole.SecondBackupForward:
                movedPlayer.Position = FantaSoccerRole.Tribune;
                break;
            case FantaSoccerRole.Tribune:
                switch (movedPlayer.Role)
                {
                    case Role.GoalKeeper:
                        movedPlayer.Position = FantaSoccerRole.GoalKeeper;
                        break;
                    case Role.Defensor:
                        movedPlayer.Position = FantaSoccerRole.Defensor;
                        break;
                    case Role.Midfielder:
                        movedPlayer.Position = FantaSoccerRole.Midfielder;
                        break;
                    case Role.Forward:
                        movedPlayer.Position = FantaSoccerRole.Forward;
                        break;
                }
                break;
        }
        if (State != null && RealCalendar != null && RealCalendar.NextDay?.SerieADay == SerieADay)
        {
            var key = State.TeamDayKey(SerieADay);
            var state = await Api.DailyTeam.ExistAsync(key) ?
                await Api.DailyTeam.UpdateAsync(key, Team) :
                await Api.DailyTeam.InsertAsync(key, Team);
            if (state.IsOk)
            {
                OnSave?.Invoke();
            }
        }
    }
}

@using Blazorise.LoadingIndicator;
@inherits LayoutComponentBase
@attribute [Authorize]

<PageTitle>Fantasoccer</PageTitle>

<Layout>
    <Layout Sider>
        <LayoutSider>
            <LayoutSiderContent>
                <NavMenu />
            </LayoutSiderContent>
        </LayoutSider>
        <Layout>
            <LayoutContent Padding="Padding.Is1">
                <LoadingIndicator @ref="loadingIndicator" FullScreen>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <IndicatorTemplate>
                        <img src="/static/soccerball.gif" class="loader" />
                    </IndicatorTemplate>
                </LoadingIndicator>
            </LayoutContent>
        </Layout>
    </Layout>
</Layout>

@code {
    [CascadingParameter]
    public FantasoccerState? State { get; set; }
    LoadingIndicator loadingIndicator;
}

@inherits LayoutComponentBase
@attribute [Authorize]

<PageTitle>Fantasoccer</PageTitle>

<FluentLayout Style="min-height: 100vh;">
    <FluentHeader>
        <FluentIcon Color="Color.Fill" Value="@(new Icons.Regular.Size20.SportSoccer())" />
        &nbsp;&nbsp;
        @State?.SelectedLeague?.Name @FantacalcioTime.LabelYear(State?.Year ?? 1)
        <FluentSpacer />
        <div style="margin-left:1%;" @onclick=OpenOrCloseMenu>
            <svg style="width: 30px; cursor:pointer; fill: var(--neutral-fill-rest);" focusable="false" viewBox="0 0 24 24" aria-hidden="true"><!--!--><path d="M2.75 18h18.5a.75.75 0 0 1 .1 1.5H2.75a.75.75 0 0 1-.1-1.5h18.6-18.5Zm0-6.5h18.5a.75.75 0 0 1 .1 1.5H2.75a.75.75 0 0 1-.1-1.5h18.6-18.5Zm0-6.5h18.5a.75.75 0 0 1 .1 1.5H2.75a.75.75 0 0 1-.1-1.49h18.6-18.5Z"></path></svg>
        </div>
    </FluentHeader>
    <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="min-height: calc(100vh - 50px);">
        <FluentNavMenu @bind-Expanded="@Expanded" Width="250" Collapsible="true" CollapsedChildNavigation="@ShowOnCollpase">
            @if (State?.HasAGroup == true)
            {
                <FluentNavLink Icon="@(new Icons.Regular.Size24.ReadAloud())" Href="../../" Tooltip="Leggi le notizie prima degli altri">News</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.DataBarVerticalStar())" Href="../../rank" Tooltip="La tua classifica">Classifica</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.Calendar())" Href="../../calendar" Tooltip="Confronta il tuo percorso con quello degli altri">Calendario</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.Live())" Href="../../live" Tooltip="Controlla la giornata attuale e sogna in grande">Live</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.PeopleTeam())" Href="../../allteams" Tooltip="Controlla gli avversari prima che loro controllino te">Squadre</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.DesktopEdit())" Href="../../edit" Tooltip="Fai la formazione">La mia squadra</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.PeopleList())" Href="../../allplayers" Tooltip="Tutti i giocatori a disposizione">Tutti i giocatori</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.CloudArrowUp())" Href="../../halloffame" Tooltip="Vedi i record dei record del tuo gruppo">Hall of Fame</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.PeopleQueue())" Href="../../nottaken" Tooltip="Tutti i giocatori che non sono ancora stati presi. Scegli oculatamente per gennaio o per il prossimo anno">Giocatori liberi</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.FlagClock())" Href="../../serieacalendar" Tooltip="Serie A">Calendario Serie A</FluentNavLink>
                <FluentNavLink Icon="@(new Icons.Regular.Size24.FlagClock())" Href="../../auctionlive" Tooltip="Controlla l'asta in tempo reale">Asta Live</FluentNavLink>
                @if (State?.Groups != null && State?.Identity != null)
                {
                    if (State?.Groups.Count > 1)
                    {
                        <FluentNavGroup Title="Gruppi" Tooltip="Seleziona il gruppo" Icon="@(new Icons.Regular.Size24.TabGroup())">
                            @foreach (var group in State.Groups)
                            {
                                <FluentNavLink OnClick="() => ChangeGroupAsync(group.Id)" Class="@(State?.GroupId == group.Id ? "active" : string.Empty)" Icon="@(new Icons.Regular.Size24.Group())" Tooltip="Gruppo">@group.Name</FluentNavLink>
                            }
                        </FluentNavGroup>
                    }
                    @if (State?.SelectedGroup != null)
                    {
                        <FluentNavGroup Title="@State.SelectedGroup.Name" Tooltip="Seleziona la lega" Icon="@(new Icons.Regular.Size24.EarthLeaf())">
                            @foreach (var league in State.SelectedGroup.Leagues)
                            {
                                var noTeams = true;
                                foreach (var team in State.GetTeams(State.SelectedGroup.Id, league.Id, State.Year, State.Identity.Email))
                                {
                                    noTeams = false;
                                    <FluentNavLink OnClick="() => ChangeTeamAsync(State.SelectedGroup.Id, league.Id, team.Owner)" Class="@(State?.LeagueId == league.Id && State?.MeOrLeaderEmail == team.Owner ? "active" : string.Empty)" Icon="@(new Icons.Regular.Size24.LeafTwo())" Tooltip="@($"{team.Name} ({team.Owner})")">
                                        @league.Name
                                    </FluentNavLink>
                                }
                                if (noTeams)
                                {
                                    <FluentNavLink Class="@(State?.LeagueId == league.Id ? "active" : string.Empty)" OnClick="x => ChangeTeamAsync(State.SelectedGroup.Id, league.Id, State.Identity.Email)" Icon="@(new Icons.Regular.Size24.LeafOne())" Tooltip="Sbircia">
                                        @league.Name
                                    </FluentNavLink>
                                }
                            }
                        </FluentNavGroup>
                    }
                    <FluentNavGroup Title="Anno" Tooltip="Seleziona l'anno" Icon="@(new Icons.Regular.Size24.CalendarAssistant())">
                        @for (var year = FantacalcioTime.ActualYear; year > 0; year--)
                        {
                            var actualYear = year;
                            <FluentNavLink Class="@(State?.Year == actualYear || (State == null && actualYear == FantacalcioTime.ActualYear) ? "active" : string.Empty)"
                                           OnClick="() => ChangeYearAsync(actualYear)"
                                           Icon="@(new Icons.Regular.Size24.CalendarArrowDown())">
                                @FantacalcioTime.LabelYear(actualYear)
                            </FluentNavLink>
                        }
                    </FluentNavGroup>
                    <FluentNavLink Icon="@(new Icons.Regular.Size24.Settings())" Href="../../settings" Tooltip="Scegli quando ricevere le tue notifiche e cambia nome alla tua squadra">Settings</FluentNavLink>
                    @if (State!.IsAdmin())
                    {
                        <FluentNavGroup Title="Amministrazione" Tooltip="Gestisci i tuoi gruppi, creane di nuovi, aggiungi utenti e crea le squadre, organizza l'asta." Icon="@(new Icons.Regular.Size24.ControlButton())">
                            <FluentNavLink Icon="@(new Icons.Regular.Size24.DualScreenGroup())" Href="../../groups" Tooltip="Gestisci i tuoi gruppi">Gruppi</FluentNavLink>
                            @if (State.SelectedLeague.IsMain)
                            {
                                <FluentNavLink Icon="@(new Icons.Regular.Size24.ShiftsTeam())" Href="../../manageteams" Tooltip="Gestisci le squadre della lega selezionata">Asta</FluentNavLink>
                            }
                        </FluentNavGroup>
                        <FluentNavGroup Title="Super Amministrazione" Tooltip="Gestisci tutti gli utenti e controlla il calendario di Serie A" Icon="@(new Icons.Regular.Size24.TextSuperscript())">
                            <FluentNavLink Icon="@(new Icons.Regular.Size24.PeopleAudience())" Href="../../users" Tooltip="Gestisci gli utenti">Utenti</FluentNavLink>
                            <FluentNavLink Icon="@(new Icons.Regular.Size24.Calendar3Day())" Href="../../managecalendar" Tooltip="Gestisci tramite il calendario di Serie A">Calendario Serie A</FluentNavLink>
                        </FluentNavGroup>
                    }
                    <FluentNavLink Icon="@(new Icons.Regular.Size24.Calendar3Day())" OnClick="()=> Logout?.Invoke(false)" Tooltip="Esci dalla piattaforma">Logout</FluentNavLink>
                    <FluentNavLink Icon="@(new Icons.Regular.Size24.Diversity())" Tooltip="Versione">v. 0.4.0-beta</FluentNavLink>
                }
            }
        </FluentNavMenu>
        <FluentBodyContent>
            <div>
                @Body
            </div>
            @* <div Class="recording">
            <Recording></Recording>
            </div> *@
        </FluentBodyContent>
    </FluentStack>
    <FluentToastProvider MaxToastCount="10" Position="ToastPosition.BottomRight" />
    <FluentDialogProvider />
    <FluentTooltipProvider />
</FluentLayout>
<LoadingIndicatorHelper />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject]
    public required IJSRuntime JsRuntime { get; set; }
    [CascadingParameter]
    public FantasoccerState? State { get; set; }
    [CascadingParameter(Name = "LogoutCallback")]
    public Func<bool, ValueTask>? Logout { get; set; }
    [CascadingParameter]
    public LoadingIndicator LoadingIndicator { get; set; }
    private List<Group> groups;
    private bool Expanded = true;
    private bool ShowOnCollpase = true;

    protected override async Task OnParametersSetAsync()
    {
        if (State?.Identity?.Groups != null)
        {
            groups = new();
            foreach (var group in State.Identity.Groups)
            {
                var theGroup = await Api.Groups.GetAsync(group.Id);
                if (theGroup != null)
                    groups.Add(theGroup);
            }
        }
        Expanded = !await UiUtilityService.IsMobileAsync();
        ShowOnCollpase = Expanded;
        await base.OnParametersSetAsync();
    }
    private void OpenOrCloseMenu()
    {
        Expanded = !Expanded;
    }
    public Task ChangeYearAsync(int year)
    {
        if (State != null && State.Year != year)
        {
            LoadingIndicator?.Show();
            return State.ChangeYearAsync(year);
        }
        return Task.CompletedTask;
    }
    public ValueTask ChangeGroupAsync(string groupId)
    {
        if (State != null && State.GroupId != groupId)
        {
            LoadingIndicator?.Show();
            return State.ChangeGroupAsync(groupId);
        }
        return ValueTask.CompletedTask;
    }
    public Task ChangeTeamAsync(string groupId, string leagueId, string owner)
    {
        if (State != null && (State.GroupId != groupId || State.LeagueId != leagueId || State.MeOrLeaderEmail != owner))
        {
            LoadingIndicator?.Show();
            return State.ChangeTeamAsync(groupId, leagueId, owner);
        }
        return Task.CompletedTask;
    }
}

@if (Players != null)
{
    @* Items="@Players.OrderBy(x => x.Current.Role)" ItemsFilter="@Filter" ItemDropped="@ItemDropped" *@
    <FluentDragContainer TItem="EnrichedPlayer" Class="playerContainer" OnDragOver="(x) => _ = ItemDropped(x)">
        <FluentStack>
            @foreach (var position in !Inverted ? FantaSoccerPosition.Default : FantaSoccerPosition.Inverted)
            {
                <div class="@position.Css">
                    <FluentDropZone Id="@Inverted.ToString()" Draggable="true" DropAllowed="@position.Filter" OnDrop="@ItemDropped">
                        @foreach (var player in Players)
                        {
                            <PlayerCard Player="player"></PlayerCard>
                        }
                    </FluentDropZone>
                    @* <DropZone Class="@position.ColumnContainer" TItem="EnrichedPlayer" Name="@position.Position.ToString()" DropAllowed="@position.Filter"></DropZone> *@
                </div>
            }
        </FluentStack>
    </FluentDragContainer>
}


@code {
    [Parameter]
    public required IEnumerable<EnrichedPlayer> Players { get; set; }
    [Parameter]
    public required bool Inverted { get; set; }
    [Parameter]
    public required Func<ValueTask> SaveTeam { get; set; }
    private bool Filter(EnrichedPlayer player, string zoneName)
    {
        var result = player.CurrentPosition.ToString() == zoneName;
        return result;
    }
    private async ValueTask ItemDropped(FluentDragEventArgs<EnrichedPlayer> dropItem)
    {
        // var movedPlayer = dropItem.Source.Element as EnrichedPlayer;
        var movedPlayer = null as EnrichedPlayer;
        var dropZoneName = dropItem.Target.AdditionalAttributes.First().Key;
        var position = (FantaSoccerRole)Enum.Parse(typeof(FantaSoccerRole), dropZoneName);
        if (position >= FantaSoccerRole.BackupGoalKeeper && position <= FantaSoccerRole.SecondBackupForward)
        {
            var playerInBench = Players.FirstOrDefault(x => x.Current.Position == position);
            if (playerInBench != null)
            {
                playerInBench.Current.Position = movedPlayer.Current.Position;
                playerInBench.CurrentPosition = movedPlayer.CurrentPosition;
            }
        }
        movedPlayer.Current.Position = position;
        movedPlayer.CurrentPosition = position;
        await SaveTeam.Invoke();
    }
}

<DropContainer TItem="Player" Items="@Team.ActivePlayers.OrderBy(x => x.Role)" ItemsFilter="@Filter" ItemDropped="@ItemDropped" Class="playerContainer">
    <ChildContent>
        @foreach (var position in !Inverted ? FantaSoccerPosition.Default : FantaSoccerPosition.Inverted)
        {
            <div class="@position.Css">
                <DropZone Class="@position.ColumnContainer" TItem="Player" Name="@position.Position.ToString()" DropAllowed="@position.Filter"></DropZone>
            </div>
        }
    </ChildContent>
    <ItemTemplate>
        <PlayerCard Player="context" Chancer="GetChance(context)" Vote="GetVote(context)" Game="GetRealGame(context)"></PlayerCard>
    </ItemTemplate>
</DropContainer>
<Snackbar @ref="snackbar" Location="SnackbarLocation.BottomEnd">
    <SnackbarBody>
        @message
    </SnackbarBody>
</Snackbar>

@code {
    [Parameter]
    public required Team Team { get; set; }
    [Parameter]
    public required FantasoccerState State { get; set; }
    [Parameter]
    public required RealCalendar RealCalendar { get; set; }
    [Parameter]
    public required int SerieADay { get; set; }
    [Parameter]
    public required RealDay? RealDay { get; set; }
    [Parameter]
    public required ChancedRealPlayerWrapper? Chance { get; set; }
    [Parameter]
    public required VotedRealPlayerWrapper? Live { get; set; }
    [Parameter]
    public required VotedRealPlayerWrapper? Official { get; set; }
    [Parameter]
    public required Func<Player, ChancedRealPlayer?> GetChance { get; set; }
    [Parameter]
    public required Func<Player, Vote?> GetVote { get; set; }
    [Parameter]
    public required Func<Player, RealGame?> GetRealGame { get; set; }
    [Parameter]
    public required bool Inverted { get; set; }
    private Snackbar? snackbar;
    private string? message;
    private bool Filter(Player player, string zoneName)
    {
        var result = player.Position.ToString() == zoneName;
        return result;
    }
    private async Task ItemDropped(DraggableDroppedEventArgs<Player> dropItem)
    {
        var movedPlayer = dropItem.Item;
        var position = (FantaSoccerRole)Enum.Parse(typeof(FantaSoccerRole), dropItem.DropZoneName);
        if (position >= FantaSoccerRole.BackupGoalKeeper && position <= FantaSoccerRole.SecondBackupForward)
        {
            var playerInBench = Team.ActivePlayers.FirstOrDefault(x => x.Position == position);
            if (playerInBench != null)
                playerInBench.Position = movedPlayer.Position;
        }
        movedPlayer.Position = position;
        if (State != null && RealCalendar != null && RealCalendar.NextDay?.SerieADay == SerieADay)
        {
            var key = State.TeamDayKey(SerieADay);
            var state = await Api.DailyTeam.ExistAsync(key) ?
                await Api.DailyTeam.UpdateAsync(key, Team) :
                await Api.DailyTeam.InsertAsync(key, Team);
            if (snackbar != null)
            {
                snackbar.Color = state.IsOk ? SnackbarColor.Success : SnackbarColor.Danger;
                message = state.Message ?? (state.IsOk ? "Formazione salvata correttamente." : "Errore durante il savaltaggio della formazione.");
                snackbar.Show();
            }
        }
    }
}

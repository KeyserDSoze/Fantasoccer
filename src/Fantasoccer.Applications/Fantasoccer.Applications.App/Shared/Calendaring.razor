@if (Days != null)
{
    <FluentGrid AdaptiveRendering="true" Spacing="0" Justify="JustifyContent.FlexStart">
        @foreach (var day in Days)
        {
            <FluentGridItem xl="Desktop" md="Mobile" xxl="Desktop" xs="Mobile" sm="Mobile" lg="Desktop">
                <FluentCard>
                    <h3>Giornata @day.Number (@day.SerieADay)</h3>
                    <FluentDataGrid RowClass="@(x => "calendarrow")" TGridItem="CalendarGame" Items="day.Games.AsQueryable()" OnRowClick="p => NavigateTo(p)">
                        <PropertyColumn Property="@(p => p.Home)" Title="Casa" />
                        <PropertyColumn Property="@(p => CalculateResult(p))" Title="Risultato" />
                        <PropertyColumn Property="@(p => p.Away)" Title="Trasferta" />
                    </FluentDataGrid>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
}
@code {
    [Parameter]
    public List<Day>? Days { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
    [Parameter]
    public string GroupId { get; set; }
    [Parameter]
    public string LeagueId { get; set; }
    [Parameter]
    public int Year { get; set; }
    [Parameter]
    public int Desktop { get; set; } = 6;
    [Parameter]
    public int Mobile { get; set; } = 12;
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    private string CalculateResult(CalendarGame game)
    {
        if (game.Result == null)
            return "Da giocare";
        else if (game.Result.IsCancelled)
            return "Cancellata";
        else
        {
            return $"{game.Result.HomeGoal} ({game.Result.Home.Value}) - ({game.Result.Away.Value}) {game.Result.AwayGoal}";
        }
    }
    private void NavigateTo(FluentDataGridRow<CalendarGame> calendarGame)
    {
        var gameId = calendarGame.Id ??= string.Empty;
        NavigationManager.NavigateTo($"game/{GroupId}/{LeagueId}/{Year}/{gameId}", false);
    }
}

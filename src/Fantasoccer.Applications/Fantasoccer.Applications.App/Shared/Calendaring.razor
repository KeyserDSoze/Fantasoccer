@if (Days != null)
{
    @foreach (var day in Days)
    {
        <Column ColumnSize="WithFluentSize ? ColumnSize.Is6.OnDesktop.Is12.OnMobile.Is12.OnTablet : ColumnSize.Is12">
            <Card Margin="Margin.Is1">
                <CardBody>
                    <CardTitle Size="3">
                        Day @day.Number (@day.SerieADay)
                    </CardTitle>
                    <CardText class="fonting">
                        <Table Striped>
                         <TableHeader>
                             <TableRow>
                                 <TableHeaderCell>Home Team</TableHeaderCell>
                                 <TableHeaderCell>Points</TableHeaderCell>
                                 <TableHeaderCell>Away Team</TableHeaderCell>
                             </TableRow>
                         </TableHeader>
                         <TableBody>
                             @foreach (var game in day.Games)
                                {
                                    <TableRow Clicked="() => NavigateTo(game.Id)">
                                        <TableRowCell>@game.Home</TableRowCell>
                                        @if (game.Result != null && !game.Result.IsCancelled)
                                        {
                                            <TableRowCell>
                                                @game.Result.HomeGoal (@game.Result.Home.Value) - (@game.Result.Away.Value) @game.Result.AwayGoal
                                            </TableRowCell>
                                        }
                                        else if (game.Result != null && game.Result.IsCancelled)
                                        {
                                            <TableRowCell>
                                                cancelled
                                            </TableRowCell>
                                        }
                                        else
                                        {
                                            <TableRowCell>
                                                to play
                                            </TableRowCell>
                                        }
                                        <TableRowCell>@game.Away</TableRowCell>
                                    </TableRow>
                                }
                            </TableBody>
                        </Table>
                    </CardText>
                </CardBody>
            </Card>
        </Column>
    }
}
@code {
    [Parameter]
    public List<Day>? Days { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
    [Parameter]
    public string GroupId { get; set; }
    [Parameter]
    public string LeagueId { get; set; }
    [Parameter]
    public int Year { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    private void NavigateTo(string gameId)
    {
        NavigationManager.NavigateTo($"game/{GroupId}/{LeagueId}/{Year}/{gameId}", false);
    }
}

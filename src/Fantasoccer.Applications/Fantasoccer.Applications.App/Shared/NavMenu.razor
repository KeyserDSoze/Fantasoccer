<Bar Mode="BarMode.VerticalInline"
     CollapseMode="BarCollapseMode.Small"
     Breakpoint="Breakpoint.Desktop"
     NavigationBreakpoint="Breakpoint.Tablet"
     ThemeContrast="ThemeContrast.Dark">
    <BarToggler />
    <BarBrand>
        <BarItem>
            <BarLink To="../../">
                <BarIcon IconName="IconName.Walking" />
                Fantasoccer
            </BarLink>
        </BarItem>
    </BarBrand>
    <BarMenu>
        <BarStart>
            <BarItem>
                <BarLink To="../../">
                    <BarIcon IconName="IconName.Star" />
                    Rank
                </BarLink>
            </BarItem>
            <BarItem>
                <BarLink To="../../calendar">
                    <BarIcon IconName="IconName.CalendarDay" />
                    Calendar
                </BarLink>
            </BarItem>
            <BarItem>
                <BarLink To="../../edit">
                    <BarIcon IconName="IconName.Users" />
                    Your team
                </BarLink>
            </BarItem>
            @if (Identity != null)
            {
                <BarItem>
                    <BarDropdown>
                        <BarDropdownToggle>
                            <BarIcon IconName="IconName.LayerGroup" />
                            Group
                        </BarDropdownToggle>
                        <BarDropdownMenu>
                            @foreach (var group in Identity.Groups)
                            {
                                <BarDropdown>
                                    <BarDropdownToggle>
                                        <BarIcon IconName="IconName.Flag" />
                                        @group.Name
                                    </BarDropdownToggle>
                                    <BarDropdownMenu>
                                        @foreach (var league in group.Leagues)
                                        {
                                            <BarDropdownItem Class="@(State?.LeagueId == league.Id ? "active" : string.Empty)" Clicked="x => ChangeLeague(group.Id, league.Id)">
                                                <BarIcon IconName="IconName.DotCircle" />
                                                @league.Name
                                            </BarDropdownItem>
                                        }
                                    </BarDropdownMenu>
                                </BarDropdown>
                            }
                        </BarDropdownMenu>
                    </BarDropdown>
                </BarItem>
            }
            <BarItem>
                <BarDropdown>
                    <BarDropdownToggle>
                        <BarIcon IconName="IconName.CalendarTimes" />
                        Years
                    </BarDropdownToggle>
                    <BarDropdownMenu>
                        @for (var year = FantacalcioTime.ActualYear; year > 0; year--)
                        {
                            var actualYear = year;
                            <BarDropdownItem Class="@(State?.Year == actualYear || (State == null && actualYear == FantacalcioTime.ActualYear) ? "active" : string.Empty)"
                                             Clicked="x => ChangeYear(actualYear)">
                                <BarIcon IconName="IconName.Times" />
                                @FantacalcioTime.LabelYear(actualYear)
                            </BarDropdownItem>
                        }
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>
        </BarStart>
    </BarMenu>
</Bar>

@code {
    [CascadingParameter]
    private AppIdentity? Identity { get; set; }
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    private void ChangeLeague(string groupId, string leagueId)
    {
        if (State != null)
        {
            State.GroupId = groupId;
            State.LeagueId = leagueId;
            State.Update();
        }
    }
    private void ChangeYear(int year)
    {
        if (State != null)
        {
            State.Year = year;
            State.Update();
        }
    }
}

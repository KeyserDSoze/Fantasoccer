@if (Teams != null)
{
    <Card Margin="Margin.Is1">
        <CardBody>
            <CardTitle Size="3">
                Rank
            </CardTitle>
            <CardText>
                <Table Striped>
                 <TableHeader>
                     <TableRow>
                         <TableHeaderCell>#</TableHeaderCell>
                         <TableHeaderCell>P</TableHeaderCell>
                         <TableHeaderCell>VP</TableHeaderCell>
                         <TableHeaderCell>V</TableHeaderCell>
                         <TableHeaderCell>D</TableHeaderCell>
                         <TableHeaderCell>De</TableHeaderCell>
                         <TableHeaderCell>G</TableHeaderCell>
                         <TableHeaderCell>SG</TableHeaderCell>
                         <TableHeaderCell>SV</TableHeaderCell>
                         <TableHeaderCell>M</TableHeaderCell>
                     </TableRow>
                 </TableHeader>
                 <TableBody>
                     @foreach (var team in Teams)
                        {
                            <TableRow>
                                <TableRowHeader>@team.Name</TableRowHeader>
                                <TableRowCell>@team.Point</TableRowCell>
                                <TableRowCell>@team.ValuePoint</TableRowCell>
                                <TableRowCell>@team.Victories</TableRowCell>
                                <TableRowCell>@team.Draws</TableRowCell>
                                <TableRowCell>@team.Defeats</TableRowCell>
                                <TableRowCell>@team.Goal</TableRowCell>
                                <TableRowCell>@team.SufferedGoal</TableRowCell>
                                <TableRowCell>@team.SufferedValuePoint</TableRowCell>
                                <TableRowCell>@team.ValueAssets</TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </CardText>
        </CardBody>
    </Card>
}

@code {
    [Parameter]
    public required List<RankedTeam> Teams { get; set; }
}

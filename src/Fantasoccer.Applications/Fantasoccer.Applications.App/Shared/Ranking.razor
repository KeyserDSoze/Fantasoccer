@if (Teams != null)
{
    <h3>
        @if (Day > 0)
        {
            @:(Day @Day (Serie A @SerieADay))
        }
        else
        {
            @:Rank
        }
    </h3>
    <FluentDataGrid Items="Teams.OrderByDescending(x => x.Point).ThenByDescending(x => x.ValuePoint).AsQueryable()" TGridItem="RankedTeam" AutoFit="true" ResizableColumns="true">
        <PropertyColumn Property="@(x => x.Name)" Title="#"/>
        <PropertyColumn Property="@(x => x.Point)" Title="P"/>
        <PropertyColumn Property="@(x => x.ValuePoint)" Title="VP"/>
        <PropertyColumn Property="@(x => x.Victories)" Title="V"/>
        <PropertyColumn Property="@(x => x.Draws)" Title="D"/>
        <PropertyColumn Property="@(x => x.Defeats)" Title="De"/>
        <PropertyColumn Property="@(x => x.Goal)" Title="G" />
        <PropertyColumn Property="@(x => x.SufferedGoal)" Title="SG"/>
        <PropertyColumn Property="@(x => x.SufferedValuePoint)" Title="SV"/>
        <PropertyColumn Property="@(x => x.ValueAssets)" Title="M"/>
    </FluentDataGrid>
}

@code {
    [Parameter]
    public required IEnumerable<RankedTeam> Teams { get; set; }
    [Parameter]
    public int Day { get; set; }
    [Parameter]
    public int SerieADay { get; set; }
}

@if (Days != null)
{
    <FluentGrid Spacing="0" AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
        @foreach (var day in Days)
        {
            <FluentGridItem xl="6" md="12">
                <FluentCard>
                    <h3>Day @day.SerieADay</h3>
                    <FluentDataGrid TGridItem="RealGame" Items="day.Games.AsQueryable()" OnRowClick="p => NavigateTo(p)">
                        <PropertyColumn Property="@(p => p.Home.Name)" Sortable="true" Title="Casa" />
                        <PropertyColumn Property="@(p => CalculateResult(p))" Sortable="true" Title="Risultato" />
                        <PropertyColumn Property="@(p => p.Away.Name)" Sortable="true" Title="Trasferta" />
                    </FluentDataGrid>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
}
@code {
    [Parameter]
    public List<RealDay>? Days { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    private void NavigateTo(FluentDataGridRow<RealGame> game)
    {
        var gameId = game.Id;
        NavigationManager.NavigateTo($"game/{gameId}", false);
    }
    private string CalculateResult(RealGame game)
    {
        if (game.IsPlayed)
        {
            return $"{game.HomeGoal} - {game.AwayGoal}";
        }
        else
        {
            return game.Date?.ToString("yyyy-MM-dd HH:mm") ?? "da giocare";
        }
    }
}

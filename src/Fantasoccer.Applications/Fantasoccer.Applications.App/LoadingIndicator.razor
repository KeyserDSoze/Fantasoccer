<div class="totalContainer">
    <CascadingValue Value="@this" IsFixed>
        @ChildContent
    </CascadingValue>
    @if (IsVisible)
    {
        <div class="containerForLoader">
            <img src="/static/soccerball.gif" class="loader" />
        </div>
    }
</div>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    public bool IsVisible { get; private set; }
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
    public void Show()
    {
        IsVisible = true;
    }
    public void Hide()
    {
        IsVisible = false;
    }
}
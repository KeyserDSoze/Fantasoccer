{
  "expo": {
    "name": "Fantasoccer",
    "slug": "fantasoccer",
    "scheme": "fantasoccer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fantasoccer.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Microsoft OAuth",
            "CFBundleURLSchemes": ["msauth.com.fantasoccer.app", "fantasoccer"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.fantasoccer.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "msauth",
              "host": "com.fantasoccer.app"
            },
            {
              "scheme": "fantasoccer"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

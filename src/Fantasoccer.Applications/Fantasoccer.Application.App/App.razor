@using Fantasoccer.Application.Shared
@using Microsoft.AspNetCore.Components.Web
@inject StaticSettings StaticSettings

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="apple-touch-icon" sizes="180x180" href="@StaticSettings.GetStaticContentUri("apple-touch-icon.png")">
    <link rel="icon" type="image/png" sizes="32x32" href="@StaticSettings.GetStaticContentUri("favicon-32x32.png")">
    <link rel="icon" type="image/png" sizes="16x16" href="@StaticSettings.GetStaticContentUri("favicon-16x16.png")">
    <link rel="manifest" href="@StaticSettings.GetStaticContentUri("site.webmanifest")">
    <link rel="mask-icon" href="@StaticSettings.GetStaticContentUri("safari-pinned-tab.svg")" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <style>
        :root{
            --vertical-field: url(@StaticSettings.GetStaticContentUri("static/verticalfield.jpg"));
            --vertical-bench: url(@StaticSettings.GetStaticContentUri("static/verticalbenchfield.jpg"));
        }
    </style>
    @foreach (var css in StaticSettings.Csses)
    {
        if (css.Integrity is null)
        {
            <link rel="stylesheet" href="@css.Uri">
        }
        else
        {
            <link rel="stylesheet" href="@css.Uri" integrity="@css.Integrity" crossorigin="@css.Integrity" />
        }
    }
    <link href="Fantasoccer.Application.App.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@RenderMode.InteractiveServer" />
</head>
<body>
    <AppRouter @rendermode="@RenderMode.InteractiveServer" />
    <loading-theme storage-name="theme"></loading-theme>
    <script src="_framework/blazor.web.js"></script>
    @foreach (var script in StaticSettings.Javascripts)
    {
        if (script.IsAsync)
        {
            <script src="@script.Uri" type="@script.Type" async></script>
        }
        else
        {
            <script src="@script.Uri" type="@script.Type"></script>
        }
    }
</body>
</html>

@page "/settings"
@using System.Text.Json
@using Rystem.Content
@using WebPush
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>
<FluentDesignTheme @bind-Mode="@Mode"
                   @bind-OfficeColor="@OfficeColor"
                   OnLoaded="@OnLoaded"
                   OnLuminanceChanged="@OnLuminanceChanged"
                   StorageName="theme" />
@if (State?.IsAuthenticated == true)
{
    <FluentGrid Spacing="0" AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
        <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6" Style="margin-top:10px;">
            <h3>Impostazioni</h3>
            <div>
                <FluentTextField @bind-Value=State.Identity!.Username Label="Username"></FluentTextField>
                @if (team != null)
                {
                    <FluentTextField @bind-Value=team.Name Label="Nome squadra"></FluentTextField>
                }
            </div>
            <div>
                <FluentButton Appearance="Appearance.Accent" OnClick="@OnSaveClicked">
                    Salva impostazioni
                </FluentButton>
            </div>
        </FluentGridItem>
        <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6" Style="margin-top:10px;">
            <h3>Logo</h3>
            <div>
                <img style="max-width:100px;margin-bottom:10px;" src="@ImageUriHelper.GetTeamImageUri(State.GroupId!, State.Year, State.Identity.Email)" onerror="@ImageUriHelper.GetPlaceholderTeamImageUri()" />
                <div style="margin-bottom:10px;">
                    <FluentButton Appearance="Appearance.Accent" OnClick="@UseOldLogoAsync">
                        Usa il logo dell'anno precedente
                    </FluentButton>
                </div>
                <FluentInputFile Id="logo-uploader"
                                 Mode="InputFileMode.Stream"
                                 Multiple="false"
                                 MaximumFileCount="1"
                                 MaximumFileSize="@(10*1024*1024)"
                                 Accept="image/*"
                                 OnCompleted="@OnCompletedAsync"
                                 Style="height: 150px; border: 1px dashed var(--accent-fill-rest);">
                    <ChildContent>
                        <label for="logo-uploader">
                            <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" />
                        </label>

                        <div>
                            Carica il tuo logo e rendi la tua squadra unica
                        </div>
                    </ChildContent>
                </FluentInputFile>
            </div>
        </FluentGridItem>
        <FluentGridItem xl="12" md="12" xxl="12" xs="12" sm="12" lg="12" Style="margin-top:10px;">
            <h3>Allena la tua AI</h3>
            <FluentTextArea Cols="100" Rows="10" @bind-Value="@aiLearner"></FluentTextArea>
            <FluentButton Appearance="Appearance.Accent" OnClick="@SavePromptAsync">
                Salva il tuo prompt
            </FluentButton>
        </FluentGridItem>
        @if (pushNotificationSettings != null)
        {
            <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6" Style="margin-top:10px;">
                <h3>Notifiche</h3>
                <div>
                    <FluentCheckbox @bind-Value="@pushNotificationSettings.MatchEvents" Label="Eventi della partita" />
                    <FluentCheckbox @bind-Value="@pushNotificationSettings.OpponentMatchEvents" Label="Eventi della partita del tuo avversario" />
                    <FluentCheckbox @bind-Value="@pushNotificationSettings.DeploymentReminder" Label="Reminder formazione" />
                    <FluentCheckbox @bind-Value="@pushNotificationSettings.EndDay" Label="Fine giornata" />
                    <FluentCheckbox @bind-Value="@pushNotificationSettings.MarketEvents" Label="Scambi (compravendita)" />
                </div>
                <div>
                    <FluentButton Appearance="Appearance.Accent" OnClick="@SavePushSettingsAsync">
                        Salva le impostazioni per le push notification
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" OnClick="@SubscribeOrUnsubscribeAsync">
                        @if (isSubscribed)
                        {
                            @:Disabilita Push notification
                        }
                        else
                        {
                            @:Abilita Push notification
                        }
                    </FluentButton>
                </div>
            </FluentGridItem>
        }
        <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6" Style="margin-top:10px;">
            <h3>Temi</h3>
            <FluentSelect Items="@(Enum.GetValues<DesignThemeModes>())"
                          Multiple="false"
                          @bind-SelectedOption="@Mode" />
            <FluentSelect Items="@(Enum.GetValues<OfficeColor>().Select(i => (OfficeColor?)i))"
                          Multiple="false"
                          @bind-SelectedOption="@OfficeColor" />
        </FluentGridItem>
    </FluentGrid>
}
@code {
    [Inject]
    public IFactory<IContentRepository> ContentFactory { get; set; }
    [Inject]
    private IMessageService? MessageService { get; set; }
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private Team? team;
    private PushNotificationSettings? pushNotificationSettings;
    private const string applicationServerPublicKey = "BC-_PiSEDN7I_pQsMKcDZeIDSPG-_2cCVvseMFvug6SNCI0hI7lqR8viPNdCKig7ny2iSdOeGI7ioBup2vd4tJ8";
    private bool isSubscribed;
    private string aiLearner = string.Empty;
    public DesignThemeModes Mode { get; set; }

    public OfficeColor? OfficeColor { get; set; }
    void OnLoaded(LoadedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }
    void OnLuminanceChanged(LuminanceChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            LoadingIndicator?.Hide();
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        LoadingIndicator?.Show();
        if (State?.SelectedTeam != null)
        {
            team = await Api.Team.GetAsync(State.OtherTeamKey(State.SelectedTeam.Owner)) ?? new Team
            {
                Name = State.SelectedTeam.Name,
                Owner = State.SelectedTeam.Owner,
                Players = new()
            };
            pushNotificationSettings = await Api.PushNotification.GetAsync(State.Identity!.Email!) ?? new PushNotificationSettings();
            isSubscribed = await JS.InvokeAsync<bool>("isSubscribedToNotification", null);
            var settings = await Api.Settings.GetAsync(State.Identity.Email);
            if (settings?.AiPrompt != null)
            {
                aiLearner = settings.AiPrompt;
            }
        }
        await base.OnParametersSetAsync();
    }
    private async Task SavePromptAsync()
    {
        if (await Api.Settings.ExistAsync(State!.Identity!.Email))
        {
            await Api.Settings.UpdateAsync(State.Identity.Email, new Settings
            {
                AiPrompt = aiLearner
            });
        }
        else
        {
            await Api.Settings.InsertAsync(State.Identity.Email, new Settings
            {
                AiPrompt = aiLearner
            });
        }
    }
    private async Task OnCompletedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        LoadingIndicator.Show();
        try
        {
            var contentRepository = ContentFactory.Create("logos")!;
            foreach (var file in files.Where(x => x?.Stream != null))
            {
                var logoKey = $"{State.GroupId}/{State.Year}/{team.Owner}.png";
                var data = await file.Stream!.ToArrayAsync();
                var response = await contentRepository.UploadAsync(logoKey, data, new ContentRepositoryOptions
                {
                    HttpHeaders = new()
                    {
                        ContentType = "image/png"
                    }
                });
                if (response)
                {
                    ToastService.ShowSuccess("Logo caricato con successo.");
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.ShowError($"Errore durante il caricamento del logo.");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Errore durante il caricamento del logo.");
        }
        LoadingIndicator.Hide();
    }
    private async Task UseOldLogoAsync()
    {
        LoadingIndicator.Show();
        try
        {

            var contentRepository = ContentFactory.Create("logos")!;
            var oldLogoKey = $"{State.GroupId}/{State.Year - 1}/{team.Owner}.png";
            var newLogoKey = $"{State.GroupId}/{State.Year}/{team.Owner}.png";
            if (await contentRepository.ExistAsync(oldLogoKey))
            {
                var data = await contentRepository.DownloadAsync(oldLogoKey);
                if (data?.Data != null)
                {
                    var response = await contentRepository.UploadAsync(newLogoKey, data.Data, new ContentRepositoryOptions
                    {
                        HttpHeaders = new()
                        {
                            ContentType = "image/png"
                        }
                    });
                    if (response)
                    {
                        ToastService.ShowSuccess("Logo caricato con successo.");
                        await InvokeAsync(StateHasChanged);
                    }
                    else
                    {
                        ToastService.ShowError($"Errore durante il caricamento del logo.");
                    }
                }
            }
            else
            {
                ToastService.ShowError("Non esiste un logo per l'anno precedente.");
            }
            StateHasChanged();
        }
        catch
        {
            ToastService.ShowError($"Errore durante il caricamento del logo.");
        }
        LoadingIndicator.Hide();
    }

    async Task OnSaveClicked()
    {

        LoadingIndicator?.Show();
        if (State?.IsAuthenticated == true && team != null)
        {
            var key = State.OtherTeamKey(team.Owner);
            if (!await Api.Team.ExistAsync(key))
            {
                await Api.Team.InsertAsync(State.TeamKey, team);
            }
            else
            {
                await Api.Team.UpdateAsync(State.TeamKey, team);
            }
            var basket = State.SelectedYearlyBaskets;
            if (basket != null)
            {
                foreach (var teamX in basket.SelectMany(x => x.Teams).Where(x => x.Owner == team.Owner))
                {
                    teamX.Name = team.Name;
                }
                await Api.Groups.UpdateAsync(State.GroupId, State.SelectedGroup);
                var basketId = State.SelectedBasketId;
                foreach (var league in State.SelectedGroup.Leagues.Where(x => x.BasketsId.Contains(basketId)))
                {
                    var leagueKey = State.LeagueKey;
                    var calendar = await Api.Calendar.GetAsync(leagueKey);
                    if (calendar != null)
                    {
                        foreach (var round in calendar.Rounds)
                        {
                            foreach (var day in round.Value)
                            {
                                foreach (var game in day.Games)
                                {
                                    if (game.HomeOwner == team.Owner)
                                    {
                                        game.Home = team.Name;
                                    }
                                    else if (game.AwayOwner == team.Owner)
                                    {
                                        game.Away = team.Name;
                                    }
                                }
                            }
                        }
                        await Api.Calendar.UpdateAsync(leagueKey, calendar);
                    }
                    var rank = await Api.Ranks.GetAsync(leagueKey);
                    if (rank != null)
                    {
                        foreach (var round in rank.RankedTeams)
                        {
                            foreach (var teamX in round.Value)
                            {
                                if (teamX.Owner == team.Owner)
                                {
                                    teamX.Name = team.Name;
                                }
                            }
                        }
                        await Api.Ranks.UpdateAsync(leagueKey, rank);
                    }
                }
            }
            State.UpdateUi();
        }
        LoadingIndicator?.Hide();
    }
    public async Task SavePushSettingsAsync()
    {
        LoadingIndicator?.Show();
        var key = State.Identity!.Email!;
        if (await Api.PushNotification.ExistAsync(key))
        {
            await Api.PushNotification.UpdateAsync(key, pushNotificationSettings);
        }
        else
        {
            await Api.PushNotification.InsertAsync(key, pushNotificationSettings);
        }
        LoadingIndicator?.Hide();
    }
    public async Task SubscribeOrUnsubscribeAsync()
    {
        LoadingIndicator?.Show();
        if (!isSubscribed)
        {
            var subscriptionValue = await JS.InvokeAsync<string?>("subscribeUser", applicationServerPublicKey);
            await SubscribeToNotificationAsync(subscriptionValue);
        }
        else
        {
            var subscriptionValue = await JS.InvokeAsync<string?>("unsubscribeUser", null);
            await UnsubscribeToNotificationAsync(subscriptionValue);
        }
        isSubscribed = await JS.InvokeAsync<bool>("isSubscribedToNotification", null);
        LoadingIndicator?.Hide();
    }
    public async Task SubscribeToNotificationAsync(string? value)
    {
        if (State?.IsAuthenticated == true && team != null)
        {
            var key = State.Identity!.Email!;
            PushNotificationSubscription notificationSubscription = value.FromJson<PushNotificationSubscription>(new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
            if (!pushNotificationSettings!.Subscriptions.Any(x => x.Auth == notificationSubscription.Keys.Auth))
            {
                pushNotificationSettings.Subscriptions.Add(new PushSubscription
                {
                    Auth = notificationSubscription.Keys.Auth,
                    Endpoint = notificationSubscription.Endpoint,
                    P256DH = notificationSubscription.Keys.P256DH
                });
            }
            await SavePushSettingsAsync();
        }
    }
    public async Task UnsubscribeToNotificationAsync(string? value)
    {
        if (State?.IsAuthenticated == true && team != null)
        {
            var key = State.Identity!.Email!;
            PushNotificationSubscription notificationSubscription = value.FromJson<PushNotificationSubscription>(new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
            if (await Api.PushNotification.ExistAsync(key))
            {
                var subscription = pushNotificationSettings!.Subscriptions.FirstOrDefault(x => x.Auth == notificationSubscription.Keys.Auth);
                if (subscription != null)
                {
                    pushNotificationSettings.Subscriptions.Remove(subscription);
                    await Api.PushNotification.UpdateAsync(key, pushNotificationSettings);
                }
            }
        }
    }
}
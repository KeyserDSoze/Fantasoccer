@page "/game/{groupId?}/{leagueId?}/{year:int?}/{gameId?}"
@page "/edit"
@using System.Text.RegularExpressions;
@using Fantasoccer.Business;

@if (State != null)
{
    @if (!isMobile)
    {
        <div class="field">
            @if (game != null)
            {
                <ResultCard Css="gameResult animOpacity" Game="game"></ResultCard>
            }
            else
            {
                <div class="gameResult animOpacity">&nbsp;</div>
            }
            @if (teams != null)
            {
                var inHome = true;
                <img class="backgroundField" src="@StaticSettings.GetStaticContentUri("static/field.jpg")" />
                <img class="backgroundMiddleBench" src="@StaticSettings.GetStaticContentUri("static/fieldmiddle.jpg")" />
                <img class="backgroundEndBench" src="@StaticSettings.GetStaticContentUri("static/fieldendbench.jpg")" />
                <img class="backgroundLeftBench" src="@StaticSettings.GetStaticContentUri("static/fieldleftbench.png")" />
                <img class="backgroundRightBench" src="@StaticSettings.GetStaticContentUri("static/fieldrightbench.png")" />
                @if (isInEdit)
                {
                    <img class="backgroundTribune" src="@StaticSettings.GetStaticContentUri("static/verticalbenchfield.jpg")" />
                }
                foreach (var team in teams)
                {
                    @if (team.LastUpdate > DateTime.MinValue)
                    {
                        <FluentTooltip Anchor="@(inHome ? "team-name-home" : "team-name-away")">
                            @team.LastUpdate.ToString("yyyy-MM-dd HH:mm:ss")
                        </FluentTooltip>
                    }
                    inHome = !inHome;
                    if (team.CanModify)
                    {
                        <DesktopEditableTeam Inverted="team.Inverted" Players="team.Players" SaveTeam="SaveAsync"></DesktopEditableTeam>
                    }
                    else
                    {
                        <DesktopGame Inverted="team.Inverted" Players="leagueCalculator?.GetRightFormation(team.Players)"></DesktopGame>
                    }
                }
            }
        </div>
    }
    else
    {
        <div class="fieldMobile">
            @if (game != null)
            {
                <ResultCard Css="gameResultMobile animOpacity" Game="game"></ResultCard>
            }
            @if (teams != null)
            {
                <div class="gameContainerMobile">
                    @foreach (var team in teams)
                    {
                        if (team.CanModify)
                        {
                            <MobileEditableTeam SaveTeam="SaveAsync" Players="team.Players" Css="playerContainerMobile" From="FantaSoccerRole.GoalKeeper" To="FantaSoccerRole.Forward" Inverted="team.Inverted"></MobileEditableTeam>
                        }
                        else
                        {
                            <MobileGame Css="playerContainerMobile" Players="leagueCalculator?.GetRightFormation(team.Players)" From="FantaSoccerRole.GoalKeeper" To="FantaSoccerRole.Forward" Inverted="team.Inverted"></MobileGame>
                        }
                    }
                </div>
                var counter = 0;
                @foreach (var team in teams)
                {
                    if (team.CanModify)
                    {
                        <MobileEditableTeam SaveTeam="SaveAsync" Players="team.Players" Css="@($"playerContainerMobile50-{counter}")" From="FantaSoccerRole.BackupGoalKeeper" To="FantaSoccerRole.SecondBackupForward" Inverted="false"></MobileEditableTeam>
                    }
                    else
                    {
                        <MobileGame Css="@($"playerContainerMobile50-{counter}")" Players="leagueCalculator?.GetRightFormation(team.Players)" From="FantaSoccerRole.BackupGoalKeeper" To="FantaSoccerRole.SecondBackupForward" Inverted="false"></MobileGame>
                    }
                    counter++;
                }
                @foreach (var team in teams)
                {
                    if (team.CanModify)
                    {
                        <MobileEditableTeam SaveTeam="SaveAsync" Players="team.Players" Css="playerContainerMobileTribune" From="FantaSoccerRole.Tribune" To="FantaSoccerRole.Tribune" Inverted="false"></MobileEditableTeam>
                    }
                }
            }
        </div>
    }
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private CalendarGame? game;
    private List<TeamsWrapper>? teams;
    [Parameter]
    public string? GroupId { get; set; }
    [Parameter]
    public string? LeagueId { get; set; }
    [Parameter]
    public string? GameId { get; set; }
    [Parameter]
    public int? Year { get; set; }
    [Inject]
    public required ITeamCalculator TeamCalculator { get; set; }
    [Inject]
    public required IFactory<ILeagueCalculator> LeagueCalculatorFactory { get; set; }
    private ILeagueCalculator? leagueCalculator;
    private int serieADay;
    private bool isInEdit => GameId == null;
    private Team? myTeam;
    private League? selectedLeague;
    private bool isMobile;
    private DateTime lastUpdateHome = DateTime.MinValue;
    private DateTime lastUpdateAway = DateTime.MinValue;

    private sealed class TeamsWrapper
    {
        public required IEnumerable<EnrichedPlayer> Players { get; set; }
        public bool CanModify { get; set; }
        public required bool Inverted { get; set; }
        public required DateTime LastUpdate { get; set; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            var leagueKey = State.LeagueKey;
            var year = Year ?? State.Year;
            selectedLeague = State.SelectedLeague;
            if (!isInEdit)
            {
                if (State.GroupId != GroupId)
                {
                    await State.ChangeGroupAsync(GroupId);
                }
                leagueKey = new LeagueKey { Group = GroupId, League = LeagueId, Year = year };
                selectedLeague = State.SelectedGroup?.Leagues.Find(x => x.Id == LeagueId);
            }
            var leagueSettings = selectedLeague?.Years.Find(x => x.Year == year)?.Settings;
            leagueCalculator = LeagueCalculatorFactory.Create(selectedLeague?.GetAnnualType(year).ToString());
            LoadingIndicator?.Show();
            isMobile = await UiUtilityService.IsMobileAsync();
            game = null;
            teams = null;
            myTeam = null;
            var calendar = await Api.Calendar.GetAsync(leagueKey);
            serieADay = 0;
            if (GameId != null && calendar != null)
            {
                Check();

                void Check()
                {
                    foreach (var round in calendar.Rounds)
                    {
                        foreach (var day in round.Value)
                        {
                            foreach (var game in day.Games)
                            {
                                if (game.Id == GameId)
                                {
                                    this.game = game;
                                    serieADay = day.SerieADay;
                                    return;
                                }
                            }
                        }
                    }
                }
            }
            await TeamCalculator.BuildRequestAsync(year, serieADay, selectedLeague!.GetAnnualType(year), leagueSettings!, true, !isInEdit, true);
            serieADay = TeamCalculator.SerieADay;
            if (game == null && calendar != null)
            {
                myTeam = await Api.Team.GetAsync(State.TeamKey);
                if (myTeam != null)
                    game = calendar.Rounds.SelectMany(x => x.Value).Where(x => x.SerieADay == serieADay).SelectMany(x => x.Games).FirstOrDefault(x => x.Home == myTeam.Name || x.Away == myTeam.Name);
            }
            if (game != null)
            {
                var teams = new List<TeamsWrapper>();
                var counter = 0;
                foreach (var owner in GetOwners())
                {
                    var isMyTeam = myTeam != null && myTeam.Owner == owner;
                    var team = isMyTeam ? myTeam
                         : await Api.DailyTeam.GetAsync(State.TeamDayKey(serieADay, owner, year));
                    teams.Add(new TeamsWrapper
                        {
                            CanModify = isMyTeam && isInEdit,
                            Inverted = counter == 1,
                            Players = team != null ? TeamCalculator.Enrich(team.ActivePlayers) : Array.Empty<EnrichedPlayer>(),
                            LastUpdate = team?.LastUpdate ?? DateTime.MinValue
                        });
                    counter++;
                }
                if (!isInEdit && game.Result == null)
                {
                    game.Result = new()
                        {
                            Home = TeamCalculator.CalculatePoint(teams[0].Players),
                            Away = TeamCalculator.CalculatePoint(teams[1].Players)
                        };
                    if (TeamCalculator.LeagueSetting != null)
                        game.Result.CalculateGoals(TeamCalculator.LeagueSetting);
                }
                this.teams = teams;
                IEnumerable<string> GetOwners()
                {
                    yield return game.HomeOwner;
                    yield return game.AwayOwner;
                }
            }
            else if (isInEdit)
            {
                var teams = new List<TeamsWrapper>();
                myTeam = await Api.Team.GetAsync(State.TeamKey);
                if (myTeam != null)
                    teams.Add(new TeamsWrapper
                        {
                            CanModify = true,
                            Inverted = false,
                            Players = TeamCalculator.Enrich(myTeam.ActivePlayers),
                            LastUpdate = myTeam.LastUpdate
                        });
                this.teams = teams;
            }
        }
        await base.OnParametersSetAsync();
    }
    private string? message;
    public async ValueTask SaveAsync()
    {
        if (State != null && TeamCalculator?.IsEditable == true && myTeam != null)
        {
            var key = State.TeamDayKey(TeamCalculator.SerieADay);
            var state = await Api.DailyTeam.ExistAsync(key) ?
                await Api.DailyTeam.UpdateAsync(key, myTeam) :
                await Api.DailyTeam.InsertAsync(key, myTeam);
            if (state.IsOk)
            {
                var isOk = await Api.Team.UpdateAsync(State.TeamKey, myTeam);
                state.IsOk = isOk;
                if (!isOk)
                    state.Message = "Errore salvataggio team";
            }
            if (state.IsOk)
            {
                ToastService.ShowSuccess("Formazione salvata correttamente.");
                StateHasChanged();
            }
            else
            {
                if (!isMobile)
                    ToastService.ShowError("Errore durante il savaltaggio della formazione.");
            }
        }
        else
        {
            if (!isMobile)
                ToastService.ShowError("Errore nell'insieme dei numeri immaginari.");
        }
    }
}

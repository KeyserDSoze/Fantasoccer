@page "/nottaken"
@using Fantasoccer.Domain;

<PageTitle>All players</PageTitle>

@if (players != null)
{
    <StatPlayersDownloadButton StatPlayers="players" Name="Non presi" WithPrice="false"></StatPlayersDownloadButton>
    <FluentTabs @bind-ActiveTabId="currentRole">
        @foreach (var playersByRole in players.GroupBy(x => x.Role).OrderBy(x => x.Key))
        {
            <FluentTab Label="@playersByRole.Key.ToString()" Id="@playersByRole.Key.ToString()">
                @if (currentRole == playersByRole.Key.ToString())
                {
                    <PlayersView StatPlayers="playersByRole" Key="@currentRole"></PlayersView>
                }
            </FluentTab>
        }
    </FluentTabs>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private IEnumerable<StatPlayer>? players;
    private string currentRole = "GoalKeeper";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var playersWrapper = await Api.StatsPlayers.GetAsync(State.Year);
            if (playersWrapper != null && State.Teams != null)
            {
                var allPlayersWrapper = await Api.RealPlayers.GetAsync(State.Year);
                foreach (var player in allPlayersWrapper.Players)
                {
                    if (!playersWrapper.Players.Any(p => p.Key == player.Key))
                    {
                        playersWrapper.Players.Add(new StatPlayer { Name = player.Name, RealTeam = player.RealTeam, Role = player.Role, IsActive = player.IsActive });
                    }
                }
                foreach (var team in State.Teams)
                {
                    var teamKey = State.OtherTeamKey(team.Owner);
                    var actualTeam = await Api.Team.GetAsync(teamKey);
                    if (actualTeam == null)
                    {
                        actualTeam = new() { Name = team.Name, Owner = team.Owner, Players = new() };
                        await Api.Team.InsertAsync(teamKey, actualTeam);
                    }
                    foreach (var player in actualTeam.ActivePlayers)
                    {
                        var playerKey = player.Key;
                        var toRemovePlayer = playersWrapper.Players.FirstOrDefault(x => x.Key == playerKey);
                        if (toRemovePlayer != null)
                        {
                            playersWrapper.Players.Remove(toRemovePlayer);
                        }
                    }
                }
                players = playersWrapper.Players.Where(x => x.IsActive);
            }
        }
        await base.OnParametersSetAsync();
    }
}
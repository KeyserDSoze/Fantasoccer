@page "/allplayers"
@using Fantasoccer.Domain;

<PageTitle>All players</PageTitle>

@if (players != null)
{
    <FluentTabs @bind-ActiveTabId="roleToShow">
        @foreach (var playersByRole in players.GroupBy(x => x.Role).OrderBy(x => x.Key))
        {
            <FluentTab Label="@playersByRole.Key.ToString()" Id="@playersByRole.Key.ToString()">
                @if (roleToShow == playersByRole.Key.ToString())
                {
                    <PlayersView StatPlayers="playersByRole" Key="@roleToShow"></PlayersView>
                }
            </FluentTab>
        }
    </FluentTabs>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private IEnumerable<StatPlayer>? players;
    private string roleToShow = "GoalKeeper";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var playersWrapper = await Api.StatsPlayers.GetAsync(State.Year);
            if (playersWrapper != null)
            {
                players = playersWrapper.Players;
                if (players != null)
                {
                }
            }
        }
        await base.OnParametersSetAsync();
    }
}
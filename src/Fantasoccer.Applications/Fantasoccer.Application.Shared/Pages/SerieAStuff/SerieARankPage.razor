@page "/seriearank"

<PageTitle>Calendar</PageTitle>

@if (rank != null)
{
    <SerieARanking Teams="rank.Teams" WithFluentSize=true></SerieARanking>
}
@if (isVisible)
{
    <h4>Not Found</h4>
    <p>@nullRank</p>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }

    private RealRank? rank;
    private string? nullRank;
    private bool isVisible => nullRank != null;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        nullRank = null;
        if (State != null)
        {
            LoadingIndicator?.Show();
            rank = await Api.RealRank.GetAsync(State.Year);
            if (rank == null)
                nullRank = $"Classifica non presente per l'anno {FantacalcioTime.LabelYear(State.Year)}.";
        }
        await base.OnParametersSetAsync();
    }
}
@page "/market"
<h3>Mercato</h3>
@if (market != null)
{
    <FluentGrid Spacing="0" AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
        @foreach (var exchange in market.Markets.Where(x => x.Status == MarketStatus.Pending))
        {
            <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
                <h3>Compratore: @GetTeamName(exchange.Buyer)</h3>
                <FluentNumberField Disabled @bind-Value="exchange.MoneyFromBuyer" Label="Prezzo pagato" Min="0" Max="1000" />
                <PlayersView Players="exchange.BuyerPlayers"></PlayersView>
            </FluentGridItem>
            <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
                <h3>Venditore: @GetTeamName(exchange.Seller)</h3>
                <FluentNumberField Disabled @bind-Value="exchange.MoneyFromSeller" Label="Soldi in scambio" Min="0" Max="1000" />
                <PlayersView Players="exchange.SellerPlayers"></PlayersView>
            </FluentGridItem>
            <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
                @foreach (var approver in exchange.Approvers)
                {
                    <h3>Approvato da: @GetTeamName(approver)</h3>
                }
                @if (CanVote())
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="() => ApproveAsync(exchange.Id)">Accetta</FluentButton>
                }
            </FluentGridItem>
            <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
                @foreach (var approver in exchange.Deniers)
                {
                    <h3>Negato da: @GetTeamName(approver)</h3>
                }
                @if (CanVote())
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="() => DenyAsync(exchange.Id)">Nega</FluentButton>
                }
            </FluentGridItem>
        }
    </FluentGrid>
}
else
{
    <h4>Mercato non disponibile</h4>
    <p>Impossibile fare scambi nella lega o nell'anno che hai selezionato</p>
}

@code {
    [CascadingParameter]
    public FantasoccerState? State { get; set; }
    private MarketWrapper? market;
    private List<AnnualTeam>? teams;

    protected override async Task OnParametersSetAsync()
    {
        if (State != null && State.Year == FantacalcioTime.ActualYear && State.SelectedLeague.IsMain && State.SelectedLeagueSettings.Market != MarketType.Denied)
        {
            market = await Api.Market.GetAsync(State.LeagueKey);
            if (market == null)
            {
                market = new MarketWrapper { Markets = new() };
                await Api.Market.InsertAsync(State.LeagueKey, market);
            }
            teams = State.SelectedBaskets.SelectMany(x => x.Years).Where(x => x.Year == State.Year).SelectMany(x => x.Teams).ToList();
        }
        await base.OnParametersSetAsync();
    }
    private string GetTeamName(string owner)
    {
        return teams?.FirstOrDefault(x => x.Owner == owner)?.Name ?? string.Empty;
    }
    private bool CanVote()
        => teams.Any(x => x.Owner == State!.Identity!.Email);
    private async ValueTask CheckIfEnds(Market exchange)
    {
        if (exchange.Approvers.Count >= teams.Count / 2 + 1)
        {
            exchange.Status = MarketStatus.Approved;
            var buyerTeamKey = State.OtherTeamKey(exchange.Buyer);
            var sellerTeamKey = State.OtherTeamKey(exchange.Seller);
            var buyerTeam = await Api.Team.GetAsync(buyerTeamKey);
            var sellerTeam = await Api.Team.GetAsync(sellerTeamKey);
            if (buyerTeam.TotalCostForPlayers + exchange.MoneyFromBuyer > State.SelectedLeagueSettings.StartingMoney)
            {
                exchange.Status = MarketStatus.NoMoney;
                return;
            }
            if (sellerTeam.TotalCostForPlayers + exchange.MoneyFromSeller > State.SelectedLeagueSettings.StartingMoney)
            {
                exchange.Status = MarketStatus.NoMoney;
                return;
            }
            foreach (var player in exchange.BuyerPlayers)
            {
                var actualPlayer = buyerTeam.ActivePlayers.FirstOrDefault(x => x.Key == player.Key);
                if (actualPlayer == null)
                {
                    exchange.Status = MarketStatus.NoPlayers;
                    return;
                }
                actualPlayer.Status = PlayerInTeamStatus.Sold;
                sellerTeam.Players.Add(player);
            }
            foreach (var player in exchange.SellerPlayers)
            {
                var actualPlayer = sellerTeam.ActivePlayers.FirstOrDefault(x => x.Key == player.Key);
                if (actualPlayer == null)
                {
                    exchange.Status = MarketStatus.NoPlayers;
                    return;
                }
                actualPlayer.Status = PlayerInTeamStatus.Sold;
                buyerTeam.Players.Add(player);
            }
            await Api.Team.UpdateAsync(buyerTeamKey, buyerTeam);
            await Api.Team.UpdateAsync(sellerTeamKey, sellerTeam);
        }
        else if (exchange.Deniers.Count >= teams.Count / 2 + 1)
        {
            exchange.Status = MarketStatus.Denied;
        }
    }
    private async Task DenyAsync(string id)
    {
        if (market != null && CanVote())
        {
            var exchange = market.Markets.FirstOrDefault(x => x.Id == id);
            if (exchange != null)
            {
                var voter = State!.Identity!.Email;
                exchange.Approvers.Remove(voter);
                exchange.Deniers.Add(voter);
                if (voter == exchange.Buyer)
                {
                    exchange.Status = MarketStatus.Cancelled;
                }
                else if (voter == exchange.Seller)
                {
                    exchange.Status = MarketStatus.Denied;
                }
                else
                {
                    await CheckIfEnds(exchange);
                }
                await Api.Market.UpdateAsync(State.LeagueKey, market);
                ToastService.ShowEvent($"Hai votato. Status: {exchange.Status}");
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    private async Task ApproveAsync(string id)
    {
        if (market != null && CanVote())
        {
            var exchange = market.Markets.FirstOrDefault(x => x.Id == id);
            if (exchange != null)
            {
                exchange.Approvers.Add(State!.Identity!.Email);
                await CheckIfEnds(exchange);
                await Api.Market.UpdateAsync(State.LeagueKey, market);
            }
        }
    }
}


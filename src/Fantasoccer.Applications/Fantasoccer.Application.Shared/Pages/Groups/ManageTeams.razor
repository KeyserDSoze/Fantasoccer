@page "/manageteams"
@using Fantasoccer.Domain;
@using System.Text

<PageTitle>Manage teams</PageTitle>
@if (State?.IsAdmin() == true && players != null && teams != null && State.SelectedLeague.IsMain)
{
    <FluentGrid Spacing="0">
        <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
            <FluentTabs @bind-ActiveTabId=selectedTab>
                @foreach (var role in Roles)
                {
                    <FluentTab Id="@role.ToString()" Label="@role.ToString()">
                        <FluentDataGrid TGridItem="StatPlayer"
                        Items="players.Where(x => x.Role == role && x.IsActive).Select(x => GetStatPlayer(x)).AsQueryable()"
                        OnRowClick="PlayerClicked">
                            <TemplateColumn Title="Nome">
                                @if (context.Visible)
                                {
                                    @:@context.Name
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Squadra">
                                @if (context.Visible)
                                {
                                    @:@context.RealTeam.Name
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Media Voti">
                                @if (context.Visible)
                                {
                                    @:@context.FantaAverage.ToString("N2")
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Media Voti">
                                @if (context.Visible)
                                {
                                    @:@context.FantaAverage.ToString("N2")
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Media Voti">
                                @if (context.Visible)
                                {
                                    @:@context.Average.ToString("N2")
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="FantaMedia">
                                @if (context.Visible)
                                {
                                    @:@context.FantaAverage.ToString("N2")
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Voti presi">
                                @if (context.Visible)
                                {
                                    @:@context.WithVote
                                }
                                else
                                {
                                    @:---
                                }
                            </TemplateColumn>
                        </FluentDataGrid>
                    </FluentTab>
                }
            </FluentTabs>
        </FluentGridItem>
        <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
            <FluentAccordion @bind-ActiveId="activeTeamId">
                @foreach (var team in teams)
                {
                    <FluentAccordionItem Id="@team.Owner" Heading="@(GetHeadingTeam(team))">
                        <FluentDataGrid TGridItem="Player"
                        Items="team.ActivePlayers.OrderBy(x => x.Role).ThenBy(x => x.Name).AsQueryable()"
                        OnRowClick="(x) => Remove(x.Item!, team.Owner)">
                            <PropertyColumn Property="@(x => x.Name)" Title="Nome" />
                            <PropertyColumn Property="@(x => x.RealTeam.Name)" Title="Team" />
                            <PropertyColumn Property="@(x => x.Price)" Title="Prezzo" />
                            <PropertyColumn Property="@(x => x.Role)" Title="Ruolo" />
                        </FluentDataGrid>
                    </FluentAccordionItem>
                }
            </FluentAccordion>

        </FluentGridItem>
    </FluentGrid>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private List<RealPlayer>? allPlayers;
    private List<RealPlayer>? players;
    private List<Team>? teams;
    private string? activeTeamId;
    private string selectedTab = Roles.First().ToString();
    private static readonly List<Role> Roles = new()
    {
        Role.GoalKeeper,
        Role.Defensor,
        Role.Midfielder,
        Role.Forward
    };
    private RealPlayer? realPlayer;
    private List<StatPlayer>? statsPlayers;
    private List<ChancedRealPlayer>? chances;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    private string GetHeadingTeam(Team team)
    {
        StringBuilder stringBuilder = new();
        stringBuilder.Append(team.Name);
        stringBuilder.Append($" ({team.Owner})");
        stringBuilder.Append($" {State.SelectedLeagueSettings!.StartingMoney - team.Cost + team.MoneyFromRank + team.RevenueMoney}");
        stringBuilder.Append($"[{team.ActivePlayers.Count(x => x.Role == Role.GoalKeeper)}-");
        stringBuilder.Append($"{team.ActivePlayers.Count(x => x.Role == Role.Defensor)}-");
        stringBuilder.Append($"{team.ActivePlayers.Count(x => x.Role == Role.Midfielder)}-");
        stringBuilder.Append($"{team.ActivePlayers.Count(x => x.Role == Role.Forward)}]");
        stringBuilder.Append($" [{team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.GoalKeeper)}-");
        stringBuilder.Append($" [{team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.Defensor)}-");
        stringBuilder.Append($" [{team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.Midfielder)}-");
        stringBuilder.Append($" [{team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count(x => x.Role == Role.Forward)}");
        stringBuilder.Append($"= {team.ActivePlayers.Distinct(x => x.RealTeam.Name).Count()}]");
        return stringBuilder.ToString();
    }
    private Task PlayerClicked(FluentDataGridRow<StatPlayer> row)
    {
        if (row.Item.Visible)
        {
            return Buy(row.Item);
        }
        else
        {
            return ShowTheNextPlayerAsync(row.Item);
        }
    }
    private async Task ShowTheNextPlayerAsync(RealPlayer? clickedPlayer = null)
    {
        if (players != null && State != null)
        {
            foreach (var player in players.OrderBy(x => x.Role))
            {
                if (!player.Visible || (clickedPlayer != null && clickedPlayer.Key == player.Key))
                {
                    player.Visible = true;
                    clickedPlayer.Visible = true;
                    await Api.RandomizedRealPlayers.UpdateAsync(State.LeagueKey, new RealPlayersWrapper { Players = players });
                    break;
                }
            }
            await InvokeAsync(StateHasChanged);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (State?.Teams != null && State?.IsAdmin() == true)
        {
            LoadingIndicator?.Show();
            teams = new();

            var allPlayersWrapper = State.SelectedLeagueSettings?.RandomAuction == true ?
                await Api.RandomizedRealPlayers.GetAsync(State.LeagueKey) :
                await Api.RealPlayers.GetAsync(State.Year);
            if (allPlayersWrapper?.Players != null)
            {
                allPlayers = State.SelectedLeagueSettings?.RandomAuction == true ?
                    allPlayersWrapper.Players.OrderBy(x => x.Role).ToList() :
                    allPlayersWrapper.Players.OrderBy(x => x.Role).ThenBy(x => x.Name).ToList();
                var rank = await Api.Ranks.GetAsync(State.LeagueKey);
                foreach (var team in State.Teams)
                {
                    var teamKey = State.OtherTeamKey(team.Owner);
                    var actualTeam = await Api.Team.GetAsync(teamKey);
                    if (actualTeam == null)
                    {
                        actualTeam = new() { Name = team.Name, Owner = team.Owner, Players = new() };
                        await Api.Team.InsertAsync(teamKey, actualTeam);
                    }
                    teams.Add(actualTeam);
                    actualTeam.MoneyFromRank = rank.RankedTeams.SelectMany(x => x.Value).First(x => x.Owner == team.Owner).PlusMoney;
                    foreach (var player in actualTeam.ActivePlayers)
                    {
                        var playerKey = player.Key;
                        var toRemovePlayer = allPlayers.FirstOrDefault(x => x.Key == playerKey);
                        if (toRemovePlayer != null)
                        {
                            allPlayers.Remove(toRemovePlayer);
                        }
                    }
                }
                players = allPlayers.Where(x => x.IsActive).ToList();
                var playersWrapper = await Api.StatsPlayers.GetAsync(State.Year);
                statsPlayers = playersWrapper?.Players;
                var calendar = await Api.RealCalendar.GetAsync(FantacalcioTime.ActualYear);
                chances = (await Api.Chances.GetAsync(State.YearDayKey(calendar?.NextDay?.SerieADay ?? calendar?.LiveDay?.SerieADay ?? 3)))?.Players;
            }
        }
        await base.OnParametersSetAsync();
    }
    private StatPlayer? GetStatPlayer(RealPlayer player)
    {
        if (statsPlayers != null)
        {
            var playerKey = player.Key;
            var statPlayer = statsPlayers.FirstOrDefault(x => x.Key == playerKey);
            if (statPlayer == null)
            {
                statPlayer = new StatPlayer
                    {
                        Name = player.Name,
                        RealTeam = player.RealTeam,
                        Role = player.Role,
                        IsActive = player.IsActive,
                        Visible = player.Visible
                    };
            }
            else if (!player.Visible)
                statPlayer.Visible = false;
            return statPlayer;
        }
        return null;
    }
    private ChancedRealPlayer? GetChancePlayer(RealPlayer player)
    {
        if (chances != null)
        {
            var playerKey = player.Key;
            var chancePlayer = chances.FirstOrDefault(x => x.Key == playerKey);
            return chancePlayer;
        }
        return null;
    }

    private async Task Buy(RealPlayer player)
    {
        realPlayer = player;
        DialogParameters parameters = new()
            {
                Title = $"Buy player",
                PrimaryAction = "Confirm",
                PrimaryActionEnabled = true,
                Width = "500px",
                TrapFocus = true,
                Modal = true,
                PreventScroll = true
            };
        IDialogReference dialog = await DialogService.ShowDialogAsync<BuyModal>(new BuyPlayerModalModel
            {
                Player = player,
                Price = 1,
                Teams = teams,
                Team = teams.First()
            }, parameters);
        DialogResult? result = await dialog.Result;
        if (result?.Cancelled == false && result?.Data is BuyPlayerModalModel buying)
        {
            if (buying.Player != null && buying.Team != null)
            {
                var team = buying.Team;
                if (Check(buying.Player, team, buying.Price))
                {
                    team.Players.Add(new Player
                        {
                            IsActive = true,
                            Name = realPlayer.Name,
                            RealTeam = realPlayer.RealTeam,
                            Price = buying.Price,
                            Role = realPlayer.Role,
                            Status = PlayerInTeamStatus.Active,
                            Position = FantaSoccerRole.Tribune
                        });
                    await Api.Team.UpdateAsync(State.OtherTeamKey(team.Owner), team);
                    players.Remove(realPlayer);
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.ShowError("Non acquistabile");
                }
                activeTeamId = team.Owner;
            }
        }
    }

    private bool Check(RealPlayer realPlayer, Team team, int price)
    {
        switch (realPlayer.Role)
        {
            case Role.GoalKeeper:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 3)
                {
                    ToastService.ShowError("Troppi portieri");
                    return false;
                }
                break;
            case Role.Defensor:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 8)
                {
                    ToastService.ShowError("Troppi difensori");
                    return false;
                }
                break;
            case Role.Midfielder:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 8)
                {
                    ToastService.ShowError("Troppi centrocampisti");
                    return false;
                }
                break;
            case Role.Forward:
                if (team.ActivePlayers.Count(x => x.Role == realPlayer.Role) >= 6)
                {
                    ToastService.ShowError("Troppi attaccanti");
                    return false;
                }
                break;
        }
        if (State.SelectedLeagueSettings.StartingMoney - (team.Cost + price + (25 - 1 - team.ActivePlayers.Count())) < 0)
        {
            ToastService.ShowError("Stai spendendo troppi soldi");
            return false;
        }
        return true;
    }

    private async Task Remove(Player player, string owner)
    {
        var playerKey = player.Key;
        realPlayer = allPlayers.FirstOrDefault(x => x.Key == playerKey);
        DialogParameters parameters = new()
            {
                Title = $"Remove player",
                PrimaryAction = "Confirm",
                PrimaryActionEnabled = true,
                Width = "500px",
                TrapFocus = true,
                Modal = true,
                PreventScroll = true
            };
        IDialogReference dialog = await DialogService.ShowDialogAsync<RemoveModal>(new CancelPlayerModalModel
            {
                Owner = owner,
                Player = player,
                Price = player.Price,
                Status = PlayerInTeamStatus.Removed
            }, parameters);
        DialogResult? result = await dialog.Result;
        if (result?.Cancelled == false && result?.Data is CancelPlayerModalModel cancellation)
        {
            var team = teams.FirstOrDefault(x => x.Owner == cancellation.Owner);
            player.Status = cancellation.Status;
            if (player.Status == PlayerInTeamStatus.Removed)
                team.Players.Remove(player);
            await Api.Team.UpdateAsync(State.OtherTeamKey(cancellation.Owner), team);
            activeTeamId = cancellation.Owner;
            if (player.IsActive)
                players.Add(player);
            await InvokeAsync(StateHasChanged);
        }
    }
}
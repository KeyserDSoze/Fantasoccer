@page "/calendar/{Value?}"

<PageTitle>Calendar</PageTitle>

@if (calendar != null)
{
    if (!onlyOne)
    {
        <FluentTabs @bind-ActiveTabId="selectedTab">
            @foreach (var calendarByRound in calendar.Rounds)
            {
                var tabId = $"tab-{calendarByRound.Key}";
                if (tabId == tabWithAt)
                    tabId = tabStart;
                <FluentTab Label="@calendarByRound.Key" Id="@tabId">
                    <Calendaring IsAdminEdit=adminMode Days="calendarByRound.Value" WithFluentSize=true GroupId="@State.GroupId" LeagueId="@State.LeagueId" Year="@State.Year"></Calendaring>
                </FluentTab>
            }
        </FluentTabs>
    }
    else
    {
        <Calendaring IsAdminEdit=adminMode Days="calendar.Rounds.First().Value" WithFluentSize=true GroupId="@State.GroupId" LeagueId="@State.LeagueId" Year="@State.Year"></Calendaring>
    }
}
@if (isVisible)
{
    <h4>Not Found</h4>
    <p>@nullCalendar</p>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public string? Value { get; set; }
    private Calendar? calendar;
    private RankedTeam? selectedTeam;
    private string? selectedTab;
    private string? nullCalendar;
    private bool onlyOne;
    private bool isVisible => nullCalendar != null;
    private bool adminMode;
    private const string tabStart = "tab-start";
    private const string tabWithAt = "tab-@";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
    protected override async Task OnParametersSetAsync()
    {
        nullCalendar = null;
        if (State != null)
        {
            LoadingIndicator?.Show();
            if (Value == "edit" && State.IsAdmin())
            {
                adminMode = true;
            }
            calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            if (calendar != null && calendar.Rounds.Count > 0)
            {
                selectedTab = $"tab_{calendar.Rounds.First().Key}";
                if (selectedTab == tabWithAt)
                    selectedTab = tabStart;
                onlyOne = calendar.Rounds.Count == 1;
            }
            else
                nullCalendar = $"Calendario non presente per l'anno {FantacalcioTime.LabelYear(State.Year)}.";
        }
        await base.OnParametersSetAsync();
    }
}
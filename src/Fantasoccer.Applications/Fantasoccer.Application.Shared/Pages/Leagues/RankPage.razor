@page "/rank"

<PageTitle>Rank</PageTitle>

@if (rank != null && selectedTab != null)
{
    if (!onlyOne)
    {
        <FluentTabs @bind-ActiveTabId="@selectedTab">
            @foreach (var rankByRound in rank.RankedTeams)
            {
                var tabId = $"tab-{rankByRound.Key}";
                if (tabId == tabWithAt)
                    tabId = tabStart;
                <FluentTab Label="@rankByRound.Key" Id="@tabId">
                    <Ranking Teams="rankByRound.Value"></Ranking>
                </FluentTab>
            }
        </FluentTabs>
    }
    else
    {
        <Ranking Teams="rank.RankedTeams.First().Value"></Ranking>
    }
}
@if (isVisible)
{
    <h4>Not Found</h4>
    <p>@nullRank</p>
}

@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private Rank? rank;
    private RankedTeam? selectedTeam;
    private string? selectedTab;
    private string? nullRank;
    private bool onlyOne;
    private bool isVisible => nullRank != null;
    private const string tabStart = "tab-start";
    private const string tabWithAt = "tab-@";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        nullRank = null;
        if (State?.HasAGroup == true)
        {
            LoadingIndicator?.Show();
            rank = await Api.Ranks.GetAsync(State.LeagueKey);
            if (rank != null && rank.RankedTeams.Count > 0)
            {
                onlyOne = rank.RankedTeams.Count == 1;
                selectedTab = $"tab-{rank.RankedTeams.First().Key}";
                if (selectedTab == tabWithAt)
                    selectedTab = tabStart;
            }
            else
                nullRank = $"Classifica non presente per l'anno {FantacalcioTime.LabelYear(State.Year)}.";
        }
        await base.OnParametersSetAsync();
    }
}
@implements IDialogContentComponent<string>

<FluentMessageBarProvider Section="Buy Player" MaxMessageCount="1" />
<h1>Il tuo giornalista dice</h1>
<p>@((MarkupString)Content.Replace("```html", string.Empty).Replace("```", string.Empty))</p>

@code {
    [Parameter]
    public required string Content { get; set; }
    [CascadingParameter]
    public FluentDialog? Dialog { get; set; }
    private void ToggleDialogPrimaryActionButton(bool enable)
    {
        Dialog!.TogglePrimaryActionButton(enable);
    }
}
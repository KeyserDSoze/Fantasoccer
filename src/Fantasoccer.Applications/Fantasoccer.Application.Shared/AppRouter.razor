@using Blazored.LocalStorage;
@using Fantasoccer.Application.Shared.Extensions;
@using Microsoft.Identity.Abstractions;
@using Rystem.Authentication.Social
@using Rystem.Authentication.Social.Blazor.Components

<CascadingValue Value="@state">
    <CascadingValue Value="@loadingIndicator">
        <SocialAuthenticationRouter AppAssembly="@typeof(AppRouter).Assembly" DefaultLayout="@typeof(Layouts.MainLayout)" SetUser="OnUserSetAsync" TUser="AppIdentity">
        </SocialAuthenticationRouter>
    </CascadingValue>
</CascadingValue>

@code {
    private FantasoccerState? state;
    private LoadingIndicator loadingIndicator = new();
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
    private async ValueTask OnUserSetAsync(AppIdentity socialUser)
    {
        if (socialUser is AppIdentity identity)
        {
            state = new FantasoccerState()
                {
                    AppUiUpdate = () =>
                    {
                        _ = InvokeAsync(StateHasChanged);
                    },
                    GetGroup = (groupId) =>
                    {
                        try
                        {
                            return Api.Groups.GetAsync(groupId);
                        }
                        catch (Exception ex)
                        {
                            return Task.FromResult(default(Group));
                        }
                    },
                    UpdateState = (identity) =>
                    {
                        try
                        {
                            return Api.AppIdentity.UpdateAsync(identity!.Email, identity);
                        }
                        catch (Exception ex)
                        {
                            return Task.CompletedTask;
                        }
                    }
                };
            await state.SetIdentityAsync(identity);
        }
    }
}

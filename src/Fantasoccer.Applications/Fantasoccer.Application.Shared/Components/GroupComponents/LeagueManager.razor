@using Fantasoccer.Business;
@using System.Security.Cryptography

@if (CanCreateNewGroup)
{
    <FluentGrid Spacing="0" Justify="JustifyContent.Center">
        <FluentGridItem>
            @if (State?.SelectedGroup?.Leagues?.Any() == true)
            {
                <FluentSelect TOption="League"
                              Items="@State.SelectedGroup.Leagues"
                              OptionValue="@(x => x.Id)"
                              OptionText="@(x => x.Name)"
                              Value="@State.LeagueId"
                              SelectedOptionChanged="@(league => _ = OnSelectedLeagueChanged(league))" />
            }
            <FluentTextField @bind-Value=newLeagueName Label="Nome basket"></FluentTextField>
            <FluentButton Appearance="Appearance.Accent" OnClick="@CreateNewLeague">
                Crea nuova lega
            </FluentButton>
        </FluentGridItem>
        @if (State.HasALeague)
        {
            <FluentGridItem>
                <FluentCheckbox @bind-Value="State.SelectedLeague!.IsMain" Label="Is Main" />
                <FluentTextField @bind-Value=State.SelectedLeague.Name Label="Nome lega"></FluentTextField>
                <FluentDataGrid Items="@State.SelectedGroup!.Baskets.AsQueryable()" ShowHover="true" TGridItem="Basket">
                    <SelectColumn TGridItem="Basket"
                                  SelectMode="@DataGridSelectMode.Multiple"
                                  SelectedItemsChanged="ChangeBaskets"
                                  SelectedItems="@State.SelectedBaskets" />
                    <PropertyColumn Property="@(p => p.Id)" Title="Id" />
                    <PropertyColumn Property="@(p => p.Name)" Title="Nome" />
                </FluentDataGrid>
                <FluentSelect TOption="LeagueType"
                              Label="Tipo di lega (default)"
                              Items="@LeagueTypeExtensions.All"
                              OptionText="@(x => x.ToString())"
                              OptionValue="@(x => x.ToString())"
                              SelectedOption="@State.SelectedLeague.Type"
                              SelectedOptionChanged="ChangeLeagueType" />
                <FluentSelect TOption="LeagueType"
                              Label="Tipo di lega (annuale)"
                              Items="@LeagueTypeExtensions.All"
                              OptionText="@(x => x.ToString())"
                              OptionValue="@(x => x.ToString())"
                              SelectedOption="@State.SelectedYearlyLeague.Type"
                              SelectedOptionChanged="ChangeAnnualLeagueType" />
            </FluentGridItem>
            var settings = State?.SelectedYearlyLeague?.Settings;
            if (settings != null)
            {
                <FluentGridItem>
                    <FluentNumberField @bind-Value="settings.StartingMoney" Label="Starting money" Min="500" Max="2000" />
                    <FluentNumberField @bind-Value="settings.DelayedDay" Label="Giornate di ritardo dalla serie A" Min="0" Max="38" />
                    <FluentNumberField @bind-Value="settings.CancelledDay" Label="Giornate iniziali cancellate" Min="0" Max="38" />
                    <FluentNumberField @bind-Value="settings.PointForFirstGoal" Label="Punti minimi per primo goal" Min="56" Max="78" />
                    <FluentNumberField @bind-Value="settings.PointForNextGoal" Label="Punti di differenza per ogni goal" Min="1" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForOwnGoal" Label="Punti di differenza dal primo goal per valere la regola Autogoal" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.DifferencePointForOwnGoal" Label="Punti di differenza con l'avversario per valere la regola Autogoal" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointInHome" Label="Punti aggiuntivi quando si gioca in casa" Min="0" Max="10" />
                    <FluentNumberField @bind-Value="settings.PointForVictory" Label="Punteggio per ogni vittoria" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForDefeat" Label="Punteggio per ogni sconfitta" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForDraw" Label="Punteggio per ogni pareggio" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForStrongDefense" Label="Punteggio per regola Difesa forte (3 difensori)" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForStrongDefense4" Label="Punteggio per regola Difesa forte (4 difensori)" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForStrongDefense5" Label="Punteggio per regola Difesa forte (5 difensori)" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.PointForCleanSheet" Label="Punteggio per regola Portiere imbattuto" Min="0" Max="12" />
                    <FluentNumberField @bind-Value="settings.MoneyForGoal" Label="Soldi aggiuntivi (asta di riparazione) per ogni goal fatto" Min="-12" Max="12" />
                    <FluentNumberField @bind-Value="settings.MoneyForSufferedGoal" Label="Soldi aggiuntivi (asta di riparazione) per ogni goal subito" Min="-12" Max="12" />
                    <FluentCheckbox @bind-Value="settings.RandomAuction" Label="Asta con giocatori randomici" />
                    <FluentCheckbox @bind-Value="settings.RankWithValuePoints" Label="Classifica con punteggio totale e non con punteggio classico" />
                    <FluentSelect TOption="MarketType"
                                  Label="Tipo di mercato"
                                  Items="@MarketTypeExtensions.All"
                                  OptionText="@(x => x.ToString())"
                                  OptionValue="@(x => x.ToString())"
                                  @bind-SelectedOption="@settings.Market" />
                </FluentGridItem>
                foreach (var votesForRole in settings.Votes)
                {
                    var votesSettings = votesForRole.Value;
                    var key = votesForRole.Key == Role.Undefined ? "All" : votesForRole.Key.ToString();
                    <FluentGridItem>
                        <FluentNumberField @bind-Value="votesSettings.Goal" Label="Punti per ogni goal fatto" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.Penalty" Label="Punti per ogni rigore fatto" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.SufferedGoal" Label="Punti per ogni goal subito" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.StoppedPenalty" Label="Punti per ogni rigore parato" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.WrongedPenalty" Label="Punti per ogni rigore sbagliato" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.OwnGoal" Label="Punti per ogni autogoal" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.Assist" Label="Punti per ogni assist" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.YellowCard" Label="Punti per ogni ammonizione" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.RedCard" Label="Punti per ogni espulsione" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.ManOfTheMatch" Label="Punti per essere il miglior giocatore della partita" Min="-12" Max="12" />
                        <FluentNumberField @bind-Value="votesSettings.Injury" Label="Punti per essersi infortunato" Min="-12" Max="12" />
                    </FluentGridItem>
                }
            }
            <FluentGridItem>
                <FluentDivider Orientation="Orientation.Horizontal" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@SaveAsync">
                    Salva
                </FluentButton>
                <FluentDivider Orientation="Orientation.Horizontal" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@(() => RecalculateAsync())">
                    Ricalcola anno
                </FluentButton>
                <FluentDivider Orientation="Orientation.Horizontal" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@(() => RecalculateAsync(true))">
                    Ricalcola ultima giornata
                </FluentButton>
                <FluentDivider Orientation="Orientation.Horizontal" />
                <FluentNumberField @bind-Value="dayToRecalculate" Min="1" Max="38" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@(() => RecalculateAsync(true, true))">
                    Ricalcola giornata precisa
                </FluentButton>
                <FluentDivider Orientation="Orientation.Horizontal" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@((x) => _ = CreateCalendarAndRankAsync())">
                    Create new calendar
                </FluentButton>
                <FluentDivider Orientation="Orientation.Horizontal" />
                <FluentButton Appearance="Appearance.Accent" OnClick="@((x) => _ = RandomizePlayerForAuctionsAsync())">
                    Randomize players for Auction
                </FluentButton>
            </FluentGridItem>
        }
    </FluentGrid>
}
@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    [Parameter]
    public bool CanCreateNewGroup { get; set; }
    [Parameter]
    public required Func<Task> SaveAsync { get; set; }
    private string? newLeagueName { get; set; }
    private int dayToRecalculate = 38;
    protected override Task OnParametersSetAsync()
    {
        if (State?.HasALeague == true && State.SelectedYearlyLeague == null)
        {
            if (State.SelectedLeague!.Years == null)
                State.SelectedLeague.BasketsId = new();
        }
        return base.OnParametersSetAsync();
    }
    private async Task CreateNewLeague()
    {
        if (State?.IsAuthenticated == true && newLeagueName != null && State.HasAGroup)
        {
            LoadingIndicator?.Show();
            var leagueId = Guid.NewGuid().ToString();
            var league = new League
                {
                    Id = leagueId,
                    IsMain = true,
                    Type = LeagueType.League,
                    BasketsId = new(),
                    Name = newLeagueName,
                };
            State.SelectedGroup!.Leagues.Add(league);
            await Api.Groups.UpdateAsync(State.SelectedGroup.Id, State.SelectedGroup);
            await State.ChangeLeagueAsync(leagueId);
            LoadingIndicator?.Hide();
        }
    }
    private async ValueTask OnSelectedLeagueChanged(League league)
    {
        if (State?.IsAuthenticated == true && State.SelectedGroup != null && league != null)
        {
            LoadingIndicator?.Show();
            await State.ChangeLeagueAsync(league.Id);
            if (State?.SelectedYearlyLeague == null)
            {
                if (State.SelectedLeague?.BasketsId == null)
                    State.SelectedLeague.BasketsId = new();
            }
            LoadingIndicator?.Hide();
        }
    }
    [Inject]
    public required IFactory<ILeagueCalculator> LeagueCalculatorFactory { get; set; }
    [Inject]
    public required IRankCalculator RankCalculator { get; set; }
    [Inject]
    public required ITeamCalculator TeamCalculator { get; set; }
    private async ValueTask CreateCalendarAndRankAsync()
    {
        if (State?.SelectedYearlyLeague != null && State?.SelectedLeague != null && State.Teams != null)
        {
            LoadingIndicator?.Show();
            var leagueCalculator = LeagueCalculatorFactory.Create(State.SelectedLeague.GetAnnualType(State.Year).ToString())!;
            var calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            //todo check if not exists and doesn't start it
            if (calendar == null || calendar != null)
            {
                var teams = State.Teams.ToList();
                if (State.SelectedLeague.GetAnnualType(State.Year) == LeagueType.Cup)
                {
                    var worthTeams = new List<AnnualTeam>();
                    if (State.SelectedGroup != null)
                    {
                        foreach (var mainLeague in State.SelectedGroup.Leagues.Where(x => x.IsMain))
                        {
                            var lastYear = mainLeague.Years.OrderByDescending(x => x.Year).Skip(1).FirstOrDefault();
                            if (lastYear != null)
                            {
                                var lastRank = await Api.Ranks.GetAsync(new LeagueKey()
                                    {
                                        Group = State.GroupId!,
                                        League = mainLeague.Id,
                                        Year = lastYear.Year
                                    });
                                if (lastRank != null)
                                {
                                    var firstEight = lastRank.RankedTeams.SelectMany(x => x.Value).OrderByDescending(x => x.Point).Take(8).ToList();
                                    foreach (var team in teams)
                                    {
                                        if (firstEight.Any(x => x.Owner == team.Owner))
                                        {
                                            worthTeams.Add(team);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    foreach (var worthedTeam in worthTeams)
                    {
                        teams.Remove(worthedTeam);
                    }
                    if (worthTeams.Count < 16)
                    {
                        worthTeams.AddRange(Randomize(teams).Take(16 - worthTeams.Count));
                    }
                    teams = worthTeams;

                    List<AnnualTeam> Randomize(List<AnnualTeam> teams)
                    {
                        var teamsToAdd = new List<AnnualTeam>();
                        foreach (var team in teams)
                            teamsToAdd.Add(team);
                        List<AnnualTeam> randomizedTeams = new();
                        while (teamsToAdd.Count > 0)
                        {
                            var team = teamsToAdd[GetRandom(teamsToAdd.Count)];
                            randomizedTeams.Add(team);
                            teamsToAdd.Remove(team);
                        }
                        return randomizedTeams;
                    }
                    int GetRandom(int max)
                    {
                        var value = RandomNumberGenerator.GetInt32(0, max);
                        if (max == value)
                            return max - 1;
                        return value;
                    }
                }
                calendar = leagueCalculator.GetRandomCalendar(FantacalcioTime.ActualYear, State.SelectedYearlyLeague, teams);
                await Api.Calendar.UpdateAsync(State.LeagueKey, calendar);
            }
            if (calendar != null)
            {
                var rank = leagueCalculator.GetRank(State?.SelectedLeagueSettings ?? LeagueSetting.Default, calendar);
                if (await Api.Ranks.ExistAsync(State.LeagueKey))
                {
                    await Api.Ranks.UpdateAsync(State.LeagueKey, rank);
                }
                else
                {
                    await Api.Ranks.InsertAsync(State.LeagueKey, rank);
                }
            }
            LoadingIndicator?.Hide();
        }
    }
    private void ChangeBaskets(IEnumerable<Basket> baskets)
    {
        if (State?.HasALeague == true && baskets != null)
        {
            State.SelectedLeague.BasketsId = baskets.Select(x => x.Id).ToList();
        }
    }
    private void ChangeAnnualLeagueType(LeagueType leagueType)
    {
        if (State?.HasALeague == true)
        {
            State.SelectedYearlyLeague.Type = leagueType;
        }
    }
    private void ChangeLeagueType(LeagueType leagueType)
    {
        if (State?.HasALeague == true)
        {
            State.SelectedLeague.Type = leagueType;
        }
    }
    private async Task RandomizePlayerForAuctionsAsync()
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var allPlayersWrapper = await Api.RealPlayers.GetAsync(State.Year);
            if (allPlayersWrapper?.Players != null)
            {
                var randomizedPlayers = allPlayersWrapper.Players
                    .OrderBy(x => x.Role)
                    .ThenBy(x => RandomNumberGenerator.GetInt32(0, int.MaxValue))
                    .ToList();
                foreach (var player in randomizedPlayers)
                {
                    player.Visible = false;
                }
                if (await Api.RandomizedRealPlayers.ExistAsync(State.LeagueKey))
                    await Api.RandomizedRealPlayers.UpdateAsync(
                        State.LeagueKey,
                        new RealPlayersWrapper
                            {
                                Players = randomizedPlayers
                            });
                else
                    await Api.RandomizedRealPlayers.InsertAsync(
                    State.LeagueKey,
                    new RealPlayersWrapper
                        {
                            Players = randomizedPlayers
                        });
            }
            LoadingIndicator?.Hide();
        }
    }
    private async Task RecalculateAsync(bool onlyLastDay = false, bool preciseDay = false)
    {
        if (State != null)
        {
            LoadingIndicator?.Show();
            var calendar = await Api.Calendar.GetAsync(State.LeagueKey);
            var realCalendar = await Api.RealCalendar.GetAsync(State.Year);
            var lastDay = realCalendar.LastDay;
            var yearlyLeague = State?.SelectedYearlyLeague;
            var leagueType = State!.SelectedLeague!.GetAnnualType(State.Year);
            var settings = yearlyLeague?.Settings;
            if (settings != null)
            {
                foreach (var round in calendar.Rounds)
                {
                    foreach (var day in round.Value)
                    {
                        if (day.Number <= settings.CancelledDay)
                        {
                            foreach (var game in day.Games)
                            {
                                if (game.Result != null)
                                    game.Result.IsCancelled = true;
                                else
                                    game.Result = new GameResult { IsCancelled = true };
                            }
                        }
                        else if (!onlyLastDay || (!preciseDay && day.SerieADay == lastDay.SerieADay) || (preciseDay && day.SerieADay == dayToRecalculate))
                        {
                            await TeamCalculator.BuildRequestAsync(yearlyLeague.Year, day.SerieADay, State!.SelectedLeague!.GetAnnualType(State.Year), yearlyLeague.Settings, false, true, false);
                            if (TeamCalculator.Official == null || TeamCalculator.IsLive)
                                break;
                            foreach (var game in day.Games)
                            {
                                var homeTeamKey = State.TeamDayKey(day.SerieADay, game.HomeOwner);
                                var homeTeam = await GetTeamAsync(game.HomeOwner, await Api.DailyTeam.GetAsync(homeTeamKey), homeTeamKey);
                                var awayTeamKey = State.TeamDayKey(day.SerieADay, game.AwayOwner);
                                var awayTeam = await GetTeamAsync(game.AwayOwner, await Api.DailyTeam.GetAsync(awayTeamKey), awayTeamKey);
                                var homePoint = TeamCalculator.CalculatePoint(homeTeam.ActivePlayers);
                                var awayPoint = TeamCalculator.CalculatePoint(awayTeam.ActivePlayers);
                                var result = new GameResult
                                    {
                                        Home = homePoint,
                                        Away = awayPoint,
                                    };
                                result.CalculateGoals(yearlyLeague.Settings);
                                game.Result = result;

                                async Task<Team?> GetTeamAsync(string owner, Team? team, TeamDayKey teamDayKey)
                                {
                                    if (team != null)
                                        return team;
                                    team = await Api.Team.GetAsync(State.OtherTeamKey(owner));
                                    foreach (var player in team.ActivePlayers)
                                    {
                                        player.Position = FantaSoccerRole.Tribune;
                                    }
                                    await Api.DailyTeam.UpdateAsync(teamDayKey, team);
                                    return team;
                                }
                            }
                        }
                    }
                }
                var leagueCalculator = LeagueCalculatorFactory.Create(leagueType.ToString())!;
                await Api.Calendar.UpdateAsync(State.LeagueKey, calendar);
                var rank = leagueCalculator.GetRank(yearlyLeague.Settings, calendar);
                await Api.Ranks.UpdateAsync(State.LeagueKey, rank);
                LoadingIndicator?.Hide();
            }
        }
    }
}

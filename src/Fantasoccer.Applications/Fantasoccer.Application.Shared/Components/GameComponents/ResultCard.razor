@if (Game != null)
{
    <div class="@Css">
        <img class="teamImage" onerror="@ImageUriHelper.GetPlaceholderTeamImageUri()" src="@ImageUriHelper.GetTeamImageUri(State.GroupId, State.Year, Game.HomeOwner)" />
        <span id="team-name-home" class="team">@Game.Home</span>
        @if (Game.Result != default && !Game.Result.IsCancelled)
        {
            @if (Game.Result.Home.DefensiveBonus)
            {
                <img title="Bonus difesa (+3)" class="defensivebonus" src="@StaticSettings.GetStaticContentUri("static/wallred.png")" />
            }
            @if (Game.Result.Home.OwnGoal && !Game.Result.Away.OwnGoal)
            {
                <img title="Autogol (punteggio inferiore a 60, un gol all'avversario)" class="defensivebonus" src="@StaticSettings.GetStaticContentUri("static/goal_red_v2.png")" />
            }
            <span class="points">@Game.Result.Home.Value</span>

            <span class="goals">@Game.Result.HomeGoal - @Game.Result.AwayGoal</span>

            <span class="points">@Game.Result.Away.Value</span>
            @if (Game.Result.Away.DefensiveBonus)
            {
                <img title="Bonus difesa (+3)" class="defensivebonus" src="@StaticSettings.GetStaticContentUri("static/wallred.png")" />
            }
            @if (Game.Result.Away.OwnGoal && !Game.Result.Home.OwnGoal)
            {
                <img title="Autogol (punteggio inferiore a 60, un gol all'avversario)" class="defensivebonus" src="@StaticSettings.GetStaticContentUri("static/goal_red_v2.png")" />
            }
        }
        else
        {
            <span class="goals"> - </span>
        }
        <span id="team-name-away" class="team">@Game.Away</span>
        <img class="teamImage" onerror="@ImageUriHelper.GetPlaceholderTeamImageUri()" src="@ImageUriHelper.GetTeamImageUri(State.GroupId, State.Year, Game.AwayOwner)" />
    </div>
}
@code {
    [Parameter]
    public CalendarGame? Game { get; set; }
    [Parameter]
    public string Css { get; set; }
    [CascadingParameter]
    public FantasoccerState? State { get; set; }
    [Parameter]
    public DateTime LastUpdateHome { get; set; }
    [Parameter]
    public DateTime LastUpdateAway { get; set; }
}

<div class="player @Player.Current.Role" onclick="@(() => Click?.Invoke())">
    <div class="playerimage-container">
        <img class="playerimage" onerror="@ImageUriHelper.GetPlaceholderPlayerImageUri()" src="@ImageUriHelper.GetPlayerImageUri(Player.Current)" />
    </div>
    @if (Player.RealGame?.IsPlayed == true)
    {
        <div class="playerrealteam">@Player.Current.RealTeam.Name</div>
        <div class="playerenemy">
            <div class="enemyname">@EnemyName</div>
            <div class="enemyhour">@Player.RealGame?.HomeGoal - @Player.RealGame?.AwayGoal</div>
        </div>
    }
    else
    {
        var id = $"key_{Player.Current.Key}";
        <FluentTooltip Anchor="@id">
            @Player?.Chance?.Description
        </FluentTooltip>
        <div id="@id" class="playerrealteam @Player?.Chance?.Status">@Player.Current.RealTeam.Name</div>
        <div class="playerenemy">
            <div class="enemyname">@EnemyName</div>
            @if (Player.RealGame != default && Player.RealGame.Date.HasValue)
            {
                <div class="enemyhour">@Player.RealGame.Date.Value.ToString("MM/dd HH:mm")</div>
            }
        </div>
        @if (Player.Chance != default)
        {
            <div class="playerchance">
                <div title="Fantagazetta" id="fantagazzetta" class="playerstatus status@(Player.Chance.Fantagazzetta)">F</div>
                <div title="Gazzetta" class="playerstatus status@(Player.Chance.Gazzetta)">G</div>
                <div title="Mediaset" class="playerstatus status@(Player.Chance.Mediaset)">M</div>
                <div title="Sky" class="playerstatus status@(Player.Chance.Sky)">S</div>
            </div>
        }
    }

    <div title="@Player.Current.Name" class="playername @Player.Current.Position">@Player.Current.Name</div>
    @if (Player.Vote != null)
    {
        if (Player.FinalValue != default && !Player.FinalValue.IsEmpty)
        {
            <div class="playervote @(Player.Vote.HasVote ? "": "transparent")">
                <div class="finalvote finalvote@(Player.Vote.IsFinal)">@Player.FinalValue.Value</div>
            </div>

            <div class="playerchance">
                @if (Player.FinalValue.Special)
                {
                    <img class="playervoteevent" alt="special" src="@StaticSettings.GetStaticContentUri("static/special.png")" />
                }
                @for (int i = 0; i < Player.Vote.Goal; i++)
                {
                    <img class="playervoteevent" alt="goal" src="@StaticSettings.GetStaticContentUri("static/goal.png")" />
                }
                @for (int i = 0; i < Player.Vote.Penalty; i++)
                {
                    <img class="playervoteevent" alt="goal su rigore" src="@StaticSettings.GetStaticContentUri("static/goal_blue_v2.png")" />
                }
                @for (int i = 0; i < Player.Vote.Assist; i++)
                {
                    <img class="playervoteevent" alt="assist" src="@StaticSettings.GetStaticContentUri("static/assist_total.png")" />
                }
                @for (int i = 0; i < Player.Vote.StoppedPenalty; i++)
                {
                    <img class="playervoteevent" alt="rigore parato" src="@StaticSettings.GetStaticContentUri("static/goal_green_all.png")" />
                }
                @for (int i = 0; i < Player.Vote.WrongedPenalty; i++)
                {
                    <img class="playervoteevent" alt="rigore sbagliato" src="@StaticSettings.GetStaticContentUri("static/goal_silver_all.png")" />
                }
                @for (int i = 0; i < Player.Vote.SufferedGoal; i++)
                {
                    <img class="playervoteevent" alt="goal subito" src="@StaticSettings.GetStaticContentUri("static/goal_red_all.png")" />
                }
                @for (int i = 0; i < Player.Vote.OwnGoal; i++)
                {
                    <img class="playervoteevent" alt="autogoal" src="@StaticSettings.GetStaticContentUri("static/goal_red_v2.png")" />
                }
                <div class="playervoteevent behavior@(Player.Vote.Status)"></div>
                @if (Player.Vote.Injured)
                {
                    <img class="playervoteevent" alt="infortunato" src="@StaticSettings.GetStaticContentUri("static/injury.png")" />
                }
                @if (Player.Vote.ManOfTheMatch)
                {
                    <img class="playervoteevent" alt="giocatore della partita" src="@StaticSettings.GetStaticContentUri("static/manofthematch.png")" />
                }
                @if (!Player.Vote.IsFinal && Player.Vote.IsIn)
                {
                    <img class="playervoteevent" alt="entrato in campo" src="@StaticSettings.GetStaticContentUri("static/in.png")" />
                }
                @if (!Player.Vote.IsFinal && Player.Vote.IsOut)
                {
                    <img class="playervoteevent" alt="uscito dal campo" src="@StaticSettings.GetStaticContentUri("static/out.png")" />
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public required EnrichedPlayer Player { get; set; }
    [Parameter]
    public Action? Click { get; set; }
    private string EnemyName => Player == null || Player.RealGame == null ? string.Empty : (Player.Current.RealTeam.Abbreviation != Player.RealGame.Home.Abbreviation ? Player.RealGame.Home.Abbreviation.ToUpper() : Player.RealGame.Away.Abbreviation);
}

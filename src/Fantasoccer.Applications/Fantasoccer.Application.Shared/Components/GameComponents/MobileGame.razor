@if (Players != null)
{
    <div class="@Css">
        @foreach (var position in !Inverted ? FantaSoccerPosition.Default : FantaSoccerPosition.Inverted)
        {
            if (position.Position >= From && position.Position <= To)
            {
                <div class="playerMobile">
                    @foreach (var player in Players.Where(x => x.CurrentPosition == position.Position))
                    {
                        <PlayerCard Player="player"></PlayerCard>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public IEnumerable<EnrichedPlayer>? Players { get; set; }
    [Parameter]
    public required bool Inverted { get; set; }
    [Parameter]
    public FantaSoccerRole From { get; set; }
    [Parameter]
    public FantaSoccerRole To { get; set; }
    [Parameter]
    public string Css { get; set; }
}

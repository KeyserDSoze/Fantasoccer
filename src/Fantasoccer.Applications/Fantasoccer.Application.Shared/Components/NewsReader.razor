@using Fantasoccer.Domain
@foreach (var newsWrapper in newsWrappers)
{
    @foreach (var news in newsWrapper.News)
    {
        <h3>@news.League (@news.Date.ToString("yyyy-MM-dd"))</h3>
        <h1>@news.Title.Trim('"').Replace("Titolo: \"", string.Empty)</h1>
        <p>@((MarkupString)news.Content.Replace("```html", string.Empty).Replace("```", string.Empty))</p>
        <FluentDivider Style="width: 100%;" Role="DividerRole.Presentation"></FluentDivider>
    }
}
@if (youHaveMore)
{
    <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>AddAsync(false))">
        More..
    </FluentButton>
}


@code {
    [CascadingParameter]
    private FantasoccerState? State { get; set; }
    [CascadingParameter]
    private LoadingIndicator? LoadingIndicator { get; set; }
    private List<NewsWrapper> newsWrappers = new();
    private string? selectedTab;
    private string? nullRank;
    private bool isVisible => nullRank != null;
    private int? day;

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
            LoadingIndicator?.Hide();
    }
    protected override async Task OnParametersSetAsync()
    {
        nullRank = null;
        if (State?.HasAGroup == true)
        {
            LoadingIndicator?.Show();
            await AddAsync(true);
            LoadingIndicator?.Hide();
        }
        await base.OnParametersSetAsync();
    }
    private bool youHaveMore = true;
    private async Task AddAsync(bool onStart = false)
    {
        if (day == null)
        {
            var realCalendar = await Api.RealCalendar.GetAsync(State.Year).NoContext();
            day = realCalendar.LastDay!.SerieADay;
        }
        else
        {
            day--;
        }
        var theDay = day.Value;
        var x = await Api.News.GetAsync(new YearDayGroup
            {
                Year = State.Year,
                Group = State.GroupId,
                Day = theDay
            });
        if (x != null)
        {
            newsWrappers.Add(x);
            if (theDay > 1)
            {
                youHaveMore = await Api.News.ExistAsync(new YearDayGroup
                    {
                        Day = theDay - 1,
                        Group = State.GroupId,
                        Year = State.Year
                    });
            }
            else
                youHaveMore = false;
        }
        else if (onStart && theDay > 1)
        {
            await AddAsync(onStart);
        }
        else
        {
            youHaveMore = false;
        }
    }
}
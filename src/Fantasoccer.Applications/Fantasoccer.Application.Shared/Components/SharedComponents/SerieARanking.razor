@if (Teams != null)
{
    <div class="fluent-table-container fluent-mid-table-container">
        <FluentDataGrid Items="Teams.AsQueryable()" TGridItem="RealRankedTeam" AutoFit="true">
            <PropertyColumn Property="@(x => x.Name)" Title="Squadra" />
            <PropertyColumn Property="@(x => x.Point)" Title="P" />
            <PropertyColumn Property="@(x => x.Goal)" Title="G" />
            <PropertyColumn Property="@(x => x.SufferedGoal)" Title="SG" />
            <PropertyColumn Property="@(x => x.Victories)" Title="V" />
            <PropertyColumn Property="@(x => x.Draws)" Title="D" />
            <PropertyColumn Property="@(x => x.Defeats)" Title="De" />
        </FluentDataGrid>
    </div>
}
@code {
    [Parameter]
    public List<RealRankedTeam>? Teams { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
}

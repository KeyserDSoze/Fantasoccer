@if (Days != null)
{
    <FluentGrid Spacing="0" AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
        @foreach (var day in Days)
        {
            <FluentGridItem xl="6" md="12" xxl="6" xs="12" sm="12" lg="6">
                <FluentCard>
                    <h3>@(day.SerieADay)&ordf; giornata</h3>
                    <FluentDataGrid TGridItem="RealGame" Items="day.Games.AsQueryable()">
                        <PropertyColumn Property="@(p => p.Home.Name)" Sortable="true" Title="Casa" />
                        <PropertyColumn Property="@(p => p.CalculateResultAsString())" Sortable="true" Title="Risultato" />
                        <PropertyColumn Property="@(p => p.Away.Name)" Sortable="true" Title="Trasferta" />
                    </FluentDataGrid>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
}
@code {
    [Parameter]
    public List<RealDay>? Days { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
}

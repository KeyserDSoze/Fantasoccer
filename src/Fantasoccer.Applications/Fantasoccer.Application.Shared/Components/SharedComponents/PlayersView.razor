@using Fantasoccer.Domain

@if (StatPlayers != null)
{
    <div class="fluent-table-container fluent-great-table-container">
        <FluentDataGrid ShowHover="true" Items="@StatPlayers.AsQueryable()" GridTemplateColumns="3fr 2fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr">
            <PropertyColumn Property="@(p => p.Name)" Sortable="true" Title="Nome" />
            @if (withPrice)
            {
                <PropertyColumn Property="@(p => ((StatPlayerWithPrice)p).Price)" Title="Prezzo" Sortable="true" />
            }
            <PropertyColumn Property="@(p => p.RealTeam.Name)" Title="Squadra" Sortable="true" />
            <TemplateColumn Title="Media" Sortable="true" SortBy="GridSort<StatPlayer>.ByAscending(x => x.Average)">
                @context.Average.ToString("N2")
            </TemplateColumn>
            <TemplateColumn Title="FantaMedia" Sortable="true" SortBy="GridSort<StatPlayer>.ByAscending(x => x.FantaAverage)">
                @context.FantaAverage.ToString("N2")
            </TemplateColumn>
            <PropertyColumn Property="@(p => p.IsEnough)" Title="> 6" Sortable="true" />
            <PropertyColumn Property="@(p => p.ManOfTheMatch)" Title="MotM" Sortable="true" />
            <PropertyColumn Property="@(p => p.WithVote)" Title="Con voto" Sortable="true" />
            <PropertyColumn Property="@(p => p.WithoutVote)" Title="Senza voto" Sortable="true" />
            <PropertyColumn Property="@(p => p.YellowCard)" Title="Gialli" Sortable="true" />
            <PropertyColumn Property="@(p => p.RedCard)" Title="Rossi" Sortable="true" />
            <PropertyColumn Property="@(p => p.Goal)" Title="Reti" Sortable="true" />
            <PropertyColumn Property="@(p => p.Penalty)" Title="Rigori" Sortable="true" />
            <PropertyColumn Property="@(p => p.Assist)" Title="Assist" Sortable="true" />
            <PropertyColumn Property="@(p => p.WrongedPenalty)" Title="Rigori sbagliati" Sortable="true" />
            <PropertyColumn Property="@(p => p.OwnGoal)" Title="Autogoal" Sortable="true" />
            <PropertyColumn Property="@(p => p.SufferedGoal)" Title="Goal subiti" Sortable="true" />
            <PropertyColumn Property="@(p => p.StoppedPenalty)" Title="Rigori parati" Sortable="true" />
            <PropertyColumn Property="@(p => p.IsActive)" Title="Attivo" Sortable="true" />
        </FluentDataGrid>
    </div>
}
@if (Players != null)
{
    <FluentDataGrid ResizableColumns="true" ShowHover="true" Items="@Players.AsQueryable()" GridTemplateColumns="3fr 1fr 1fr">
        <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
        <PropertyColumn Property="@(p => p.RealTeam.Name)" Title="Team" Sortable="true" />
        <PropertyColumn Property="@(p => p.Price)" Sortable="true" />
    </FluentDataGrid>
}

@code {
    [Parameter]
    public IEnumerable<StatPlayer>? StatPlayers { get; set; }
    [Parameter]
    public IEnumerable<Player>? Players { get; set; }
    [Parameter]
    public string? Key { get; set; }
    private bool withPrice;
    protected override void OnParametersSet()
    {
        withPrice = StatPlayers?.Any(x => x is StatPlayerWithPrice) ?? false;
        base.OnParametersSet();
    }
}

@if (LoadingIndicator != null)
{
    <FluentOverlay @bind-Visible=@LoadingIndicator.IsVisible
                   Opacity="0.4"
                   Alignment="Align.Center"
                   Justification="JustifyContent.Center"
                   Dismissable="false">
        <FluentProgressRing />
    </FluentOverlay>
}

@code {
    [CascadingParameter]
    public LoadingIndicator LoadingIndicator { get; set; }
    protected override void OnInitialized()
    {
        if (LoadingIndicator != null)
            LoadingIndicator.ShowOrHide = () => _ = InvokeAsync(StateHasChanged);
        base.OnInitialized();
    }
}

@using Blazored.LocalStorage;
@using Blazorise;
@using Fantasoccer.Applications.Wasm.Extensions;
@using Fantasoccer.Applications.Wasm.Shared;

<Blazorise.ThemeProvider Theme="@theme">
    <CascadingValue Value="@state">
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
</Blazorise.ThemeProvider>

@code {
    [CascadingParameter]
    public required Task<AuthenticationState> AuthenticationState { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }
    private FantasoccerState? state;
    private Theme theme = new Theme
        {
            ColorOptions = new ThemeColorOptions
            {
                Primary = "#8b2c62",
                Secondary = "#db3258",
                Light = "#e8fcdc",
                Dark = "#2d2c39",
                Info = "#01854d",
                Success = "#019e6b",
                Warning = "#d3ce01",
                Danger = "#df3d00",
                Link = "#ffffff"
            }
        };
    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();
        state = new FantasoccerState()
            {
                AppUiUpdate = () =>
                {
                    StateHasChanged();
                },
                GetGroup = (groupId) =>
                {
                    try
                    {
                        return Api.Groups.GetAsync(groupId);
                    }
                    catch (Exception ex)
                    {
                        return Task.FromResult(default(Group));
                    }
                },
                UpdateState = (identity) =>
                {
                    try
                    {
                        return Api.AppIdentity.UpdateAsync(identity!.Email, identity);
                    }
                    catch (Exception ex)
                    {
                        return Task.CompletedTask;
                    }
                }
            };
        var user = (await AuthenticationState).User;
        if (!(user?.Identity?.IsAuthenticated == true))
        {
            NavigationManager.NavigateTo($"../../../../authentication/login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", false);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var user = (await AuthenticationState).User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            var email = user.Claims.First(x => x.Type == "emails").Value.Trim(']').Trim('[').Trim('"');
            if (email != null)
            {
                try
                {
                    var identity = await Api.AppIdentity.GetAsync(email);
                    var isBrandNew = identity == null;
                    if (isBrandNew)
                    {
                        identity = new AppIdentity
                            {
                                Email = email,
                                Groups = new(),
                                Username = email
                            };
                        await Api.AppIdentity.InsertAsync(email, identity);
                    }
                    if (state != null)
                        await state.SetIdentityAsync(identity);
                    if (isBrandNew)
                        NavigationManager?.NavigateTo("../../settings", false);
                }
                catch (UnauthorizedAccessException)
                {
                }
            }
        }
    }
}

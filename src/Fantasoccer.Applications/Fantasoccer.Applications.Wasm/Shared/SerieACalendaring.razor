@if (Days != null)
{
    @foreach (var day in Days)
    {
        <Column ColumnSize="WithFluentSize ? ColumnSize.Is6.OnDesktop.Is12.OnMobile.Is12.OnTablet : ColumnSize.Is12">
            <Card Margin="Margin.Is1">
                <CardBody>
                    <CardTitle Size="3">
                        Day @day.SerieADay
                    </CardTitle>
                    <CardText>
                        <Table Striped>
                         <TableHeader>
                             <TableRow>
                                 <TableHeaderCell>Home Team</TableHeaderCell>
                                 <TableHeaderCell>Points</TableHeaderCell>
                                 <TableHeaderCell>Away Team</TableHeaderCell>
                             </TableRow>
                         </TableHeader>
                         <TableBody>
                             @foreach (var game in day.Games)
                                {
                                    <TableRow>
                                        <TableRowCell>@game.Home.Name</TableRowCell>
                                        @if (game.IsPlayed)
                                        {
                                            <TableRowCell>
                                                @game.HomeGoal - @game.AwayGoal
                                            </TableRowCell>
                                        }
                                        else
                                        {
                                            <TableRowCell>
                                                @game.Date?.ToString("yyyy-MM-dd HH:mm")
                                            </TableRowCell>
                                        }
                                        <TableRowCell>@game.Away.Name</TableRowCell>
                                    </TableRow>
                                }
                            </TableBody>
                        </Table>
                    </CardText>
                </CardBody>
            </Card>
        </Column>
    }
}
@code {
    [Parameter]
    public List<RealDay>? Days { get; set; }
    [Parameter]
    public bool WithFluentSize { get; set; }
    [Inject]
    public NavigationManager NavigationManager { get; set; }
    private void NavigateTo(string gameId)
    {
        NavigationManager.NavigateTo($"game/{gameId}", false);
    }
}
